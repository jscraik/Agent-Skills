{
  "description": "Ars Contexta plugin hooks — session orientation, note validation, auto-commit",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/Infrastructure/scripts/session-orient.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/Infrastructure/scripts/auto-commit.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
