{
  "schema_version": 1,
  "plugin": "synaipse-harness",
  "router": "sy-router",
  "stage_handles": {
    "sy-brainstorm": "$synaipse-harness:sy-brainstorm <request>",
    "sy-spec": "$synaipse-harness:sy-spec <request>",
    "sy-execution-plan": "$synaipse-harness:sy-execution-plan <request>",
    "sy-work": "$synaipse-harness:sy-work <plan-or-task>",
    "sy-fix-bugs": "$synaipse-harness:sy-fix-bugs <bug-or-qa-report>",
    "sy-improve": "$synaipse-harness:sy-improve <measurement-goal>",
    "sy-review": "$synaipse-harness:sy-review <review-target>",
    "sy-heartbeat": "$synaipse-harness:sy-heartbeat <target-and-cadence>",
    "sy-reconcile": "$synaipse-harness:sy-reconcile <state-or-resume-request>",
    "sy-reinforce": "$synaipse-harness:sy-reinforce <solved-problem-or-learning-refresh>",
    "sy-eval-report": "$synaipse-harness:sy-eval-report <completed-slice-or-pr>",
    "sy-strategy": "$synaipse-harness:sy-strategy <strategy-or-review-request>",
    "sy-reframe": "$synaipse-harness:sy-reframe <migration-candidate>",
    "sy-trace-plan": "$synaipse-harness:sy-trace-plan <strategy-reframe-or-brainstorm-output>",
    "sy-tracker-plan": "$synaipse-harness:sy-tracker-plan <harness-artifacts>",
    "sy-phase-work": "$synaipse-harness:sy-phase-work <approved-phase-plan-and-cadence>"
  },
  "selection_rule": "Select exactly one next stage; when authority or freshness is unclear, choose sy-reconcile or return a blocked handoff.",
  "evidence_rule": "Report local validation, PR/CI, review, tracker, artifact, and rollout evidence as separate lanes."
}
