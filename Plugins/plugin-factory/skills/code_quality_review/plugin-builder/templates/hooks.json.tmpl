{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "{{SESSION_START_MATCHER}}",
        "hooks": [
          {
            "type": "command",
            "command": "{{SESSION_START_COMMAND}}",
            "timeout": {{SESSION_START_TIMEOUT_SECONDS}},
            "statusMessage": "{{SESSION_START_STATUS_MESSAGE}}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "{{STOP_MATCHER}}",
        "hooks": [
          {
            "type": "command",
            "command": "{{STOP_COMMAND}}",
            "timeout": {{STOP_TIMEOUT_SECONDS}},
            "statusMessage": "{{STOP_STATUS_MESSAGE}}"
          }
        ]
      }
    ]
  }
}
