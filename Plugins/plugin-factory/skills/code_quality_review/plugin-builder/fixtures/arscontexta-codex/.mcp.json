{
  "schema_version": 1,
  "mcpServers": {
    "arscontexta-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./vaults/arscontexta"
      ],
      "env": {
        "ARSCONTEXTA_VAULT_ROOT": "./vaults/arscontexta"
      },
      "notes": "Filesystem MCP access scoped to the Ars Contexta vault root."
    }
  }
}
