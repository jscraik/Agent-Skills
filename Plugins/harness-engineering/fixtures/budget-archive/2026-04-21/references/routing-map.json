{
  "schema_version": 1,
  "plugin": "harness-engineering",
  "naming_note": "he-compound, he-compound-refresh, and he-review are Harness Engineering compatibility aliases retained for routing continuity.",
  "entrypoint": "he-router",
  "deterministic_decision_order": [
    {
      "priority": 10,
      "rule": "direct-stage-invocation",
      "route": "named he-* stage",
      "unless": "the user asks whether the named stage is correct"
    },
    {
      "priority": 15,
      "rule": "stage-correctness-question",
      "route": "he-router",
      "signals": [
        "right stage",
        "correct stage",
        "best stage",
        "which stage",
        "what stage",
        "should we use"
      ]
    },
    {
      "priority": 16,
      "rule": "named-stage-ambiguity",
      "route": "he-router",
      "signals": [
        "multiple named he-* stages",
        "he-* or he-*"
      ]
    },
    {
      "priority": 18,
      "rule": "recurring-control-loop",
      "route": "he-heartbeat",
      "signals": [
        "heartbeat",
        "keep checking",
        "monitor until",
        "wake this thread",
        "every 10m",
        "until green",
        "until merged",
        "recurring follow-up"
      ]
    },
    {
      "priority": 20,
      "rule": "workflow-hygiene",
      "route": "he-prune-branches",
      "signals": [
        "stale branch cleanup",
        "gone remote branches",
        "worktree cleanup"
      ]
    },
    {
      "priority": 30,
      "rule": "review-before-more-work",
      "route": "he-code-review",
      "signals": [
        "implemented branch",
        "PR before merge",
        "go/no-go",
        "readiness",
        "pre-merge"
      ]
    },
    {
      "priority": 35,
      "rule": "deep-review-or-feedback-dispute",
      "route": "he-technical-review",
      "signals": [
        "deep technical review",
        "engineering risk",
        "review feedback may be wrong",
        "validate comments"
      ]
    },
    {
      "priority": 36,
      "rule": "reliability-risk-review",
      "route": "he-reliability-review",
      "signals": [
        "SLO",
        "failure modes",
        "cascading failure",
        "timeout dependency risk",
        "resilience"
      ]
    },
    {
      "priority": 40,
      "rule": "test-first-work",
      "route": "he-tdd",
      "signals": [
        "TDD",
        "RED/GREEN",
        "failing test first",
        "regression first"
      ]
    },
    {
      "priority": 45,
      "rule": "diagnose-before-fix",
      "route": "he-fix-bugs",
      "signals": [
        "failing tests",
        "debug",
        "root cause",
        "reproduce",
        "trace error",
        "regression"
      ]
    },
    {
      "priority": 50,
      "rule": "browser-refinement",
      "route": "he-refine",
      "signals": [
        "browser-first",
        "polish",
        "accessibility iteration",
        "dev server loop",
        "visual refinement"
      ]
    },
    {
      "priority": 55,
      "rule": "measured-optimization",
      "route": "he-improve",
      "signals": [
        "benchmark",
        "measured experiments",
        "parameter search",
        "optimize",
        "tune"
      ]
    },
    {
      "priority": 60,
      "rule": "deepen-existing-artifact",
      "route": "he-deepen-spec or he-deepen-plan",
      "signals": [
        "harden existing spec",
        "deepen existing spec",
        "harden existing plan",
        "deepen existing plan"
      ]
    },
    {
      "priority": 70,
      "rule": "forward-lifecycle",
      "route": "he-ideate -> he-brainstorm -> he-spec -> he-plan -> he-work",
      "signals": [
        "fuzzy opportunity",
        "ambiguous requirements",
        "write spec",
        "plan implementation",
        "execute approved plan"
      ]
    },
    {
      "priority": 80,
      "rule": "qa-intake-by-clarity",
      "route": "he-brainstorm, he-spec, he-fix-bugs, or he-plan",
      "signals": [
        "QA",
        "QA session",
        "report bugs",
        "turn feedback into Linear issues",
        "multiple related QA issues",
        "expected behavior unclear",
        "unclear expected behavior",
        "feedback unclear",
        "confusing workflow"
      ]
    },
    {
      "priority": 90,
      "rule": "ask-once-when-blocked",
      "route": "he-router blocked",
      "signals": [
        "no artifact state",
        "conflicting lifecycle state",
        "missing expected behavior"
      ]
    }
  ],
  "stage_invocation_templates": {
    "he-ideate": "$harness-engineering:he-ideate <request>",
    "he-brainstorm": "$harness-engineering:he-brainstorm <request>",
    "he-spec": "$harness-engineering:he-spec <request>",
    "he-deepen-spec": "$harness-engineering:he-deepen-spec <artifact>",
    "he-plan": "$harness-engineering:he-plan <request>",
    "he-deepen-plan": "$harness-engineering:he-deepen-plan <artifact>",
    "he-work": "$harness-engineering:he-work <plan-or-task>",
    "he-tdd": "$harness-engineering:he-tdd <behavior-target>",
    "he-fix-bugs": "$harness-engineering:he-fix-bugs <bug-or-qa-report>",
    "he-improve": "$harness-engineering:he-improve <measurement-goal>",
    "he-refine": "$harness-engineering:he-refine <browser-target>",
    "he-code-review": "$harness-engineering:he-code-review <review-target>",
    "he-technical-review": "$harness-engineering:he-technical-review <review-target>",
    "he-reliability-review": "$harness-engineering:he-reliability-review <review-target>",
    "he-prune-branches": "$harness-engineering:he-prune-branches <repo-path>",
    "he-heartbeat": "$harness-engineering:he-heartbeat <target-and-cadence>",
    "he-compound": "$harness-engineering:he-compound <request>",
    "he-compound-refresh": "$harness-engineering:he-compound-refresh <evidence-path>"
  },
  "routes": [
    {
      "intent": "recurring-harness-engineering-heartbeat",
      "match": [
        "he-heartbeat",
        "heartbeat",
        "keep checking",
        "monitor until green",
        "wake this thread",
        "run this every",
        "poll until merged",
        "recurring follow-up"
      ],
      "skill": "he-heartbeat",
      "required_inputs": [
        "target such as repo, PR, branch, Linear issue, validation command, or artifact",
        "cadence or permission to default to 10m",
        "stop conditions and reporting policy"
      ],
      "output": "durable heartbeat prompt + selected HE stage + live checks + stop conditions"
    },
    {
      "intent": "stage-routing-or-resume",
      "match": [
        "where do we start",
        "resume workflow",
        "what stage next",
        "unknown stage"
      ],
      "skill": "he-compound",
      "required_inputs": [
        "problem or artifact path",
        "constraints",
        "execution preference"
      ],
      "output": "stage decision + exact next skill invocation"
    },
    {
      "intent": "ideation-and-option-generation",
      "match": [
        "he-ideate",
        "idea generation",
        "explore options"
      ],
      "skill": "he-ideate",
      "required_inputs": [
        "problem statement",
        "constraints",
        "success signals"
      ],
      "output": "ranked implementation opportunities and recommendation"
    },
    {
      "intent": "brainstorm-and-requirements-shaping",
      "match": [
        "he-brainstorm",
        "shape requirements",
        "compare directions"
      ],
      "skill": "he-brainstorm",
      "required_inputs": [
        "problem statement",
        "constraints",
        "success signals"
      ],
      "output": "requirements-oriented options with recommendation"
    },
    {
      "intent": "specification",
      "match": [
        "write a spec",
        "define contract",
        "requirements artifact"
      ],
      "skill": "he-spec",
      "required_inputs": [
        "approved direction",
        "scope boundaries",
        "acceptance criteria"
      ],
      "output": "implementation-grade specification"
    },
    {
      "intent": "planning",
      "match": [
        "he-plan",
        "create implementation plan",
        "execution plan",
        "sequence the work"
      ],
      "skill": "he-plan",
      "required_inputs": [
        "governing spec or equivalent",
        "constraints and risks",
        "verification expectations"
      ],
      "output": "execution-ready plan with validation sequence"
    },
    {
      "intent": "deepen-spec-artifact",
      "match": [
        "he-deepen-spec",
        "harden spec",
        "deepen specification"
      ],
      "skill": "he-deepen-spec",
      "required_inputs": [
        "existing spec path",
        "known risk areas",
        "acceptance and failure expectations"
      ],
      "output": "spec with stronger boundaries, failure handling, and validation detail"
    },
    {
      "intent": "deepen-plan-artifact",
      "match": [
        "he-deepen-plan",
        "harden plan",
        "deepen implementation plan"
      ],
      "skill": "he-deepen-plan",
      "required_inputs": [
        "existing plan path",
        "sequencing or risk concerns",
        "verification expectations"
      ],
      "output": "plan with stronger sequencing, risk treatment, and validation gates"
    },
    {
      "intent": "iterative-optimization",
      "match": [
        "he-improve",
        "optimize",
        "tune",
        "parameter search",
        "run experiments"
      ],
      "skill": "he-improve",
      "required_inputs": [
        "optimization goal or spec path",
        "measurement command",
        "mutable/immutable scope and gates"
      ],
      "output": "baseline + experiment loop + best-result recommendation"
    },
    {
      "intent": "browser-first-refinement",
      "match": [
        "he-refine",
        "polish",
        "refine",
        "start dev server",
        "iterate in browser"
      ],
      "skill": "he-refine",
      "required_inputs": [
        "branch or PR context",
        "dev-server startup constraints",
        "refinement goals and stop condition"
      ],
      "output": "running dev server + iterative refinement loop + next-stage recommendation"
    },
    {
      "intent": "execution",
      "match": [
        "he-work",
        "implement",
        "execute plan",
        "ship this"
      ],
      "skill": "he-work",
      "required_inputs": [
        "plan/todo/spec target",
        "repo conventions",
        "verification gates"
      ],
      "output": "implemented changes + validation + handoff package"
    },
    {
      "intent": "test-driven-execution",
      "match": [
        "he-tdd",
        "test-first",
        "tdd",
        "start with failing test",
        "red green"
      ],
      "skill": "he-tdd",
      "required_inputs": [
        "implementation scope",
        "test harness constraints",
        "verification gates"
      ],
      "output": "test-first execution slices with RED/GREEN evidence"
    },
    {
      "intent": "debugging-and-bug-fixing",
      "match": [
        "he-fix-bugs",
        "debug this",
        "fix this bug",
        "why is this failing",
        "trace this error",
        "reproduce this issue"
      ],
      "skill": "he-fix-bugs",
      "required_inputs": [
        "issue reference or direct symptom",
        "expected behavior",
        "environment/reproduction constraints"
      ],
      "output": "reproduction status + root-cause summary + fix recommendation or implementation evidence"
    },
    {
      "intent": "qa-intake-and-linear-filing",
      "match": [
        "qa session",
        "do qa",
        "report bugs",
        "file these bugs",
        "turn feedback into Linear issues",
        "walk through issues"
      ],
      "skill": "he-fix-bugs",
      "required_inputs": [
        "reported behavior",
        "expected behavior or clarification target",
        "reproduction steps or permission to ask for them"
      ],
      "output": "Linear issue intake decision + single/breakdown issue payloads + next-stage route"
    },
    {
      "intent": "branch-hygiene-cleanup",
      "match": [
        "he-prune-branches",
        "clean gone branches",
        "prune local branches",
        "delete stale branches",
        "clean branches removed from remote"
      ],
      "skill": "he-prune-branches",
      "required_inputs": [
        "repository path",
        "confirmation to delete discovered branch set",
        "permission to remove associated worktrees"
      ],
      "output": "gone-branch list + confirmation checkpoint + cleanup report"
    },
    {
      "intent": "readiness-synthesis-review",
      "match": [
        "he-review",
        "he-code-review",
        "go/no-go",
        "readiness review",
        "pre-merge review"
      ],
      "skill": "he-code-review",
      "required_inputs": [
        "diff/PR target",
        "acceptance baseline",
        "review scope"
      ],
      "output": "severity-ranked readiness synthesis and routing"
    },
    {
      "intent": "deep-technical-review",
      "match": [
        "he-technical-review",
        "technical review",
        "deep critique",
        "engineering risks",
        "validate review feedback",
        "review comments might be wrong"
      ],
      "skill": "he-technical-review",
      "required_inputs": [
        "target diff/files or review-feedback items",
        "spec/plan baseline when available"
      ],
      "output": "findings-first technical issues with locations plus feedback validation posture"
    },
    {
      "intent": "reliability-review",
      "match": [
        "he-reliability-review",
        "resilience review",
        "failure modes",
        "SLO readiness",
        "cascading failure"
      ],
      "skill": "he-reliability-review",
      "required_inputs": [
        "service/API target",
        "dependency context",
        "failure impact context"
      ],
      "output": "reliability risks and resilience recommendations"
    },
    {
      "intent": "solved-problem-capture",
      "match": [
        "capture learning",
        "document solved issue",
        "docs/solutions update"
      ],
      "skill": "he-compound",
      "required_inputs": [
        "verified fix evidence",
        "artifact context",
        "desired capture mode"
      ],
      "output": "durable solution artifact and next-stage routing"
    },
    {
      "intent": "docs-solutions-maintenance",
      "match": [
        "refresh docs/solutions",
        "stale solution docs",
        "consolidate overlap"
      ],
      "skill": "he-compound-refresh",
      "required_inputs": [
        "refresh scope",
        "mode preference",
        "evidence source paths"
      ],
      "output": "refresh/consolidation report with evidence"
    }
  ],
  "not_this_plugin": [
    {
      "intent": "coding-harness-cli-operations",
      "examples": [
        "harness init",
        "harness upgrade",
        "harness ci-migrate",
        "harness check-environment"
      ],
      "route_to_skill": "coding-harness",
      "reason": "These operations belong to @brainwav/coding-harness setup and governance, not Harness Engineering stage orchestration."
    },
    {
      "intent": "release-communication",
      "examples": [
        "draft release notes",
        "update changelog",
        "prepare npm release notes handoff",
        "what release shipped this"
      ],
      "route_to_skill": "content-publishing:release-notes",
      "reason": "Harness Engineering may produce the implementation or review evidence, but release communication and npm handoff artifacts belong to the content-publishing release-notes pipeline."
    }
  ],
  "subagent_stage_map": {
    "he-router": {
      "policy": "manual-only",
      "baseline_roles": [],
      "conditional_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "trigger": "only when stage intent is ambiguous"
    },
    "he-compound": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "session-historian",
        "spec-flow-analyzer"
      ],
      "trigger": "delegation requested or resume/recovery ambiguity"
    },
    "he-ideate": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "issue-intelligence-analyst"
      ],
      "trigger": "delegation requested or issue-theme-heavy ideation"
    },
    "he-brainstorm": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher"
      ],
      "trigger": "delegation requested or external constraints drive requirements"
    },
    "he-spec": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher",
        "framework-docs-researcher"
      ],
      "trigger": "delegation requested or standards/framework-sensitive contract"
    },
    "he-deepen-spec": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher",
        "spec-flow-analyzer"
      ],
      "conditional_roles": [
        "coherence-reviewer",
        "scope-guardian-reviewer",
        "product-lens-reviewer",
        "design-lens-reviewer",
        "security-lens-reviewer",
        "reliability-reviewer",
        "architecture-strategist",
        "api-contract-reviewer",
        "data-integrity-guardian",
        "deployment-verification-agent"
      ],
      "trigger": "delegation requested or deep spec weakness/risk signals present"
    },
    "he-plan": {
      "policy": "conditional",
      "baseline_roles": [
