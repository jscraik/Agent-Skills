{
  "schema_version": 1,
  "plugin": "harness-engineering",
  "naming_note": "Visible Harness Engineering stages are compact; folded stage names route through parent stages while preserving their full nested context in references/folded-skill-context.md.",
  "entrypoint": "he-router",
  "deterministic_decision_order": [
    {
      "priority": 10,
      "rule": "direct-stage-invocation",
      "route": "named he-* stage",
      "unless": "the user asks whether the named stage is correct"
    },
    {
      "priority": 15,
      "rule": "stage-correctness-question",
      "route": "he-router",
      "signals": [
        "right stage",
        "correct stage",
        "best stage",
        "which stage",
        "what stage",
        "should we use"
      ]
    },
    {
      "priority": 16,
      "rule": "named-stage-ambiguity",
      "route": "he-router",
      "signals": [
        "multiple named he-* stages",
        "he-* or he-*"
      ]
    },
    {
      "priority": 18,
      "rule": "recurring-control-loop",
      "route": "he-heartbeat",
      "signals": [
        "heartbeat",
        "keep checking",
        "monitor until",
        "wake this thread",
        "every 10m",
        "until green",
        "until merged",
        "recurring follow-up"
      ]
    },
    {
      "priority": 20,
      "rule": "workflow-hygiene",
      "route": "he-router",
      "signals": [
        "stale branch cleanup",
        "gone remote branches",
        "worktree cleanup"
      ],
      "mode": "agent-ops-branch-hygiene-handoff",
      "folded_from": "he-prune-branches"
    },
    {
      "priority": 30,
      "rule": "review-before-more-work",
      "route": "he-code-review",
      "signals": [
        "implemented branch",
        "PR before merge",
        "go/no-go",
        "readiness",
        "pre-merge"
      ]
    },
    {
      "priority": 35,
      "rule": "deep-review-or-feedback-dispute",
      "route": "he-code-review",
      "signals": [
        "deep technical review",
        "engineering risk",
        "review feedback may be wrong",
        "validate comments"
      ],
      "mode": "technical-review",
      "folded_from": "he-technical-review"
    },
    {
      "priority": 36,
      "rule": "reliability-risk-review",
      "route": "he-code-review",
      "signals": [
        "SLO",
        "failure modes",
        "cascading failure",
        "timeout dependency risk",
        "resilience"
      ],
      "mode": "reliability-review",
      "folded_from": "he-reliability-review"
    },
    {
      "priority": 40,
      "rule": "test-first-work",
      "route": "he-work",
      "signals": [
        "TDD",
        "RED/GREEN",
        "failing test first",
        "regression first"
      ],
      "mode": "test-first-execution",
      "folded_from": "he-tdd"
    },
    {
      "priority": 45,
      "rule": "diagnose-before-fix",
      "route": "he-fix-bugs",
      "signals": [
        "failing tests",
        "debug",
        "root cause",
        "reproduce",
        "trace error",
        "regression"
      ]
    },
    {
      "priority": 50,
      "rule": "browser-refinement",
      "route": "he-improve",
      "signals": [
        "browser-first",
        "polish",
        "accessibility iteration",
        "dev server loop",
        "visual refinement"
      ],
      "mode": "browser-or-artifact-refinement",
      "folded_from": "he-refine"
    },
    {
      "priority": 55,
      "rule": "measured-optimization",
      "route": "he-improve",
      "signals": [
        "benchmark",
        "measured experiments",
        "parameter search",
        "optimize",
        "tune"
      ]
    },
    {
      "priority": 57,
      "rule": "session-evidence-routing",
      "route": "he-router",
      "signals": [
        "previous sessions",
        "archived sessions",
        "session collector",
        "~/.codex/sessions",
        "~/.codex/archived_sessions",
        "~/.agents/session-collector",
        "what keeps failing",
        "repeated failures",
        "learn from previous runs"
      ],
      "mode": "session-evidence-outcome-selection",
      "folded_routes": {
        "he-compound-refresh": "he-compound"
      }
    },
    {
      "priority": 60,
      "rule": "deepen-existing-artifact",
      "route": "he-router",
      "signals": [
        "harden existing spec",
        "deepen existing spec",
        "harden existing plan",
        "deepen existing plan"
      ],
      "mode": "artifact-depth-selection",
      "folded_routes": {
        "he-deepen-spec": "he-spec",
        "he-deepen-plan": "he-plan"
      }
    },
    {
      "priority": 70,
      "rule": "forward-lifecycle",
      "route": "he-router",
      "signals": [
        "fuzzy opportunity",
        "ambiguous requirements",
        "write spec",
        "plan implementation",
        "execute approved plan"
      ],
      "mode": "forward-lifecycle-selection",
      "folded_routes": {
        "he-ideate": "he-brainstorm"
      }
    },
    {
      "priority": 80,
      "rule": "qa-intake-by-clarity",
      "route": "he-brainstorm, he-spec, he-fix-bugs, or he-plan",
      "signals": [
        "QA",
        "QA session",
        "report bugs",
        "turn feedback into Linear issues",
        "multiple related QA issues",
        "expected behavior unclear",
        "unclear expected behavior",
        "feedback unclear",
        "confusing workflow"
      ]
    },
    {
      "priority": 90,
      "rule": "ask-once-when-blocked",
      "route": "he-router blocked",
      "signals": [
        "no artifact state",
        "conflicting lifecycle state",
        "missing expected behavior"
      ]
    }
  ],
  "stage_invocation_templates": {
    "he-ideate": "$harness-engineering:he-brainstorm <request>  # folded option-generation; load references/folded-skill-context.md",
    "he-brainstorm": "$harness-engineering:he-brainstorm <request>",
    "he-spec": "$harness-engineering:he-spec <request>",
    "he-deepen-spec": "$harness-engineering:he-spec <request>  # folded deepen-existing-spec; load references/folded-skill-context.md",
    "he-plan": "$harness-engineering:he-plan <request>",
    "he-deepen-plan": "$harness-engineering:he-plan <request>  # folded deepen-existing-plan; load references/folded-skill-context.md",
    "he-work": "$harness-engineering:he-work <plan-or-task>",
    "he-tdd": "$harness-engineering:he-work <request>  # folded test-first-execution; load references/folded-skill-context.md",
    "he-fix-bugs": "$harness-engineering:he-fix-bugs <bug-or-qa-report>",
    "he-improve": "$harness-engineering:he-improve <measurement-goal>",
    "he-refine": "$harness-engineering:he-improve <request>  # folded browser-or-artifact-refinement; load references/folded-skill-context.md",
    "he-code-review": "$harness-engineering:he-code-review <review-target>",
    "he-technical-review": "$harness-engineering:he-code-review <request>  # folded technical-review; load references/folded-skill-context.md",
    "he-reliability-review": "$harness-engineering:he-code-review <request>  # folded reliability-review; load references/folded-skill-context.md",
    "he-prune-branches": "$harness-engineering:he-router <request>  # folded agent-ops-branch-hygiene-handoff; load references/folded-skill-context.md",
    "he-heartbeat": "$harness-engineering:he-heartbeat <target-and-cadence>",
    "he-compound": "$harness-engineering:he-compound <request>",
    "he-compound-refresh": "$harness-engineering:he-compound <request>  # folded refresh-or-resume; load references/folded-skill-context.md",
    "he-router": "$harness-engineering:he-router <request>"
  },
  "routes": [
    {
      "intent": "recurring-harness-engineering-heartbeat",
      "match": [
        "he-heartbeat",
        "heartbeat",
        "keep checking",
        "monitor until green",
        "wake this thread",
        "run this every",
        "poll until merged",
        "recurring follow-up"
      ],
      "skill": "he-heartbeat",
      "required_inputs": [
        "target such as repo, PR, branch, Linear issue, validation command, or artifact",
        "cadence or permission to default to 10m",
        "stop conditions and reporting policy"
      ],
      "output": "durable heartbeat prompt + selected HE stage + live checks + stop conditions"
    },
    {
      "intent": "stage-routing-or-resume",
      "match": [
        "where do we start",
        "resume workflow",
        "what stage next",
        "unknown stage"
      ],
      "skill": "he-compound",
      "required_inputs": [
        "problem or artifact path",
        "constraints",
        "execution preference"
      ],
      "output": "stage decision + exact next skill invocation"
    },
    {
      "intent": "ideation-and-option-generation",
      "match": [
        "he-ideate",
        "idea generation",
        "explore options"
      ],
      "skill": "he-brainstorm",
      "required_inputs": [
        "problem statement",
        "constraints",
        "success signals"
      ],
      "output": "ranked implementation opportunities and recommendation",
      "mode": "option-generation",
      "folded_from": "he-ideate",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "brainstorm-and-requirements-shaping",
      "match": [
        "he-brainstorm",
        "shape requirements",
        "compare directions"
      ],
      "skill": "he-brainstorm",
      "required_inputs": [
        "problem statement",
        "constraints",
        "success signals"
      ],
      "output": "requirements-oriented options with recommendation",
      "default_next_stage": "he-spec",
      "next_stage_exceptions": [
        "continue he-brainstorm when blocking ambiguity remains",
        "route to he-plan only when the brainstorm output is already contract-grade",
        "route to he-work only for tiny low-risk changes with explicit execution approval"
      ]
    },
    {
      "intent": "specification",
      "match": [
        "write a spec",
        "define contract",
        "requirements artifact"
      ],
      "skill": "he-spec",
      "required_inputs": [
        "approved direction",
        "scope boundaries",
        "acceptance criteria"
      ],
      "output": "implementation-grade specification",
      "default_next_stage": "he-plan",
      "next_stage_exceptions": [
        "route to folded he-deepen-spec mode under he-spec when contract gaps or competing interface shapes remain",
        "route to he-work only for tiny low-risk specs with explicit execution approval"
      ]
    },
    {
      "intent": "planning",
      "match": [
        "he-plan",
        "create implementation plan",
        "execution plan",
        "sequence the work"
      ],
      "skill": "he-plan",
      "required_inputs": [
        "governing spec or equivalent",
        "constraints and risks",
        "verification expectations"
      ],
      "output": "execution-ready plan with validation sequence"
    },
    {
      "intent": "deepen-spec-artifact",
      "match": [
        "he-deepen-spec",
        "harden spec",
        "deepen specification"
      ],
      "skill": "he-spec",
      "required_inputs": [
        "existing spec path",
        "known risk areas",
        "acceptance and failure expectations"
      ],
      "output": "spec with stronger boundaries, failure handling, and validation detail",
      "mode": "deepen-existing-spec",
      "folded_from": "he-deepen-spec",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "deepen-plan-artifact",
      "match": [
        "he-deepen-plan",
        "harden plan",
        "deepen implementation plan"
      ],
      "skill": "he-plan",
      "required_inputs": [
        "existing plan path",
        "sequencing or risk concerns",
        "verification expectations"
      ],
      "output": "plan with stronger sequencing, risk treatment, and validation gates",
      "mode": "deepen-existing-plan",
      "folded_from": "he-deepen-plan",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "iterative-optimization",
      "match": [
        "he-improve",
        "optimize",
        "tune",
        "parameter search",
        "run experiments"
      ],
      "skill": "he-improve",
      "required_inputs": [
        "optimization goal or spec path",
        "measurement command",
        "mutable/immutable scope and gates"
      ],
      "output": "baseline + experiment loop + best-result recommendation"
    },
    {
      "intent": "browser-first-refinement",
      "match": [
        "he-refine",
        "polish",
        "refine",
        "start dev server",
        "iterate in browser"
      ],
      "skill": "he-improve",
      "required_inputs": [
        "branch or PR context",
        "dev-server startup constraints",
        "refinement goals and stop condition"
      ],
      "output": "running dev server + iterative refinement loop + next-stage recommendation",
      "mode": "browser-or-artifact-refinement",
      "folded_from": "he-refine",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "execution",
      "match": [
        "he-work",
        "implement",
        "execute plan",
        "ship this"
      ],
      "skill": "he-work",
      "required_inputs": [
        "plan/todo/spec target",
        "repo conventions",
        "verification gates"
      ],
      "output": "implemented changes + validation + handoff package"
    },
    {
      "intent": "test-driven-execution",
      "match": [
        "he-tdd",
        "test-first",
        "tdd",
        "start with failing test",
        "red green"
      ],
      "skill": "he-work",
      "required_inputs": [
        "implementation scope",
        "test harness constraints",
        "verification gates"
      ],
      "output": "test-first execution slices with RED/GREEN evidence",
      "mode": "test-first-execution",
      "folded_from": "he-tdd",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "debugging-and-bug-fixing",
      "match": [
        "he-fix-bugs",
        "debug this",
        "fix this bug",
        "why is this failing",
        "trace this error",
        "reproduce this issue"
      ],
      "skill": "he-fix-bugs",
      "required_inputs": [
        "issue reference or direct symptom",
        "expected behavior",
        "environment/reproduction constraints"
      ],
      "output": "reproduction status + root-cause summary + fix recommendation or implementation evidence"
    },
    {
      "intent": "qa-intake-and-linear-filing",
      "match": [
        "qa session",
        "do qa",
        "report bugs",
        "file these bugs",
        "turn feedback into Linear issues",
        "walk through issues"
      ],
      "skill": "he-fix-bugs",
      "required_inputs": [
        "reported behavior",
        "expected behavior or clarification target",
        "reproduction steps or permission to ask for them"
      ],
      "output": "Linear issue intake decision + single/breakdown issue payloads + next-stage route"
    },
    {
      "intent": "branch-hygiene-cleanup",
      "match": [
        "he-prune-branches",
        "clean gone branches",
        "prune local branches",
        "delete stale branches",
        "clean branches removed from remote"
      ],
      "skill": "he-router",
      "required_inputs": [
        "repository path",
        "confirmation to delete discovered branch set",
        "permission to remove associated worktrees"
      ],
      "output": "gone-branch list + confirmation checkpoint + cleanup report",
      "mode": "agent-ops-branch-hygiene-handoff",
      "folded_from": "he-prune-branches",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "readiness-synthesis-review",
      "match": [
        "he-review",
        "he-code-review",
        "go/no-go",
        "readiness review",
        "pre-merge review"
      ],
      "skill": "he-code-review",
      "required_inputs": [
        "diff/PR target",
        "acceptance baseline",
        "review scope"
      ],
      "output": "severity-ranked readiness synthesis and routing"
    },
    {
      "intent": "deep-technical-review",
      "match": [
        "he-technical-review",
        "technical review",
        "deep critique",
        "engineering risks",
        "validate review feedback",
        "review comments might be wrong"
      ],
      "skill": "he-code-review",
      "required_inputs": [
        "target diff/files or review-feedback items",
        "spec/plan baseline when available"
      ],
      "output": "findings-first technical issues with locations plus feedback validation posture",
      "mode": "technical-review",
      "folded_from": "he-technical-review",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "reliability-review",
      "match": [
        "he-reliability-review",
        "resilience review",
        "failure modes",
        "SLO readiness",
        "cascading failure"
      ],
      "skill": "he-code-review",
      "required_inputs": [
        "service/API target",
        "dependency context",
        "failure impact context"
      ],
      "output": "reliability risks and resilience recommendations",
      "mode": "reliability-review",
      "folded_from": "he-reliability-review",
      "context_reference": "references/folded-skill-context.md"
    },
    {
      "intent": "solved-problem-capture",
      "match": [
        "capture learning",
        "document solved issue",
        "docs/solutions update"
      ],
      "skill": "he-compound",
      "required_inputs": [
        "verified fix evidence",
        "artifact context",
        "desired capture mode"
      ],
      "output": "durable solution artifact and next-stage routing"
    },
    {
      "intent": "session-evidence-improvement",
      "match": [
        "previous sessions",
        "archived sessions",
        "session collector",
        "~/.codex/sessions",
        "~/.codex/archived_sessions",
        "~/.agents/session-collector",
        "learn from previous runs"
      ],
      "skill": "he-improve",
      "required_inputs": [
        "session evidence source or permission to gather it",
        "improvement target such as plugin, workflow, or active run",
        "validation gate for accepted changes"
      ],
      "output": "evidence-backed HE improvement findings and next-stage route"
    },
    {
      "intent": "session-evidence-heartbeat",
      "match": [
        "what keeps failing",
        "repeated HE failures",
        "sessions show we keep waiting"
      ],
      "skill": "he-heartbeat",
      "required_inputs": [
        "recurring failure pattern or wait condition",
        "cadence and stop conditions"
      ],
      "output": "durable heartbeat task definition"
    },
    {
      "intent": "docs-solutions-maintenance",
      "match": [
        "refresh docs/solutions",
        "stale solution docs",
        "consolidate overlap",
        "continue active HE run",
        "resume compound run",
        "refresh compound state",
        "re-check blockers"
      ],
      "skill": "he-compound",
      "required_inputs": [
        "refresh scope or active lifecycle target",
        "mode preference",
        "evidence source paths"
      ],
      "output": "compound refresh report with evidence, blockers, and next HE invocation",
      "mode": "refresh-or-resume",
      "folded_from": "he-compound-refresh",
      "context_reference": "references/folded-skill-context.md"
    }
  ],
  "not_this_plugin": [
    {
      "intent": "coding-harness-cli-operations",
      "examples": [
        "harness init",
        "harness upgrade",
        "harness ci-migrate",
        "harness check-environment"
      ],
      "route_to_skill": "coding-harness",
      "reason": "These operations belong to @brainwav/coding-harness setup and governance, not Harness Engineering stage orchestration."
    },
    {
      "intent": "release-communication",
      "examples": [
        "draft release notes",
        "update changelog",
        "prepare npm release notes handoff",
        "what release shipped this"
      ],
      "route_to_skill": "content-publishing:release-notes",
      "reason": "Harness Engineering may produce the implementation or review evidence, but release communication and npm handoff artifacts belong to the content-publishing release-notes pipeline."
    }
  ],
  "subagent_stage_map": {
    "he-router": {
      "policy": "manual-only",
      "baseline_roles": [],
      "conditional_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "trigger": "only when stage intent is ambiguous"
    },
    "he-compound": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "session-historian",
        "spec-flow-analyzer"
      ],
      "trigger": "delegation requested or resume/recovery ambiguity"
    },
    "he-ideate": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "issue-intelligence-analyst"
      ],
      "trigger": "delegation requested or issue-theme-heavy ideation",
      "parent_stage": "he-brainstorm",
      "folded_mode": "option-generation",
      "context_reference": "references/folded-skill-context.md"
    },
    "he-brainstorm": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher"
      ],
      "trigger": "delegation requested or external constraints drive requirements",
      "default_next_stage": "he-spec"
    },
    "he-spec": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher",
        "framework-docs-researcher"
      ],
      "trigger": "delegation requested or standards/framework-sensitive contract",
      "default_next_stage": "he-plan"
    },
    "he-deepen-spec": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher",
        "spec-flow-analyzer"
      ],
      "conditional_roles": [
        "coherence-reviewer",
        "scope-guardian-reviewer",
        "product-lens-reviewer",
        "design-lens-reviewer",
        "security-lens-reviewer",
        "reliability-reviewer",
        "architecture-strategist",
        "api-contract-reviewer",
        "data-integrity-guardian",
        "deployment-verification-agent"
      ],
      "trigger": "delegation requested or deep spec weakness/risk signals present",
      "parent_stage": "he-spec",
      "folded_mode": "deepen-existing-spec",
      "context_reference": "references/folded-skill-context.md"
    },
    "he-plan": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher",
        "framework-docs-researcher",
        "spec-flow-analyzer"
      ],
      "trigger": "delegation requested or plan depends on external constraints"
    },
    "he-deepen-plan": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "feasibility-reviewer",
        "coherence-reviewer",
        "scope-guardian-reviewer",
        "product-lens-reviewer",
        "design-lens-reviewer",
        "security-lens-reviewer",
        "reliability-reviewer",
        "architecture-strategist",
        "api-contract-reviewer",
        "data-integrity-guardian",
        "deployment-verification-agent"
      ],
      "trigger": "delegation requested or deep plan weakness/risk signals present",
      "parent_stage": "he-plan",
      "folded_mode": "deepen-existing-plan",
      "context_reference": "references/folded-skill-context.md"
    },
    "he-improve": {
      "policy": "conditional",
      "baseline_roles": [
        "repo-research-analyst",
        "learnings-researcher"
      ],
      "conditional_roles": [
        "best-practices-researcher",
        "framework-docs-researcher",
        "worker",
        "testing-reviewer",
        "correctness-reviewer",
        "performance-reviewer"
      ],
      "trigger": "delegation requested or experiment-loop complexity/risk signals present"
