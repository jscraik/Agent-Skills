{
  "schema_version": 1,
  "plugin": "harness-engineering",
  "entrypoint": "he-router",
  "route_samples": {
    "he-router": "This HE request could be he-spec, he-plan, or he-work; choose the right stage without guessing.",
    "he-eval-report": "Generate the eval report and drift validation before Linear completion.",
    "he-strategy": "Create a repository intent and architecture review with moat analysis.",
    "he-refactor": "Generate a high-leverage refactor program with rollback conditions.",
    "he-linear-plan": "Create a Linear execution plan with Now / Next / Later and Portfolio Ops routing.",
    "he-phase-heartbeat": "Use he-phase-heartbeat for an approved phase loop with collector evidence, review gates, cadence, and stop rules."
  },
  "deterministic_decision_order": [
    {
      "priority": 10,
      "rule": "direct-stage-invocation",
      "route": "named he-* stage"
    },
    {
      "priority": 14,
      "rule": "repeated-review-feedback",
      "route": "he-code-review",
      "signals": [
        "repeated review feedback",
        "same missing validation",
        "CodeRabbit and Codex keep flagging",
        "context feedback"
      ]
    },
    {
      "priority": 15,
      "rule": "stage-correctness-question",
      "route": "he-router",
      "signals": [
        "right stage",
        "correct stage",
        "best stage",
        "which stage",
        "what stage",
        "should we use"
      ]
    },
    {
      "priority": 16,
      "rule": "named-stage-ambiguity",
      "route": "he-router",
      "signals": [
        "multiple named he-* stages",
        "he-* or he-*"
      ]
    },
    {
      "priority": 17,
      "rule": "compression-spec-refresh",
      "route": "he-spec",
      "signals": [
        "spec_refresh_required",
        "ruthless compression",
        "agent-native compression",
        "compression recovery",
        "first-contact budget",
        "ablation proof",
        "harness next --json",
        "cockpit-first"
      ]
    },
    {
      "priority": 18,
      "rule": "recurring-control-loop",
      "route": "he-heartbeat",
      "signals": [
        "he-heartbeat",
        "heartbeat",
        "keep checking",
        "monitor until",
        "wake this thread",
        "until green",
        "until merged"
      ]
    },
    {
      "priority": 19,
      "rule": "approved-phase-loop",
      "route": "he-phase-heartbeat",
      "signals": [
        "he-phase-heartbeat",
        "phase heartbeat",
        "approved phase loop",
        "continue approved phases",
        "phase gate before local commit",
        "collector evidence becomes stale",
        "keep he-work going until reviewed"
      ]
    },
    {
      "priority": 20,
      "rule": "workflow-hygiene",
      "route": "he-router",
      "folded_from": "he-prune-branches",
      "signals": [
        "he-prune-branches",
        "stale branch cleanup",
        "gone remote branches",
        "worktree cleanup"
      ]
    },
    {
      "priority": 30,
      "rule": "review-before-more-work",
      "route": "he-code-review",
      "signals": [
        "he-code-review",
        "implemented branch",
        "PR before merge",
        "go/no-go",
        "readiness",
        "pre-merge"
      ]
    },
    {
      "priority": 31,
      "rule": "closure-proof-eval",
      "route": "he-eval-report",
      "signals": [
        "he-eval-report",
        "eval report",
        "drift validation",
        "closure proof",
        "safe to close",
        "Linear completion recommendation",
        "Definition of Done",
        ".harness/evals"
      ]
    },
    {
      "priority": 32,
      "rule": "strategy-cognition",
      "route": "he-strategy",
      "signals": [
        "repo intent",
        "repository intent",
        "architecture review",
        "structural triage",
        "strategic direction",
        "strategy document",
        "ADR compression",
        "core invariants",
        "moat analysis",
        "drift signals",
        "safe to rewrite"
      ]
    },
    {
      "priority": 33,
      "rule": "refactor-program",
      "route": "he-refactor",
      "signals": [
        "refactor program",
        "migration program",
        "architectural migration",
        "staged migration",
        "rollback conditions",
        "anti-regression constraints",
        "high-leverage refactor"
      ]
    },
    {
      "priority": 34,
      "rule": "linear-execution-plan",
      "route": "he-linear-plan",
      "signals": [
        "Linear execution plan",
        "Linear orchestration plan",
        "Now / Next / Later",
        "Do Not Create",
        "Portfolio Ops",
        "Dev Portfolio",
        "milestone mapping",
        "parent issue mapping",
        "human vs agent execution"
      ]
    },
    {
      "priority": 35,
      "rule": "deep-review-or-feedback-dispute",
      "route": "he-code-review",
      "folded_from": "he-technical-review",
      "signals": [
        "he-technical-review",
        "deep technical review",
        "engineering risk",
        "validate comments"
      ]
    },
    {
      "priority": 36,
      "rule": "reliability-risk-review",
      "route": "he-code-review",
      "folded_from": "he-reliability-review",
      "signals": [
        "he-reliability-review",
        "SLO",
        "failure modes",
        "timeout dependency risk",
        "resilience"
      ]
    },
    {
      "priority": 40,
      "rule": "test-first-work",
      "route": "he-work",
      "folded_from": "he-tdd",
      "signals": [
        "he-tdd",
        "TDD",
        "RED/GREEN",
        "failing test first",
        "regression first"
      ]
    },
    {
      "priority": 45,
      "rule": "diagnose-before-fix",
      "route": "he-fix-bugs",
      "signals": [
        "he-fix-bugs",
        "failing tests",
        "debug",
        "root cause",
        "reproduce",
        "trace error",
        "regression"
      ]
    },
    {
      "priority": 50,
      "rule": "browser-refinement",
      "route": "he-improve",
      "folded_from": "he-refine",
      "signals": [
        "he-refine",
        "browser-first",
        "polish",
        "dev server loop",
        "visual refinement"
      ]
    },
    {
      "priority": 55,
      "rule": "measured-optimization",
      "route": "he-improve",
      "signals": [
        "he-improve",
        "benchmark",
        "measured experiments",
        "parameter search",
        "optimize",
        "tune",
        "skill improvement loop",
        "A/B/C loop",
        "spec implementation evaluation loop",
        "improvement-loop spec",
        "improvement-loop implementation",
        "improvement-loop eval"
      ]
    },
    {
      "priority": 57,
      "rule": "session-evidence-routing",
      "route": "he-router",
      "signals": [
        "previous sessions",
        "archived sessions",
        "session collector",
        "~/.agents/session-collector",
        "what keeps failing",
        "repeated failures",
        "learn from previous runs"
      ]
    },
    {
      "priority": 58,
      "rule": "coverage-gap-to-skillify-triage",
      "route": "he-improve before skill-factory:skillify",
      "signals": [
        "coverage-gap",
        "workflow-capture",
        "skillify candidate",
        "skill-refactor-evidence.json",
        "skillify-candidates.json"
      ]
    },
    {
      "priority": 60,
      "rule": "deepen-existing-spec",
      "route": "he-spec",
      "folded_from": "he-deepen-spec",
      "signals": [
        "he-deepen-spec",
        "harden existing spec",
        "deepen existing spec"
      ]
    },
    {
      "priority": 61,
      "rule": "deepen-existing-plan",
      "route": "he-plan",
      "folded_from": "he-deepen-plan",
      "signals": [
        "he-deepen-plan",
        "harden existing plan",
        "deepen existing plan"
      ]
    },
    {
      "priority": 70,
      "rule": "forward-lifecycle",
      "route": "he-brainstorm -> he-spec -> he-plan -> he-work",
      "signals": [
        "fuzzy opportunity",
        "ambiguous requirements",
        "write spec",
        "plan implementation",
        "execute approved plan"
      ]
    },
    {
      "priority": 80,
      "rule": "qa-intake-by-clarity",
      "route": "he-router",
      "signals": [
        "QA",
        "QA session",
        "report bugs",
        "turn feedback into Linear issues",
        "expected behavior unclear",
        "feedback unclear"
      ]
    },
    {
      "priority": 85,
      "rule": "learning-reinforcement",
      "route": "he-reinforce",
      "folded_from": "he-compound-refresh",
      "signals": [
        "he-compound-refresh",
        "compound solved problem",
        "capture solved problem",
        "refresh learning",
        "sync Project Brain learning",
        "remember this fix"
      ]
    },
    {
      "priority": 86,
      "rule": "lifecycle-reconcile",
      "route": "he-reconcile",
      "folded_from": "he-compound",
      "signals": [
        "he-compound",
        "refresh harness state",
        "reconcile lifecycle state",
        "resume compound run",
        "re-check blockers"
      ]
    },
    {
      "priority": 90,
      "rule": "ask-once-when-blocked",
      "route": "he-router",
      "signals": [
        "no artifact state",
        "conflicting lifecycle state",
        "missing expected behavior"
      ]
    }
  ],
  "stage_invocation_templates": {
    "he-brainstorm": "$harness-engineering:he-brainstorm <request>",
    "he-spec": "$harness-engineering:he-spec <request>",
    "he-plan": "$harness-engineering:he-plan <request>",
    "he-work": "$harness-engineering:he-work <plan-or-task>",
    "he-fix-bugs": "$harness-engineering:he-fix-bugs <bug-or-qa-report>",
    "he-improve": "$harness-engineering:he-improve <measurement-goal>",
    "he-code-review": "$harness-engineering:he-code-review <review-target>",
    "he-heartbeat": "$harness-engineering:he-heartbeat <target-and-cadence>",
    "he-reconcile": "$harness-engineering:he-reconcile <state-or-resume-request>",
    "he-reinforce": "$harness-engineering:he-reinforce <solved-problem-or-learning-refresh>",
    "he-compound": "$harness-engineering:he-compound <deprecated-compatibility-request>",
    "he-eval-report": "$harness-engineering:he-eval-report <completed-slice-or-pr>",
    "he-strategy": "$harness-engineering:he-strategy <strategy-or-review-request>",
    "he-refactor": "$harness-engineering:he-refactor <migration-candidate>",
    "he-linear-plan": "$harness-engineering:he-linear-plan <harness-artifacts>",
    "he-phase-heartbeat": "$harness-engineering:he-phase-heartbeat <approved-phase-plan-and-cadence>"
  },
  "routes": [
    {
      "intent": "coverage-gap-to-skillify-triage",
      "skill": "he-improve",
      "required_inputs": [
        "evidence bundle path",
        "coverage check",
        "redaction-report.json status"
      ],
      "output": "triage decision: update-existing-stage, add-reference-material, add-validation-script, skillify-new-skill, or no-action-noise"
    },
    {
      "intent": "skill-improvement-loop",
      "skill": "he-improve",
      "required_inputs": [
        "target skill path",
        "baseline evidence",
        "audit or evaluator result when feasible",
        "session evidence bundle when relevant"
      ],
      "output": "A/B/C loop status, spec acceptance IDs, implementation summary, evaluator changes, warnings_remaining, stop_rule_status"
    },
    {
      "intent": "agent-native-compression-recovery",
      "skill": "he-spec",
      "required_inputs": [
        "feedback or diagnosis naming compression failure",
        "target product golden-path command",
        "current visible surface evidence when available"
      ],
      "output": "compression recovery spec with first-contact budget, agent catalog budget, standalone command admission, docs deletion budget, fresh-agent eval, ablation proof, and evidence-backed metric gates"
    },
    {
      "intent": "closure-proof-eval",
      "skill": "he-eval-report",
      "required_inputs": [
        "completed implementation or PR",
        "selected execution slice",
        "Linear parent issue or milestone",
        "validation evidence or blocker explanation"
      ],
      "output": "eval artifact under .harness/evals/** with drift validation, proof artifacts, and Linear completion recommendation"
    },
    {
      "intent": "strategy-cognition",
      "skill": "he-strategy",
      "required_inputs": [
        "repo or .harness artifact scope",
        "selected mode",
        "evidence surfaces"
      ],
      "output": "dated .harness strategy/review/triage/features artifact or ADR/core compression decision"
    },
    {
      "intent": "refactor-program",
      "skill": "he-refactor",
      "required_inputs": [
        "strategy/review/triage evidence",
        "migration candidate",
        "affected systems"
      ],
      "output": "dated .harness/refactors program with phases, rollback, eval proof, and Linear mapping"
    },
    {
      "intent": "linear-execution-plan",
      "skill": "he-linear-plan",
      "required_inputs": [
        "approved .harness cognition",
        "target repo or portfolio scope",
        "known Linear identifiers when available"
      ],
      "output": "dated .harness/linear plan with Now/Next/Later/Do Not Create, eval gates, and human/agent routing"
    },
    {
      "intent": "approved-phase-heartbeat",
      "skill": "he-phase-heartbeat",
      "required_inputs": [
        "approved phase plan",
        "active phase and stop condition",
        "collector bundle or recovery step",
        "cadence and review policy"
      ],
      "output": "phase heartbeat status with selected active phase, collector evidence state, review gates, validation, commit status, slack policy, blockers, and next wakeup"
    }
  ],
