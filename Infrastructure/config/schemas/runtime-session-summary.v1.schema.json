{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-skills.local/schemas/runtime-session-summary.v1.schema.json",
  "title": "Runtime Session Summary v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "runtime_target",
    "runtime_status",
    "created_at",
    "workspace_root",
    "actor_type",
    "visibility_status"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_target": {
      "$ref": "#/definitions/runtimeTarget"
    },
    "runtime_status": {
      "$ref": "#/definitions/runtimeStatus"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "$ref": "#/definitions/actorType"
    },
    "visibility_status": {
      "$ref": "#/definitions/visibilityStatus"
    },
    "unavailable_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "runtimeTarget": {
      "type": "string",
      "enum": ["codex", "agents", "local_model", "fixture"]
    },
    "runtimeStatus": {
      "type": "string",
      "enum": [
        "implemented_enforced",
        "implemented_not_enforced",
        "scaffolded",
        "modeled_only",
        "partial",
        "blocked_runtime",
        "stale_or_drifted"
      ]
    },
    "actorType": {
      "type": "string",
      "enum": ["user", "agent", "system"]
    },
    "visibilityStatus": {
      "type": "string",
      "enum": ["user_observable", "agent_only"]
    }
  }
}
