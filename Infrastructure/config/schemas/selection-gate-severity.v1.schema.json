{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Selection Gate Severity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "all_required_passed",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "selection-gate-severity.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "all_required_passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode",
          "result",
          "rationale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "required",
              "warn"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "skipped"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "log_file": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
