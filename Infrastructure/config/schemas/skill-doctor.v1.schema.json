{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-skills.local/schemas/skill-doctor.v1.schema.json",
  "title": "Skill Doctor Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "target_kind",
    "target_summary",
    "status",
    "blockers",
    "warnings",
    "readiness_taxonomy",
    "sdk_layers",
    "contract_schemas",
    "contract_schema_versions",
    "operation_context",
    "lifecycle_event",
    "lifecycle_event_types",
    "checks",
    "check_summary",
    "agent_summary",
    "next_command"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "skill-doctor.v1"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "target_kind": {
      "type": "string",
      "enum": ["command_handle", "canonical_source_path", "invalid_path", "unknown"]
    },
    "handle": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "canonical_source_path": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "audit_target": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "target_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query", "target_kind"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "canonical_source_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "audit_target": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "warning", "blocked"]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "readiness_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockers", "warnings"],
      "properties": {
        "blockers": {
          "$ref": "#/definitions/stringMap"
        },
        "warnings": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "sdk_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Contracts",
          "Catalog",
          "Authoring",
          "Validation",
          "Packaging",
          "Runtime Adapters",
          "Evidence",
          "Memory"
        ]
      }
    },
    "contract_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctor", "events", "lifecycle_event", "profiles", "package", "memory"],
      "properties": {
        "doctor": {
          "$ref": "#/definitions/schemaRef"
        },
        "events": {
          "$ref": "#/definitions/schemaRef"
        },
        "lifecycle_event": {
          "$ref": "#/definitions/schemaRef"
        },
        "profiles": {
          "$ref": "#/definitions/schemaRef"
        },
        "package": {
          "$ref": "#/definitions/schemaRef"
        },
        "memory": {
          "$ref": "#/definitions/schemaRef"
        }
      }
    },
    "contract_schema_versions": {
      "$ref": "#/definitions/stringMap"
    },
    "operation_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primary_profile", "profiles", "events", "validation_commands"],
      "properties": {
        "primary_profile": {
          "type": "string",
          "minLength": 1
        },
        "review_profile": {
          "type": "string",
          "minLength": 1
        },
        "next_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": true
        },
        "events": {
          "type": "object",
          "additionalProperties": true
        },
        "follow_up_commands": {
          "$ref": "#/definitions/stringList"
        },
        "validation_commands": {
          "$ref": "#/definitions/stringList"
        }
      }
    },
    "lifecycle_event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "event_type", "event_identity", "outcome"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "capability-lifecycle-event.v1"
        },
        "event_type": {
          "type": "string",
          "const": "skill_doctor_completed"
        },
        "event_identity": {
          "type": "object",
          "additionalProperties": true
        },
        "outcome": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "blocker_classes", "warning_classes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "warning", "blocked"]
            },
            "blocker_classes": {
              "$ref": "#/definitions/stringList"
            },
            "warning_classes": {
              "$ref": "#/definitions/stringList"
            }
          }
        }
      }
    },
    "lifecycle_event_types": {
      "$ref": "#/definitions/stringMap"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver",
        "canonical_source",
        "structural_audit",
        "risk_classification",
        "capability_metadata",
        "package_readiness",
        "outcome_proof"
      ],
      "properties": {
        "resolver": {
          "$ref": "#/definitions/check"
        },
        "runtime_reachability": {
          "$ref": "#/definitions/check"
        },
        "canonical_source": {
          "$ref": "#/definitions/check"
        },
        "projection_ownership": {
          "$ref": "#/definitions/check"
        },
        "structural_audit": {
          "$ref": "#/definitions/check"
        },
        "risk_classification": {
          "$ref": "#/definitions/check"
        },
        "capability_metadata": {
          "$ref": "#/definitions/check"
        },
        "package_readiness": {
          "$ref": "#/definitions/check"
        },
        "outcome_proof": {
          "$ref": "#/definitions/check"
        }
      }
    },
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_names", "check_count", "status_counts", "failed_checks", "warning_checks"],
      "properties": {
        "check_names": {
          "$ref": "#/definitions/stringList"
        },
        "check_count": {
          "type": "integer",
          "minimum": 1
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "failed_checks": {
          "$ref": "#/definitions/stringList"
        },
        "warning_checks": {
          "$ref": "#/definitions/stringList"
        }
      }
    },
    "agent_summary": {
      "type": "string",
      "minLength": 1
    },
    "next_command": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "next_command_decision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command", "precedence", "reason"],
      "properties": {
        "command": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "precedence": {
          "type": "string",
          "enum": ["blocker", "warning", "default"]
        },
        "source_class": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_check": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "sdk_layer"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "warning", "missing", "available_not_run", "skipped", "blocked"]
        },
        "sdk_layer": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "sdk_layer", "message", "definition"],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "sdk_layer": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "owner", "stability"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "const": "Agent Skills Kit"
        },
        "stability": {
          "type": "string",
          "enum": ["experimental", "stable"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "missing_schema_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["missing_schema_reason"]
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
