{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/scenario-adaptation-receipt.v0.schema.json",
  "title": "Skills SDK Scenario Adaptation Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.scenario-adaptation-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/scenario-adaptation-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "operation": {"type": "string", "const": "scenario_registry_adapt"},
    "authorized_stage": {
      "type": "string",
      "enum": ["skill_creation", "skill_install", "skill_update", "skill_refactor", "skill_builder_audit", "scenario_generation", "eval_routing", "repair_loop"]
    },
    "operator_context": {"type": "object", "additionalProperties": false, "properties": {
      "command": {"type": "string", "minLength": 1},
      "workspace": {"type": "string", "minLength": 1}
    }, "required": ["command", "workspace"]},
    "registry_source": {"type": "object", "additionalProperties": false, "properties": {
      "canonical_scenario_id": {"type": "string", "minLength": 1},
      "version": {"type": "string", "minLength": 1},
      "digest": {"type": "string", "minLength": 1}
    }, "required": ["canonical_scenario_id", "version", "digest"]},
    "target_skill": {"type": "object", "additionalProperties": false, "properties": {
      "path": {"type": "string", "minLength": 1},
      "package_id": {"type": "string", "minLength": 1},
      "source_head": {"type": "string", "minLength": 7}
    }, "required": ["path", "package_id", "source_head"]},
    "target_case_id": {"type": "string", "minLength": 1},
    "localization_summary": {"type": "string", "minLength": 1},
    "criteria_ownership": {"type": "object", "additionalProperties": false, "properties": {
      "local_criteria_authoritative": {"type": "boolean", "const": true},
      "criteria_path": {"type": "string", "minLength": 1}
    }, "required": ["local_criteria_authoritative", "criteria_path"]},
    "fixture_asset_plan": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "domain_fit": {"type": "string", "minLength": 1},
    "nonportable_assumptions_removed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/commandEvidence"}},
    "mutation_manifest": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "authorized_stage",
    "operator_context",
    "registry_source",
    "target_skill",
    "target_case_id",
    "localization_summary",
    "criteria_ownership",
    "fixture_asset_plan",
    "acceptance_mapping",
    "domain_fit",
    "nonportable_assumptions_removed",
    "validation",
    "mutation_manifest",
    "blockers"
  ],
  "definitions": {
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "fail", "blocked"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "required": ["command", "status", "evidence_ref"]
    }
  }
}
