{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/package-hardening-receipt.v0.schema.json",
  "title": "Skills SDK Package Hardening Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.package-hardening-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/package-hardening-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 71},
    "manifest_digest": {"type": "string", "minLength": 71},
    "package_digest": {"type": "string", "minLength": 71},
    "included_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "file_count": {"type": "integer", "minimum": 0},
    "total_size_bytes": {"type": "integer", "minimum": 0},
    "hardening_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/hardeningCheck"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/hardeningCheck"}},
    "warnings": {"type": "array", "items": {"$ref": "#/definitions/hardeningCheck"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "VP-021", "VP-022"]}}
  },
  "required": ["schema_version", "schema_uri", "status", "package_id", "version", "source_digest", "manifest_digest", "package_digest", "included_files", "file_count", "total_size_bytes", "hardening_checks", "blockers", "warnings", "mutation_performed", "acceptance_trace"],
  "definitions": {
    "hardeningCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "warning", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "warning", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
