  "title": "AbPlanReceipt",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "command_plan": {
            "maxItems": 2,
            "minItems": 2
          },
          "command_variant_labels": {
            "maxItems": 2,
            "minItems": 2
          },
          "runtime_profile_gates": {
            "items": {
              "properties": {
                "command_plan": {
                  "maxItems": 2,
                  "minItems": 2
                },
                "status": {
                  "const": "planned"
                }
              }
            },
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {"properties": {"order": {"const": 1}, "lane": {"const": "oss-local"}, "codex_profile": {"const": "oss-local"}}},
              {"properties": {"order": {"const": 2}, "lane": {"const": "oss-cloud"}, "codex_profile": {"const": "oss-cloud"}}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          },
          "command_plan": {
            "maxItems": 0
          },
          "command_variant_labels": {
            "maxItems": 0
          },
          "runtime_profile_gates": {
            "items": {
              "properties": {
                "command_plan": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    }
  ]
