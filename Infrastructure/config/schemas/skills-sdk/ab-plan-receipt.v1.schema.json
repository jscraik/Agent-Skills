{
  "$id": "https://agent-skills.local/schemas/skills-sdk/ab-plan-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AbAuthPreflightFact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_source": {
          "minLength": 1,
          "title": "Evidence Source",
          "type": "string"
        },
        "evidence_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbPreflightBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "auth_reference": {
          "enum": [
            "none",
            "codex_cli_auth"
          ],
          "title": "Auth Reference",
          "type": "string"
        },
        "secret_value_observed": {
          "const": false,
          "title": "Secret Value Observed",
          "type": "boolean"
        },
        "auth_source": {
          "default": "not_applicable",
          "enum": [
            "not_applicable",
            "missing_or_invalid",
            "op_fifo",
            "op_opaque_env_file"
          ],
          "title": "Auth Source",
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "evidence_digest",
        "blocker",
        "auth_reference",
        "secret_value_observed"
      ],
      "title": "AbAuthPreflightFact",
      "type": "object"
    },
    "AbCatalogPreflightFact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_source": {
          "minLength": 1,
          "title": "Evidence Source",
          "type": "string"
        },
        "evidence_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbPreflightBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_identity": {
          "minLength": 1,
          "title": "Catalog Identity",
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "evidence_digest",
        "blocker",
        "catalog_identity"
      ],
      "title": "AbCatalogPreflightFact",
      "type": "object"
    },
    "AbCodexCommandPlan": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"codex_profile": {"const": "oss-local"}}, "required": ["codex_profile"]},
          "then": {
            "properties": {
              "command_argv": {"prefixItems": [{"const": "codex"}, {"const": "exec"}, {"const": "--profile"}, {"const": "oss-local"}, {"const": "--ask-for-approval"}, {"const": "on-request"}]},
              "execution_argv": {"prefixItems": [{"const": "codex"}, {"const": "exec"}, {"const": "--profile"}, {"const": "oss-local"}, {"const": "--ask-for-approval"}, {"const": "on-request"}]}
            }
          }
        },
        {
          "if": {"properties": {"codex_profile": {"const": "oss-cloud"}}, "required": ["codex_profile"]},
          "then": {
            "properties": {
              "command_argv": {"prefixItems": [{"const": "codex"}, {"const": "exec"}, {"const": "--profile"}, {"const": "oss-cloud"}, {"const": "--ask-for-approval"}, {"const": "on-request"}]},
              "execution_argv": {"prefixItems": [{"type": "string"}, {"const": "run"}, {"const": "--env-file"}, {"const": "<operator-approved-opaque-env-stream>"}, {"const": "--"}, {"const": "codex"}, {"const": "exec"}, {"const": "--profile"}, {"const": "oss-cloud"}, {"const": "--ask-for-approval"}, {"const": "on-request"}]}
            }
          }
        }
      ],
      "properties": {
        "variant_label": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Variant Label",
          "type": "string"
        },
        "codex_profile": {
          "enum": [
            "oss-local",
            "oss-cloud"
          ],
          "title": "Codex Profile",
          "type": "string"
        },
        "command_argv": {
          "items": {
            "type": "string"
          },
          "minItems": 10,
          "uniqueItems": true,
          "title": "Command Argv",
          "type": "array"
        },
        "execution_argv": {
          "items": {"type": "string"},
          "minItems": 10,
          "uniqueItems": true,
          "title": "Execution Argv",
          "type": "array"
        },
        "sandbox_mode": {
          "enum": [
            "read-only",
            "workspace-write"
          ],
          "title": "Sandbox Mode",
          "type": "string"
        },
        "approval_policy": {
          "const": "on-request",
          "title": "Approval Policy",
          "type": "string"
        },
        "event_log_path": {
          "minLength": 1,
          "title": "Event Log Path",
          "type": "string"
        },
        "output_last_message_path": {
          "minLength": 1,
          "title": "Output Last Message Path",
          "type": "string"
        },
        "prompt_stdin_path": {
          "minLength": 1,
          "title": "Prompt Stdin Path",
          "type": "string"
        },
        "runner_stdout_capture_path": {
          "minLength": 1,
          "title": "Runner Stdout Capture Path",
          "type": "string"
        },
        "runner_prompt_input_path": {
          "minLength": 1,
          "title": "Runner Prompt Input Path",
          "type": "string"
        },
        "prompt_stdin_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Stdin Digest",
          "type": "string"
        },
        "planned_write_paths": {
          "items": {
            "type": "string"
          },
          "title": "Planned Write Paths",
          "type": "array"
        },
        "allowed_secret_env_names": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Secret Env Names",
          "type": "array"
        }
      },
      "required": [
        "variant_label",
        "codex_profile",
        "command_argv",
        "execution_argv",
        "sandbox_mode",
        "approval_policy",
        "event_log_path",
        "output_last_message_path",
        "prompt_stdin_path",
        "runner_stdout_capture_path",
        "runner_prompt_input_path",
        "prompt_stdin_digest",
        "planned_write_paths",
        "allowed_secret_env_names"
      ],
      "title": "AbCodexCommandPlan",
      "type": "object"
    },
    "AbFixtureIdentity": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "digest",
        "size_bytes"
      ],
      "title": "AbFixtureIdentity",
      "type": "object"
    },
    "AbLanePreflight": {
      "allOf": [
        {
          "if": {
            "properties": {
              "admission": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "admission"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "properties": {
                  "status": {
                    "enum": [
                      "pass",
                      "not_applicable"
                    ]
                  }
                }
              },
              "catalog": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              },
              "model_catalog": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              },
              "profile_config": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "status": {
                    "enum": ["pass", "not_applicable"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission": {
                "properties": {"status": {"const": "pass"}},
                "required": ["status"]
              },
              "profile_config": {
                "properties": {"profile_id": {"const": "oss-cloud"}},
                "required": ["profile_id"]
              }
            },
            "required": ["admission", "profile_config"]
          },
          "then": {
            "properties": {
              "auth": {
                "properties": {"status": {"const": "pass"}},
                "required": ["status"]
              }
            },
            "required": ["auth"]
          }
        },
        {
          "if": {
            "properties": {
              "admission": {
                "properties": {"status": {"const": "pass"}},
                "required": ["status"]
              },
              "profile_config": {
                "properties": {"profile_id": {"const": "oss-local"}},
                "required": ["profile_id"]
              }
            },
            "required": ["admission", "profile_config"]
          },
          "then": {
            "properties": {
              "auth": {
                "properties": {"status": {"const": "not_applicable"}},
                "required": ["status"]
              }
            },
            "required": ["auth"]
          }
        },
        {
          "if": {
            "properties": {
              "admission": {
                "properties": {"status": {"const": "pass"}},
                "required": ["status"]
              },
              "runtime": {
                "properties": {"status": {"const": "not_applicable"}},
                "required": ["status"]
              }
            },
            "required": ["admission", "runtime"]
          },
          "then": {
            "properties": {
              "profile_config": {
                "properties": {"profile_id": {"const": "oss-cloud"}},
                "required": ["profile_id"]
              },
              "runtime": {
                "properties": {
                  "status": {"const": "not_applicable"},
                  "availability_kind": {"const": "cloud_endpoint"},
                  "blocker": {"type": "null"},
                  "codex_executable_identity": {"pattern": "^sha256:[0-9a-f]{64}$"}
                },
                "required": ["status", "availability_kind", "blocker", "codex_executable_identity"]
              }
            },
            "required": ["profile_config", "runtime"]
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "profile_config": {
          "$ref": "#/$defs/AbProfileConfigPreflightFact"
        },
        "model_catalog": {
          "$ref": "#/$defs/AbModelCatalogPreflightFact"
        },
        "runtime": {
          "$ref": "#/$defs/AbRuntimePreflightFact"
        },
        "auth": {
          "$ref": "#/$defs/AbAuthPreflightFact"
        },
        "catalog": {
          "$ref": "#/$defs/AbCatalogPreflightFact"
        },
        "admission": {
          "$ref": "#/$defs/AbPreflightAdmission"
        }
      },
      "required": [
        "profile_config",
        "model_catalog",
        "runtime",
        "auth",
        "catalog",
        "admission"
      ],
      "title": "AbLanePreflight",
      "type": "object"
    },
    "AbModelCatalogPreflightFact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_source": {
          "minLength": 1,
          "title": "Evidence Source",
          "type": "string"
        },
        "evidence_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbPreflightBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_model_id": {
          "minLength": 1,
          "title": "Selected Model Id",
          "type": "string"
        },
        "catalog_identity": {
          "minLength": 1,
          "title": "Catalog Identity",
          "type": "string"
        },
        "probe_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Url"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "catalog_digest": {
          "anyOf": [
            {
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Digest"
        },
        "matched_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Model"
        },
        "network_accessed": {
          "default": false,
          "title": "Network Accessed",
          "type": "boolean"
        },
        "secret_value_observed": {
          "const": false,
          "default": false,
          "title": "Secret Value Observed",
          "type": "boolean"
        },
        "generation_performed": {
          "const": false,
          "default": false,
          "title": "Generation Performed",
          "type": "boolean"
        },
        "provider_invoked": {
          "const": false,
          "default": false,
          "title": "Provider Invoked",
          "type": "boolean"
        },
        "codex_exec_invoked": {
          "const": false,
          "default": false,
          "title": "Codex Exec Invoked",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "evidence_digest",
        "blocker",
        "selected_model_id",
        "catalog_identity"
      ],
      "title": "AbModelCatalogPreflightFact",
      "type": "object"
    },
    "AbPreflightAdmission": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/AbPreflightBlocker"
          },
          "title": "Blockers",
          "type": "array"
        },
        "secret_values_observed": {
          "const": false,
          "title": "Secret Values Observed",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "blockers",
        "secret_values_observed"
      ],
      "title": "AbPreflightAdmission",
      "type": "object"
    },
    "AbPreflightBlocker": {
      "additionalProperties": false,
      "properties": {
        "blocker_class": {
          "enum": [
            "profile_config_missing_or_invalid",
            "model_catalog_entry_missing",
            "local_runtime_unavailable",
            "codex_cli_unavailable",
            "local_runtime_binary_unavailable",
            "local_runtime_service_unavailable",
            "local_model_unavailable",
            "cloud_auth_unavailable",
            "cloud_catalog_unavailable",
            "selected_model_unavailable",
            "preflight_evidence_missing"
          ],
          "title": "Blocker Class",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "blocker_class",
        "reason"
      ],
      "title": "AbPreflightBlocker",
      "type": "object"
    },
    "AbProfileConfigPreflightFact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_source": {
          "minLength": 1,
          "title": "Evidence Source",
          "type": "string"
        },
        "evidence_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbPreflightBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_id": {
          "enum": [
            "oss-local",
            "oss-cloud"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "configured_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Model Id"
        },
        "configured_provider_id": {
          "anyOf": [
            {
              "enum": [
                "ollama",
                "ollama-cloud"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Provider Id"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "evidence_digest",
        "blocker",
        "profile_id"
      ],
      "title": "AbProfileConfigPreflightFact",
      "type": "object"
    },
    "AbRuntimePreflightFact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "blocked",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_source": {
          "minLength": 1,
          "title": "Evidence Source",
          "type": "string"
        },
        "evidence_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbPreflightBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability_kind": {
          "enum": [
            "local_model",
            "cloud_endpoint"
          ],
          "title": "Availability Kind",
          "type": "string"
        },
        "selected_model_id": {
          "minLength": 1,
          "title": "Selected Model Id",
          "type": "string"
        },
        "codex_executable_identity": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codex Executable Identity"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "evidence_digest",
        "blocker",
        "availability_kind",
        "selected_model_id"
      ],
      "title": "AbRuntimePreflightFact",
      "type": "object"
    },
    "AbRuntimeProfilePlanGate": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "enum": [
            1,
            2
          ],
          "title": "Order",
          "type": "integer"
        },
        "lane": {
          "enum": [
            "oss-local",
            "oss-cloud"
          ],
          "title": "Lane",
          "type": "string"
        },
        "codex_profile": {
          "enum": [
            "oss-local",
            "oss-cloud"
          ],
          "title": "Codex Profile",
          "type": "string"
        },
        "judge_profile": {
          "$ref": "#/$defs/EvalJudgeProfile"
        },
        "status": {
          "enum": [
            "planned",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/AbPreflightBlocker"
          },
          "title": "Blockers",
          "type": "array"
        },
        "preflight": {
          "$ref": "#/$defs/AbLanePreflight"
        },
        "command_plan": {
          "items": {
            "$ref": "#/$defs/AbCodexCommandPlan"
          },
          "maxItems": 2,
          "title": "Command Plan",
          "type": "array"
        }
      },
      "required": [
        "order",
        "lane",
        "codex_profile",
        "judge_profile",
        "status",
        "blockers",
        "preflight",
        "command_plan"
      ],
      "title": "AbRuntimeProfilePlanGate",
      "type": "object"
    },
    "AbSkillVariant": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Label",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "skill_ir_schema_version": {
          "minLength": 1,
          "title": "Skill Ir Schema Version",
          "type": "string"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_digest": {
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Package Digest",
          "type": "string"
        }
      },
      "required": [
        "label",
        "query",
        "skill_ir_schema_version",
        "package_id",
        "package_digest"
      ],
      "title": "AbSkillVariant",
      "type": "object"
    },
    "EvalExecutionProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "runner": {
          "const": "codex_exec",
          "title": "Runner",
          "type": "string"
        },
        "sandbox_mode": {
          "enum": [
            "read-only",
            "workspace-write"
          ],
          "title": "Sandbox Mode",
          "type": "string"
        },
        "approval_policy": {
          "const": "on-request",
          "title": "Approval Policy",
          "type": "string"
        },
        "codex_json_events_required": {
          "const": true,
          "title": "Codex Json Events Required",
          "type": "boolean"
        },
        "output_schema_supported": {
          "const": true,
          "title": "Output Schema Supported",
          "type": "boolean"
        },
        "mutation_allowed": {
          "title": "Mutation Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "runner",
        "sandbox_mode",
        "approval_policy",
        "codex_json_events_required",
        "output_schema_supported",
        "mutation_allowed"
      ],
      "title": "EvalExecutionProfile",
      "type": "object"
    },
    "EvalJudgeModelSettings": {
      "additionalProperties": false,
      "properties": {
        "num_ctx": {
          "minimum": 1,
          "title": "Num Ctx",
          "type": "integer"
        },
        "num_predict": {
          "anyOf": [
            {
              "minimum": 1,
