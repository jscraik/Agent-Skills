{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/emitter-preview-receipt.v0.schema.json",
  "title": "Skills SDK Emitter Preview Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.emitter-preview-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/emitter-preview-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "blocked"]},
    "operation": {"type": "string", "const": "emitter_write_plan_preview"},
    "projection": {"type": "string", "const": "runtime-skill"},
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "package_digest": {"type": "string", "minLength": 71},
    "target_root": {"type": "string", "const": ".agents/skills"},
    "write_plan": {"type": "array", "items": {"$ref": "#/definitions/writeAction"}},
    "required_receipts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["package_digest_receipt", "package_hardening_receipt"]}
    },
    "emitter_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/check"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "artifact_emitted": {"type": "boolean", "const": false},
    "remote_publish_requested": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["PU-027", "FR-003", "FR-008", "SA-003", "VP-027"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "projection",
    "package_id",
    "version",
    "package_digest",
    "target_root",
    "write_plan",
    "required_receipts",
    "emitter_checks",
    "blockers",
    "mutation_performed",
    "artifact_emitted",
    "remote_publish_requested",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "writeAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "enum": ["write", "skip"]},
        "source_path": {"type": "string", "minLength": 1},
        "target_path": {"type": "string", "minLength": 1},
        "source_digest": {"type": ["string", "null"], "minLength": 64},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["action", "source_path", "target_path", "source_digest", "reason"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "const": "blocker"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
