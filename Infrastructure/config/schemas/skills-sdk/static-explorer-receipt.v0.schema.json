{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/static-explorer-receipt.v0.schema.json",
  "title": "Skills SDK Static Explorer Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.static-explorer-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/static-explorer-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "blocked"]},
    "operation": {"type": "string", "const": "static_explorer_preview"},
    "capability_count": {"type": "integer", "minimum": 0},
    "skill_count": {"type": "integer", "minimum": 0},
    "skill_sets": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "capability_index": {"type": "array", "items": {"$ref": "#/definitions/capabilityRow"}},
    "skill_index": {"type": "array", "items": {"$ref": "#/definitions/skillRow"}},
    "projection_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "explorer_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/check"}},
    "html_rendered": {"type": "boolean", "const": false},
    "hosted_publish_requested": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["PU-029", "FR-003", "FR-008", "VP-029"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "capability_count",
    "skill_count",
    "skill_sets",
    "capability_index",
    "skill_index",
    "projection_inputs",
    "explorer_checks",
    "blockers",
    "html_rendered",
    "hosted_publish_requested",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "capabilityRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "preview_only",
            "placeholder_optional",
            "placeholder_blocked",
            "blocked_missing_adapter",
            "deferred",
            "out_of_scope"
          ]
        },
        "owner_surface": {"type": "string", "minLength": 1}
      },
      "required": ["id", "title", "status", "owner_surface"]
    },
    "skillRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "skill_set": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1}
      },
      "required": ["id", "skill_set", "source_path"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "const": "blocker"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
