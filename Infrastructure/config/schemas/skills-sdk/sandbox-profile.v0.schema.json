{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/sandbox-profile.v0.schema.json",
  "title": "Skills SDK Sandbox Profile v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.sandbox-profile.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/sandbox-profile.v0.schema.json"},
    "profile_id": {"type": "string", "minLength": 1},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high", "privileged", "published"]},
    "default_policy": {"type": "string", "enum": ["deny", "allow"]},
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "temp_write": {"type": "boolean"}
      },
      "required": ["read", "write", "temp_write"]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress": {"type": "string", "enum": ["deny", "allow"]}
      },
      "required": ["egress"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": {"type": "boolean"},
        "allowed": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["inherit", "allowed"]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shell_allowed": {"type": "boolean"},
        "allow": {"type": "array", "items": {"$ref": "#/definitions/commandRule"}}
      },
      "required": ["shell_allowed", "allow"]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "enum": ["none", "local", "remote"]},
        "adapter": {"type": ["string", "null"]}
      },
      "required": ["provider", "adapter"]
    },
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-008", "FR-010", "SA-004", "SA-007", "SEC-001", "VP-021"]}}
  },
  "required": ["schema_version", "schema_uri", "profile_id", "risk_tier", "default_policy", "filesystem", "network", "environment", "commands", "execution", "acceptance_trace"],
  "definitions": {
    "commandRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["program", "args"]
    }
  }
}
