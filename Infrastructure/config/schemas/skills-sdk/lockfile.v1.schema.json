{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/lockfile.v1.schema.json",
  "title": "Skills SDK Project Lockfile V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.lockfile.v1"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/lockfile.v1.schema.json"},
    "generated_by": {"type": "string"},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "source_path": {"type": "string"},
          "source_digest": {"type": "string"},
          "target_path": {"type": "string"},
          "receipt_ref": {"type": "string"},
          "installed_at": {"type": "string"},
          "files": {"type": "array", "items": {"$ref": "install-receipt.v1.schema.json#/definitions/file_record"}}
        },
        "required": ["name", "source_path", "source_digest", "target_path", "receipt_ref", "installed_at", "files"]
      }
    }
  },
  "required": ["schema_version", "schema_uri", "generated_by", "entries"]
}
