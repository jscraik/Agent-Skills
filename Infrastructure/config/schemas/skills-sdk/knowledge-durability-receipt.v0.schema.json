{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/knowledge-durability-receipt.v0.schema.json",
  "title": "Skills SDK Knowledge Durability Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.knowledge-durability-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/knowledge-durability-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "operation": {"type": "string", "const": "knowledge_durability_preview"},
    "skill_path": {"type": "string", "minLength": 1},
    "cache_owned": {"type": "boolean"},
    "durable_source_path": {"type": ["string", "null"], "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/check"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "command_execution_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-008", "SA-003", "VP-032"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "schema_uri", "status", "operation", "skill_path", "cache_owned", "durable_source_path", "checks", "blockers", "mutation_performed", "command_execution_performed", "acceptance_trace", "agent_summary"],
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
