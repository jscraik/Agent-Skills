{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/trust-decision-receipt.v0.schema.json",
  "title": "Skills SDK Trust Decision Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.trust-decision-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/trust-decision-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "recorded", "blocked"]},
    "operation": {"type": "string", "const": "trust_decision"},
    "decision": {"type": "string", "enum": ["trust", "distrust", "revoke"]},
    "reason": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"], "minLength": 1},
    "revoked_package_digest": {"type": ["string", "null"], "minLength": 71},
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 71},
    "manifest_digest": {"type": "string", "minLength": 71},
    "package_digest": {"type": "string", "minLength": 71},
    "ledger_path": {"type": "string", "minLength": 1},
    "ledger_before_digest": {"type": ["string", "null"], "minLength": 71},
    "ledger_after_digest": {"type": ["string", "null"], "minLength": 71},
    "ledger_entry": {"type": ["object", "null"], "additionalProperties": false, "properties": {
      "schema_version": {"type": "string", "const": "skills-sdk.trust-decision-receipt.v0"},
      "recorded_at": {"type": "string", "minLength": 1},
      "package_id_digest": {"type": "string", "minLength": 71},
      "version_digest": {"type": "string", "minLength": 71},
      "package_digest_digest": {"type": "string", "minLength": 71},
      "decision": {"type": "string", "enum": ["trust", "distrust", "revoke"]},
      "reason_digest": {"type": "string", "minLength": 71},
      "owner_digest": {"type": "string", "minLength": 71},
      "expires_at_digest": {"type": ["string", "null"], "minLength": 71},
      "revoked_package_digest_digest": {"type": ["string", "null"], "minLength": 71}
    }, "required": ["schema_version", "recorded_at", "package_id_digest", "version_digest", "package_digest_digest", "decision", "reason_digest", "owner_digest", "expires_at_digest", "revoked_package_digest_digest"]},
    "ledger_entry_digest": {"type": ["string", "null"], "minLength": 71},
    "trust_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/trustCheck"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/trustCheck"}},
    "warnings": {"type": "array", "items": {"$ref": "#/definitions/trustCheck"}},
    "mutation_performed": {"type": "boolean"},
    "trust_store_mutated": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "SEC-001", "VP-025"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "decision",
    "reason",
    "owner",
    "expires_at",
    "revoked_package_digest",
    "package_id",
    "version",
    "source_digest",
    "manifest_digest",
    "package_digest",
    "ledger_path",
    "ledger_before_digest",
    "ledger_after_digest",
    "ledger_entry",
    "ledger_entry_digest",
    "trust_checks",
    "blockers",
    "warnings",
    "mutation_performed",
    "trust_store_mutated",
    "acceptance_trace",
    "agent_summary"
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "recorded"}}, "required": ["status"]},
      "then": {"properties": {"mutation_performed": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["preview", "blocked"]}}, "required": ["status"]},
      "then": {"properties": {"mutation_performed": {"const": false}}}
    }
  ],
  "definitions": {
    "trustCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "warning", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "warning", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
