{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/capability-status.v1.schema.json",
  "title": "Skills SDK Capability Status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.capability-status.v1"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/capability-status.v1.schema.json"},
    "status": {"type": "string", "enum": ["truth_surface"]},
    "generated_from": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/capability"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "by_status": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "feature_executed_count": {"type": "integer", "minimum": 0},
        "mutation_performed_count": {"type": "integer", "minimum": 0}
      },
      "required": ["total", "by_status", "feature_executed_count", "mutation_performed_count"]
    },
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "generated_from",
    "capabilities",
    "summary",
    "source_artifacts",
    "validation_commands",
    "agent_summary"
  ],
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "preview_only",
            "placeholder_optional",
            "placeholder_blocked",
            "blocked_missing_adapter",
            "deferred",
            "out_of_scope"
          ]
        },
        "owner_surface": {"type": "string", "minLength": 1},
        "pipeline_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "feature_executed": {"type": "boolean"},
        "mutation_performed": {"type": "boolean"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "next_slice": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      },
      "required": [
        "id",
        "title",
        "status",
        "owner_surface",
        "pipeline_sections",
        "feature_executed",
        "mutation_performed",
        "evidence_refs",
        "next_slice",
        "notes"
      ]
    }
  }
}
