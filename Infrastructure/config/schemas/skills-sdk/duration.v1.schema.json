{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/duration.v1.schema.json",
  "title": "Skills SDK duration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "unit"],
  "properties": {
    "value": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "enum": ["ms", "s", "min", "h"]
    }
  }
}
