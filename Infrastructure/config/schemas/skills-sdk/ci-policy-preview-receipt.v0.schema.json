{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/ci-policy-preview-receipt.v0.schema.json",
  "title": "Skills SDK CI Policy Preview Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.ci-policy-preview-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/ci-policy-preview-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "blocked"]},
    "operation": {"type": "string", "const": "ci_policy_preview"},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high", "privileged", "published"]},
    "required_checks": {"type": "array", "items": {"$ref": "#/definitions/requiredCheck"}},
    "policy_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/check"}},
    "live_ci_evidence_attached": {"type": "boolean", "const": false},
    "branch_protection_mutated": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["PU-028", "FR-008", "SA-004", "VP-028"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "risk_tier",
    "required_checks",
    "policy_checks",
    "blockers",
    "live_ci_evidence_attached",
    "branch_protection_mutated",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "const": true},
        "source": {"type": "string", "enum": ["base", "risk_tier"]}
      },
      "required": ["name", "required", "source"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "const": "blocker"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
