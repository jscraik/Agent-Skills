{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/package-digest-receipt.v0.schema.json",
  "title": "Skills SDK Package Digest Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.package-digest-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/package-digest-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["built", "blocked"]},
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 71},
    "manifest_digest": {"type": "string", "minLength": 71},
    "package_digest": {"type": "string", "minLength": 71},
    "manifest": {"$ref": "package-manifest.v0.schema.json"},
    "included_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "excluded_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "VP-021", "VP-022"]}}
  },
  "required": ["schema_version", "schema_uri", "status", "package_id", "version", "source_digest", "manifest_digest", "package_digest", "manifest", "included_files", "excluded_files", "mutation_performed", "acceptance_trace"]
}
