{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/risk-classification.v1.schema.json",
  "title": "Skills SDK Risk Classification v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.risk-classification.v1"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/risk-classification.v1.schema.json"},
    "source_kind": {"type": "string", "enum": ["docs_only", "referenced", "scripted", "external", "placeholder"]},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high", "privileged", "published"]},
    "probability": {"$ref": "#/definitions/risk_dimension"},
    "impact": {"$ref": "#/definitions/risk_dimension"},
    "detectability": {"$ref": "#/definitions/risk_dimension"},
    "cost": {"type": "string", "enum": ["low", "medium", "high"]},
    "blocking_behavior": {"type": "string", "enum": ["block", "warn", "advisory", "skip_optional"]},
    "receipt_required": {"type": "boolean"},
    "sensor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "NFR-004", "SA-005", "VP-021"]}}
  },
  "required": ["schema_version", "schema_uri", "source_kind", "risk_tier", "probability", "impact", "detectability", "cost", "blocking_behavior", "receipt_required", "sensor_ids", "acceptance_trace"],
  "definitions": {"risk_dimension": {"type": "string", "enum": ["low", "medium", "high", "unknown"]}}
}
