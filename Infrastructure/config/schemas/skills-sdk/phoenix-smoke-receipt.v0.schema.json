{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/phoenix-smoke-receipt.v0.schema.json",
  "title": "Skills SDK Phoenix Smoke Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.phoenix-smoke-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/phoenix-smoke-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "operation": {"type": "string", "const": "phoenix_smoke_trace"},
    "base_url": {"type": "string", "minLength": 1},
    "otlp_http_endpoint": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "const": "agent-skills-skills-sdk-evals"},
    "span_name": {"type": "string", "minLength": 1},
    "span_kind": {"type": "string", "enum": ["LLM", "WORKFLOW"]},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "profile": {"type": "string", "enum": ["oss-local", "oss-cloud"]},
    "model_name": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "prompt_tokens": {"type": "integer", "minimum": 0},
    "completion_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "command_name": {"type": ["string", "null"]},
    "command_status": {"type": ["string", "null"]},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "otel_python_path": {"type": ["string", "null"]},
    "timestamp_unix_seconds": {"type": "integer", "minimum": 0},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "mutation_performed": {"type": "boolean"},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "base_url",
    "otlp_http_endpoint",
    "project_name",
    "span_name",
    "span_kind",
    "trace_id",
    "span_id",
    "profile",
    "model_name",
    "provider",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "command_name",
    "command_status",
    "latency_ms",
    "otel_python_path",
    "timestamp_unix_seconds",
    "checks",
    "blockers",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
