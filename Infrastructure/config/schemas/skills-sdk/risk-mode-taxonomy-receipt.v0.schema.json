{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/risk-mode-taxonomy-receipt.v0.schema.json",
  "title": "Skills SDK Risk Mode Taxonomy Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.risk-mode-taxonomy-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/risk-mode-taxonomy-receipt.v0.schema.json"},
    "status": {"type": "string", "const": "pass"},
    "operation": {"type": "string", "const": "risk_mode_taxonomy_preview"},
    "query": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_kind": {"type": "string", "enum": ["docs_only", "referenced", "scripted", "external", "placeholder"]},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high", "privileged", "published"]},
    "primary_mode": {
      "type": "string",
      "enum": [
        "malicious_supply_chain",
        "negligent_instruction",
        "vulnerable_operation",
        "unknown_insufficient_evidence",
        "none_detected"
      ]
    },
    "detected_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/risk_mode_id"}
    },
    "mode_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/mode_result"}
    },
    "taxonomy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_performed": {"type": "boolean", "const": false},
    "scanner_execution_performed": {"type": "boolean", "const": false},
    "network_accessed": {"type": "boolean", "const": false},
    "credentials_accessed": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["PU-033", "FR-008", "SA-004", "SEC-001", "VP-033"]}
    },
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "query",
    "package_id",
    "package_digest",
    "source_digest",
    "source_kind",
    "risk_tier",
    "primary_mode",
    "detected_modes",
    "mode_results",
    "taxonomy_digest",
    "execution_performed",
    "scanner_execution_performed",
    "network_accessed",
    "credentials_accessed",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "risk_mode_id": {
      "type": "string",
      "enum": [
        "malicious_supply_chain",
        "negligent_instruction",
        "vulnerable_operation",
        "unknown_insufficient_evidence"
      ]
    },
    "mode_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"$ref": "#/definitions/risk_mode_id"},
        "label": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["detected", "not_detected"]},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "description": {"type": "string", "minLength": 1},
        "indicators": {
          "type": "array",
          "items": {"$ref": "#/definitions/indicator"}
        }
      },
      "required": ["mode", "label", "status", "severity", "description", "indicators"]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["id", "evidence_ref", "reason"]
    }
  }
}
