{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/refs-placeholder.v1.schema.json",
  "title": "JSC-391 Refs Placeholder Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "jsc-391-refs-placeholder.v1"
    },
    "module": {
      "type": "string",
      "const": "refs"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_run",
        "skipped_optional",
        "blocked"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "quality_status": {
      "type": "string"
    },
    "network_fetch_performed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "module",
    "status",
    "rationale"
  ]
}
