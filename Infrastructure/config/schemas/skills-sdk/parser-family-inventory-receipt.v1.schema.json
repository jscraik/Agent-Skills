{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/parser-family-inventory-receipt.v1.schema.json",
  "title": "Skills SDK Parser Family Inventory Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.parser-family-inventory-receipt.v1"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/parser-family-inventory-receipt.v1.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "operation": {"type": "string", "const": "parser_family_inventory"},
    "source_surface": {"type": "string", "minLength": 1},
    "family_count": {"type": "integer", "minimum": 0},
    "families": {"type": "array", "items": {"$ref": "#/definitions/family"}},
    "checks": {"type": "array", "items": {"$ref": "#/definitions/check"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "command_execution_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-008", "SA-003", "VP-032"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "schema_uri", "status", "operation", "source_surface", "family_count", "families", "checks", "mutation_performed", "command_execution_performed", "acceptance_trace", "agent_summary"],
  "definitions": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      },
      "required": ["path", "symbol"]
    },
    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disposition": {"type": "string", "enum": ["preview_replay", "authority_bound_mutation", "template_requires_concrete_fixture", "explicit_run_receipt"]},
        "requires_concrete_fixture": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["disposition", "requires_concrete_fixture", "reason"]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "registration_owner": {"$ref": "#/definitions/owner"},
        "dispatch_owner": {"$ref": "#/definitions/owner"},
        "disposition": {"type": "string", "enum": ["retained_lifecycle_surface", "compatibility_wrapper", "generated_projection", "deletion_candidate_requires_separate_approval"]},
        "compatibility_examples": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "compatibility_example_source": {"type": ["string", "null"]},
        "receipt_policy": {"$ref": "#/definitions/receipt_policy"},
        "caller_consequence": {"type": "string", "minLength": 1}
      },
      "required": ["id", "registration_owner", "dispatch_owner", "disposition", "compatibility_examples", "compatibility_example_source", "receipt_policy", "caller_consequence"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
