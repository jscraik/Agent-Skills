{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/eval-run-receipt.v0.schema.json",
  "title": "Skills SDK Eval Run Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.eval-run-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/eval-run-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "runner": {"type": "string", "enum": ["deterministic_jsonl_v0", "internal_skill_builder_v0"]},
    "dataset_path": {"type": "string", "minLength": 1},
    "dataset_digest": {"type": "string", "minLength": 71},
    "skill_ir_schema_version": {"type": ["string", "null"]},
    "package_id": {"type": ["string", "null"], "minLength": 1},
    "package_digest": {"type": ["string", "null"], "minLength": 71},
    "target_path": {"type": ["string", "null"]},
    "mode": {"type": ["string", "null"]},
    "case_count": {"type": "integer", "minimum": 0},
    "passed_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "oracle": {"type": "string", "enum": ["exact_match"]},
          "expected": {"type": "string", "minLength": 1},
          "actual": {"type": "string"}
        },
        "required": ["case_id", "status", "oracle", "expected", "actual"]
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "VP-021", "VP-022"]}}
  },
  "required": ["schema_version", "schema_uri", "status", "runner", "dataset_path", "dataset_digest", "skill_ir_schema_version", "target_path", "mode", "case_count", "passed_count", "failed_count", "cases", "blockers", "mutation_performed", "acceptance_trace"]
}
