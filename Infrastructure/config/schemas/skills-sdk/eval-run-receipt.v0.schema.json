{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/eval-run-receipt.v0.schema.json",
  "title": "Skills SDK Eval Run Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.eval-run-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/eval-run-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "runner": {"type": "string", "enum": ["deterministic_jsonl_v0", "internal_skill_builder_v0"]},
    "dataset_path": {"type": "string", "minLength": 1},
    "dataset_digest": {"type": "string", "minLength": 71},
    "skill_ir_schema_version": {"type": ["string", "null"]},
    "package_id": {"type": ["string", "null"], "minLength": 1},
    "package_digest": {"type": ["string", "null"], "minLength": 71},
    "target_path": {"type": ["string", "null"]},
    "mode": {"type": ["string", "null"]},
    "lane": {"type": ["string", "null"]},
    "profile": {"type": ["string", "null"]},
    "case_count": {"type": "integer", "minimum": 0},
    "passed_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "quality_gates": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "enum": ["internal_scorecard"]},
        "scorecard_schema_version": {"type": ["string", "null"]},
        "decision": {"type": ["string", "null"]},
        "passed": {"type": ["boolean", "null"]},
        "promotion_eligible": {"type": ["boolean", "null"]},
        "blocked_cases": {"type": "integer", "minimum": 0},
        "tier1_failures": {"type": "integer", "minimum": 0},
        "tier2_findings": {"type": "integer", "minimum": 0},
        "preflight_warning_count": {"type": "integer", "minimum": 0},
        "readiness_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "expected_signal_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runs": {"type": "integer", "minimum": 0},
            "average": {"type": ["number", "null"]},
            "minimum": {"type": ["number", "null"]},
            "risky_cases": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["runs", "average", "minimum", "risky_cases"]
        },
        "security_dependency_screening_status": {"type": ["string", "null"]},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["pass", "fail"]},
              "expected": {"type": "string", "minLength": 1},
              "actual": {"type": "string"}
            },
            "required": ["id", "status", "expected", "actual"]
          }
        },
        "failed_assertions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["source", "scorecard_schema_version", "decision", "passed", "promotion_eligible", "blocked_cases", "tier1_failures", "tier2_findings", "preflight_warning_count", "readiness_summary", "expected_signal_summary", "security_dependency_screening_status", "assertions", "failed_assertions"]
    },
    "closeout_validation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "string", "const": "skills-sdk.eval-closeout-validation.v1"},
        "status": {"type": "string", "enum": ["pass", "blocked"]},
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/eval_closeout_validation_check"}
        },
        "blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/eval_closeout_validation_check"}
        }
      },
      "required": ["schema_version", "status", "checks", "blockers"]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "oracle": {"type": "string", "enum": ["exact_match", "eval_closeout"]},
          "expected": {"type": "string", "minLength": 1},
          "actual": {"type": "string"}
        },
        "required": ["case_id", "status", "oracle", "expected", "actual"]
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "VP-021", "VP-022"]}}
  },
  "required": ["schema_version", "schema_uri", "status", "runner", "dataset_path", "dataset_digest", "skill_ir_schema_version", "target_path", "mode", "case_count", "passed_count", "failed_count", "cases", "blockers", "mutation_performed", "acceptance_trace"],
  "$defs": {
    "eval_closeout_validation_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "message", "evidence"]
    }
  }
}
