{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/tessl-score-receipt.v0.schema.json",
  "title": "Skills SDK Tessl Score Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.tessl-score-receipt.v0"},
    "schema_uri": {"type": "string"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "blocker_class": {"type": ["string", "null"]},
    "blocker": {"type": ["string", "null"]},
    "skill": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "expected_run_id": {"type": "string"},
    "view_json": {"type": "string", "minLength": 1},
    "tessl_status": {"type": "string"},
    "failure_reason": {"type": ["object", "null"]},
    "memory_derived": {"type": "boolean", "const": false},
    "ready": {"type": "boolean"},
    "score_summary": {"type": ["object", "null"]},
    "readiness_thresholds": {"type": "object"},
    "feedback_loop": {"type": "object"},
    "mutation_performed": {"type": "boolean", "const": false},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "blocker_class",
    "blocker",
    "skill",
    "run_id",
    "view_json",
    "memory_derived",
    "ready",
    "score_summary",
    "readiness_thresholds",
    "feedback_loop",
    "mutation_performed",
    "agent_summary"
  ]
}
