{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/ab-judge-preview-receipt.v0.schema.json",
  "title": "Skills SDK A/B Judge Preview Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.ab-judge-preview-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/ab-judge-preview-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "blocked"]},
    "operation": {"type": "string", "const": "ab_judge_preview"},
    "run_receipt_path": {"type": ["string", "null"], "minLength": 1},
    "run_receipt_digest": {"type": ["string", "null"], "minLength": 71},
    "experiment_id": {"type": ["string", "null"], "minLength": 16, "maxLength": 16},
    "judge_profile": {"oneOf": [{"type": "null"}, {"$ref": "eval-profile-preview-receipt.v0.schema.json#/definitions/judge_profile"}]},
    "rubric_id": {"oneOf": [{"type": "null"}, {"type": "string", "const": "skills-sdk.ab-rubric.v0"}]},
    "rubric_digest": {"type": ["string", "null"], "minLength": 71},
    "comparison_payload": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "string", "const": "skills-sdk.ab-judge-decision.v0"},
        "experiment_id": {"type": "string", "minLength": 16, "maxLength": 16},
        "rubric": {"$ref": "ab-rubric-receipt.v0.schema.json#/definitions/ab_rubric"},
        "rubric_digest": {"type": "string", "minLength": 71},
        "skill_a": {"$ref": "#/definitions/package_identity"},
        "skill_b": {"$ref": "#/definitions/package_identity"},
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "minLength": 71}
          },
          "required": ["path", "digest"]
        },
        "execution_profile": {"type": "string", "minLength": 1},
        "variant_results": {
          "type": "array",
          "items": {"$ref": "#/definitions/sanitized_variant_result"},
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {"variant_label": {"const": "A"}}
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {"variant_label": {"const": "B"}}
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "allowed_winners": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["skill_a", "skill_b", "inconclusive"]}
        }
      },
      "required": [
        "schema_version",
        "experiment_id",
        "rubric",
        "rubric_digest",
        "skill_a",
        "skill_b",
        "fixture",
        "execution_profile",
        "variant_results",
        "allowed_winners"
      ]
    },
    "judge_prompt_digest": {"type": ["string", "null"], "minLength": 71},
    "decision_schema_version": {"type": "string", "const": "skills-sdk.ab-judge-decision.v0"},
    "allowed_winners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["skill_a", "skill_b", "inconclusive"]}
    },
    "calibration_required": {"type": "boolean", "const": true},
    "provider_invoked": {"type": "boolean", "const": false},
    "network_accessed": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "VP-021", "VP-022", "VP-030"]}
    },
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "preview"}}},
      "then": {
        "properties": {
          "run_receipt_path": {"type": "string"},
          "run_receipt_digest": {"type": "string"},
          "experiment_id": {"type": "string"},
          "judge_profile": {"$ref": "eval-profile-preview-receipt.v0.schema.json#/definitions/judge_profile"},
          "rubric_id": {"type": "string"},
          "rubric_digest": {"type": "string"},
          "comparison_payload": {"type": "object"},
          "judge_prompt_digest": {"type": "string"},
          "blockers": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"properties": {"blockers": {"type": "array", "minItems": 1}}}
    }
  ],
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "run_receipt_path",
    "run_receipt_digest",
    "experiment_id",
    "judge_profile",
    "rubric_id",
    "rubric_digest",
    "comparison_payload",
    "judge_prompt_digest",
    "decision_schema_version",
    "allowed_winners",
    "calibration_required",
    "provider_invoked",
    "network_accessed",
    "mutation_performed",
    "blockers",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_digest": {"type": "string", "minLength": 71}
      },
      "required": ["package_id", "package_digest"]
    },
    "sanitized_variant_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant_label": {"type": "string", "enum": ["A", "B"]},
        "status": {"type": "string", "enum": ["pass", "blocked"]},
        "exit_code": {"type": "integer"},
        "sandbox_mode": {"type": "string", "enum": ["read-only", "workspace-write"]},
        "output_last_message_digest": {"type": "string", "minLength": 71},
        "runner_stdout_digest": {"type": "string", "minLength": 71},
        "runner_stderr_digest": {"type": "string", "minLength": 71},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": [
        "variant_label",
        "status",
        "exit_code",
        "sandbox_mode",
        "output_last_message_digest",
        "runner_stdout_digest",
        "runner_stderr_digest",
        "blockers"
      ]
    }
  }
}
