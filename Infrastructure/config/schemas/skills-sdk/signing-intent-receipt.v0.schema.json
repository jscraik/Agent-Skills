{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/signing-intent-receipt.v0.schema.json",
  "title": "Skills SDK Signing Intent Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.signing-intent-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/signing-intent-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["ready", "blocked"]},
    "policy_path": {"type": "string", "minLength": 1},
    "policy_digest": {"type": ["string", "null"], "minLength": 71},
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 71},
    "manifest_digest": {"type": "string", "minLength": 71},
    "package_digest": {"type": "string", "minLength": 71},
    "signing_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/signingCheck"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/signingCheck"}},
    "warnings": {"type": "array", "items": {"$ref": "#/definitions/signingCheck"}},
    "signature_requested": {"type": "boolean", "const": false},
    "signing_performed": {"type": "boolean", "const": false},
    "key_material_accessed": {"type": "boolean", "const": false},
    "artifact_emitted": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["FR-003", "FR-008", "SA-003", "SA-004", "SEC-001", "VP-021"]}
    },
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "policy_path",
    "policy_digest",
    "package_id",
    "version",
    "source_digest",
    "manifest_digest",
    "package_digest",
    "signing_checks",
    "blockers",
    "warnings",
    "signature_requested",
    "signing_performed",
    "key_material_accessed",
    "artifact_emitted",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "signingCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "warning", "blocker"]},
        "severity": {"type": "string", "enum": ["info", "warning", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
