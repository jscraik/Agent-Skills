{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/package-security-signature-receipt.v0.schema.json",
  "title": "Skills SDK Package Security Signature Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.package-security-signature-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/package-security-signature-receipt.v0.schema.json"},
    "status": {"type": "string", "const": "pass"},
    "operation": {"type": "string", "const": "package_security_signature_preview"},
    "query": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "package_security_signature_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inspected_file_count": {"type": "integer", "minimum": 1},
    "text_file_count": {"type": "integer", "minimum": 0},
    "script_file_count": {"type": "integer", "minimum": 0},
    "resource_file_count": {"type": "integer", "minimum": 0},
    "binary_file_count": {"type": "integer", "minimum": 0},
    "redaction_performed": {"type": "boolean", "const": true},
    "redacted_content_emitted": {"type": "boolean", "const": false},
    "binary_content_embedded": {"type": "boolean", "const": false},
    "indicator_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "indicators": {"type": "array", "items": {"$ref": "#/definitions/indicator"}},
    "file_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/file_result"}},
    "execution_performed": {"type": "boolean", "const": false},
    "scanner_execution_performed": {"type": "boolean", "const": false},
    "network_accessed": {"type": "boolean", "const": false},
    "credentials_accessed": {"type": "boolean", "const": false},
    "mutation_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["PU-033", "FR-008", "SA-004", "SEC-001", "VP-033"]}
    },
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "query",
    "package_id",
    "package_digest",
    "source_digest",
    "package_security_signature_digest",
    "inspected_file_count",
    "text_file_count",
    "script_file_count",
    "resource_file_count",
    "binary_file_count",
    "redaction_performed",
    "redacted_content_emitted",
    "binary_content_embedded",
    "indicator_summary",
    "indicators",
    "file_results",
    "execution_performed",
    "scanner_execution_performed",
    "network_accessed",
    "credentials_accessed",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["id", "evidence_ref", "reason"]
    },
    "file_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["skill_md", "script", "resource", "binary"]},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "indicators": {"type": "array", "items": {"$ref": "#/definitions/indicator"}}
      },
      "required": ["path", "kind", "sha256", "size_bytes", "indicators"]
    }
  }
}
