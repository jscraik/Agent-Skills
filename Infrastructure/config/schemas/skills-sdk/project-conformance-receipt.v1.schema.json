{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-skills.local/schemas/skills-sdk/project-conformance-receipt.v1.schema.json",
  "title": "Skills SDK project conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "command",
    "mode",
    "status",
    "project_root",
    "project_root_identity",
    "project_managed",
    "lockfile_path",
    "lockfile_status",
    "installed_skill_count",
    "installed_skills",
    "rollback_ready_count",
    "uninstall_ready_count",
    "issues",
    "manual_actions",
    "mutation_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "skills-sdk.project-conformance-receipt.v1"
    },
    "schema_uri": {
      "const": "https://agent-skills.local/schemas/skills-sdk/project-conformance-receipt.v1.schema.json"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["status", "doctor"]
    },
    "status": {
      "enum": ["pass", "warn", "fail", "blocked"]
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "project_root_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_kind", "realpath"],
      "properties": {
        "identity_kind": {
          "enum": ["realpath", "unresolved"]
        },
        "realpath": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "project_managed": {
      "type": "boolean"
    },
    "lockfile_path": {
      "type": ["string", "null"]
    },
    "lockfile_status": {
      "enum": ["not_checked", "missing", "empty_not_installed", "missing_with_installed_evidence", "valid", "valid_with_diagnostics", "invalid", "unsupported"]
    },
    "installed_skill_count": {
      "type": "integer",
      "minimum": 0
    },
    "installed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "target_path",
          "receipt_ref",
          "receipt_status",
          "status",
          "rollback_ready",
          "uninstall_ready",
          "issue_codes"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "receipt_status": {
            "enum": ["valid", "missing", "invalid"]
          },
          "status": {
            "enum": ["healthy", "blocked"]
          },
          "rollback_ready": {
            "type": "boolean"
          },
          "uninstall_ready": {
            "type": "boolean"
          },
          "issue_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rollback_ready_count": {
      "type": "integer",
      "minimum": 0
    },
    "uninstall_ready_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "path", "skill_id"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["info", "warning", "blocker"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "skill_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "manual_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason", "path", "skill_id"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "skill_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "mutation_performed": {
      "const": false
    },
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
