{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skills-sdk/check-receipt.v1.schema.json",
  "title": "Skills SDK Check Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.check-receipt.v1"},
    "schema_uri": {"type": "string", "const": "https://agent-skills.local/schemas/skills-sdk/check-receipt.v1.schema.json"},
    "command": {"type": "string", "minLength": 1},
    "command_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pass", "warning", "blocked", "degraded", "quarantined", "not_run", "skipped_optional"]},
    "failure_class": {"type": "string", "enum": ["none", "manifest_invalid", "receipt_invalid", "risk_classifier_unavailable", "preview_would_write", "placeholder_not_available", "permission_denied", "tool_missing", "external_source_untrusted", "validation_failed"]},
    "exit_code": {"type": "integer", "minimum": 0},
    "work_mode": {"type": "string", "enum": ["computational", "inferential", "hybrid"]},
    "proof": {"type": "object", "additionalProperties": false, "properties": {"type": {"type": "string", "enum": ["schema_validation", "fixture_test", "command_output", "no_write_assertion", "placeholder_state"]}, "evidence_kind": {"type": "string", "enum": ["json_schema", "pytest", "receipt", "artifact", "manual_waiver"]}, "evidence_ref": {"type": "string", "minLength": 1}}, "required": ["type", "evidence_kind", "evidence_ref"]},
    "sensor": {"$ref": "#/definitions/sensor"},
    "actor": {"type": "object", "additionalProperties": false, "properties": {"role": {"type": "string", "enum": ["agent", "human", "ci", "system"]}}, "required": ["role"]},
    "approval_decision": {"type": "string", "enum": ["not_required", "approved", "denied", "waived", "pending"]},
    "redaction": {"type": "string", "enum": ["none", "redacted", "not_applicable"]},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FR-008", "FR-009", "SA-004", "SA-005", "VP-002", "VP-011", "VP-021"]}}
  },
  "required": ["schema_version", "schema_uri", "command", "command_version", "status", "failure_class", "exit_code", "work_mode", "proof", "sensor", "actor", "approval_decision", "redaction", "acceptance_trace"],
  "definitions": {
    "sensor": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "placement": {"type": "string", "enum": ["preflight", "schema", "risk", "preview", "placeholder", "closeout"]}, "required": {"type": "boolean"}}, "required": ["id", "placement", "required"]}
  }
}
