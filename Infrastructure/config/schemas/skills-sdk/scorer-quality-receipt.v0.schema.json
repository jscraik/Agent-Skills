{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/scorer-quality-receipt.v0.schema.json",
  "title": "Skills SDK Scorer Quality Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.scorer-quality-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/scorer-quality-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["preview", "blocked"]},
    "operation": {"type": "string", "const": "scorer_quality_preview"},
    "query": {"type": "string", "minLength": 1},
    "skill_path": {"type": "string", "minLength": 1},
    "evals_path": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "quality_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/check"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/blocker_check"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "promotion_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["Braintrust scorer validation", "PU-030", "VP-030"]}},
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "query",
    "skill_path",
    "evals_path",
    "ready",
    "quality_checks",
    "blockers",
    "mutation_performed",
    "promotion_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "blocker"]},
        "severity": {"type": "string", "const": "blocker"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    },
    "blocker_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "const": "blocker"},
        "severity": {"type": "string", "const": "blocker"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "status", "severity", "message", "evidence"]
    }
  }
}
