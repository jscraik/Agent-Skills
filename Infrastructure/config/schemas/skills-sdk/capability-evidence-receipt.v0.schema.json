{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skills-sdk/capability-evidence-receipt.v0.schema.json",
  "title": "Skills SDK Capability Evidence Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "skills-sdk.capability-evidence-receipt.v0"},
    "schema_uri": {"type": "string", "const": "https://jscraik.local/agent-skills/schemas/skills-sdk/capability-evidence-receipt.v0.schema.json"},
    "status": {"type": "string", "enum": ["pass", "blocked"]},
    "operation": {"type": "string", "const": "capability_evidence_verify"},
    "scope": {"type": "string", "const": "capability-matrix"},
    "matrix_path": {"type": "string", "const": "Infrastructure/config/skills-sdk/capability-matrix.v1.json"},
    "capability_count": {"type": "integer", "minimum": 0},
    "evidence_ref_count": {"type": "integer", "minimum": 0},
    "pass_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "not_run_count": {"type": "integer", "minimum": 0},
    "unknown_count": {"type": "integer", "minimum": 0},
    "evidence_rows": {"type": "array", "items": {"$ref": "#/definitions/evidenceRow"}},
    "blockers": {"type": "array", "items": {"$ref": "#/definitions/evidenceRow"}},
    "mutation_performed": {"type": "boolean", "const": false},
    "command_execution_performed": {"type": "boolean", "const": false},
    "acceptance_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["PU-032", "FR-008", "SA-003", "VP-032"]}
    },
    "agent_summary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "operation",
    "scope",
    "matrix_path",
    "capability_count",
    "evidence_ref_count",
    "pass_count",
    "blocked_count",
    "not_run_count",
    "unknown_count",
    "evidence_rows",
    "blockers",
    "mutation_performed",
    "command_execution_performed",
    "acceptance_trace",
    "agent_summary"
  ],
  "definitions": {
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["file", "command", "schema", "receipt", "external_lane", "unknown"]},
        "status": {"type": "string", "enum": ["pass", "blocked", "not_run", "unknown"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "lane": {"type": "string", "enum": ["local", "local_command", "external"]},
        "executes_command": {"type": "boolean"}
      },
      "required": ["capability_id", "ref", "kind", "status", "reason", "evidence", "lane", "executes_command"]
    }
  }
}
