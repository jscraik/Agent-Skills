{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-skills.local/schemas/skillflow.v1.schema.json",
  "title": "Skillflow v1",
  "description": "Optional deterministic workflow graph for the parts of a skill that should not improvise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "inputs", "outputs", "nodes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "skillflow.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "$ref": "#/definitions/typedFields"
    },
    "outputs": {
      "$ref": "#/definitions/typedFields"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "typedFields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "object", "array"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["command", "llm", "router", "validator", "human_gate", "subflow"]
        },
        "out": {
          "type": "string",
          "minLength": 1
        },
        "side_effect": {
          "type": "boolean"
        }
      }
    }
  }
}
