{
  "schema_version": "skills-sdk.sandbox-profile.v0",
  "schema_uri": "https://agent-skills.local/schemas/skills-sdk/sandbox-profile.v0.schema.json",
  "profile_id": "unsafe-profile",
  "risk_tier": "high",
  "default_policy": "allow",
