    "inherit": true,
    "allowed": ["*"]
  },
  "commands": {
    "shell_allowed": true,
    "allow": []
  },
  "execution": {
    "provider": "local",
    "adapter": "unapproved-local"
  },
  "acceptance_trace": ["FR-008", "FR-010", "SA-004", "SA-007", "SEC-001", "VP-021"]
}
