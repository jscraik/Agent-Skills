{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "CONTRACT_MISSING",
              "name": "CONTRACT_MISSING",
              "shortDescription": {
                "text": "Missing Infrastructure/references/contract.yaml (required for gold)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "EVALS_MISSING",
              "name": "EVALS_MISSING",
              "shortDescription": {
                "text": "Missing Infrastructure/references/evals.yaml (required for gold)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "FM_DESC_WHAT_WHEN",
              "name": "FM_DESC_WHAT_WHEN",
              "shortDescription": {
                "text": "Description MUST include WHAT the skill does and WHEN to use it (trigger contexts)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SAFE_REDACTION_REQUIRED",
              "name": "SAFE_REDACTION_REQUIRED",
              "shortDescription": {
                "text": "Constraints/Safety MUST mention redaction of secrets/sensitive data by default."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_ANTIPATTERNS_MISSING",
              "name": "SEC_ANTIPATTERNS_MISSING",
              "shortDescription": {
                "text": "Missing required section: antipatterns (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_CONSTRAINTS_MISSING",
              "name": "SEC_CONSTRAINTS_MISSING",
              "shortDescription": {
                "text": "Missing required section: constraints (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_PHILOSOPHY_MISSING",
              "name": "SEC_PHILOSOPHY_MISSING",
              "shortDescription": {
                "text": "Missing required section: philosophy (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_VALIDATION_MISSING",
              "name": "SEC_VALIDATION_MISSING",
              "shortDescription": {
                "text": "Missing required section: validation (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "FM_DESC_SHORT",
              "name": "FM_DESC_SHORT",
              "shortDescription": {
                "text": "Description is brief (< 120); expand for better discovery."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "OUT_SCHEMA_VERSION_MISSING",
              "name": "OUT_SCHEMA_VERSION_MISSING",
              "shortDescription": {
                "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EXAMPLES_MISSING",
              "name": "SEC_EXAMPLES_MISSING",
              "shortDescription": {
                "text": "Missing recommended section: examples (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "results": [
        {
          "ruleId": "CONTRACT_MISSING",
          "level": "error",
          "message": {
            "text": "Missing Infrastructure/references/contract.yaml (required for gold)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/project-brain/SKILL.md"
                }
