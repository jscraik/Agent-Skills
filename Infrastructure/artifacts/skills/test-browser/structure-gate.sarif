{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "CONTRACT_MISSING",
              "name": "CONTRACT_MISSING",
              "shortDescription": {
                "text": "Missing Infrastructure/references/contract.yaml (required for gold)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "EVALS_MISSING",
              "name": "EVALS_MISSING",
              "shortDescription": {
                "text": "Missing Infrastructure/references/evals.yaml (required for gold)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SAFE_REDACTION_REQUIRED",
              "name": "SAFE_REDACTION_REQUIRED",
              "shortDescription": {
                "text": "Constraints/Safety MUST mention redaction of secrets/sensitive data by default."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_CONSTRAINTS_MISSING",
              "name": "SEC_CONSTRAINTS_MISSING",
              "shortDescription": {
                "text": "Missing required section: constraints (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EXAMPLES_MISSING",
              "name": "SEC_EXAMPLES_MISSING",
              "shortDescription": {
                "text": "Missing recommended section: examples (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "WF_FAIL_FAST_MISSING",
              "name": "WF_FAIL_FAST_MISSING",
              "shortDescription": {
                "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "results": [
        {
          "ruleId": "CONTRACT_MISSING",
          "level": "error",
          "message": {
            "text": "Missing Infrastructure/references/contract.yaml (required for gold)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "EVALS_MISSING",
          "level": "error",
          "message": {
            "text": "Missing Infrastructure/references/evals.yaml (required for gold)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_REDACTION_REQUIRED",
          "level": "error",
          "message": {
            "text": "Constraints/Safety MUST mention redaction of secrets/sensitive data by default."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_CONSTRAINTS_MISSING",
          "level": "error",
          "message": {
            "text": "Missing required section: constraints (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EXAMPLES_MISSING",
          "level": "warning",
          "message": {
            "text": "Missing recommended section: examples (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "WF_FAIL_FAST_MISSING",
          "level": "warning",
          "message": {
            "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/test-browser/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
