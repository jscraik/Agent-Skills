          "level": "warning",
          "message": {
            "text": "[high] Potential prompt-injection override language detected; ensure this is not instructing the model to bypass system/developer instructions. | scripts/audit_codex_home.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/codex-home-audit/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_TOOL_CHAIN",
          "level": "warning",
          "message": {
            "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior. | SKILL.md"
          },
          "locations": [
            {
