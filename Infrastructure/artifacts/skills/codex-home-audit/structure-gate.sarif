          "level": "warning",
          "message": {
            "text": "[medium] Command-like instructions detected; ensure commands are gated and safe. | scripts/audit_codex_home.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/codex-home-audit/SKILL.md"
                }
              }
            }
          ]
        },
        {
