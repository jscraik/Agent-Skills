{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_COMMANDS",
              "name": "PI_COMMANDS",
              "shortDescription": {
                "text": "[medium] Command-like instructions detected; ensure commands are gated and safe."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_OVERRIDE",
              "name": "PI_OVERRIDE",
              "shortDescription": {
                "text": "[high] Potential prompt-injection override language detected; ensure this is not instructing the model to bypass system/developer instructions."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_TOOL_CHAIN",
              "name": "PI_TOOL_CHAIN",
              "shortDescription": {
                "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "REPO_ASSETS_UNREFERENCED",
              "name": "REPO_ASSETS_UNREFERENCED",
              "shortDescription": {
                "text": "assets/ exists but is not referenced in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_SCOPE_OVERBUNDLED",
              "name": "RESEARCH_SCOPE_OVERBUNDLED",
              "shortDescription": {
                "text": "Skill/package scope looks broad across many surfaces without explicit narrowing guidance. Prefer the smallest viable package boundary first."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_ALLOWLIST",
              "name": "SAFE_NETWORK_ALLOWLIST",
              "shortDescription": {
                "text": "Network usage detected in scripts without an explicit domain/host allowlist policy in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_UNDECLARED",
              "name": "SAFE_NETWORK_UNDECLARED",
              "shortDescription": {
                "text": "Network usage detected in scripts but SKILL.md does not explicitly describe network requirements/constraints. Default to offline; gate behind --allow-network if needed."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_NEGATIVE_MISSING",
              "name": "SEC_EVALS_NEGATIVE_MISSING",
              "shortDescription": {
                "text": "No negative/non-trigger security case detected in evals.yaml. Add `category: negative` or `should_trigger: false` coverage."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PRESSURE_MISSING",
              "name": "SEC_EVALS_PRESSURE_MISSING",
              "shortDescription": {
                "text": "No pressure/adversarial case detected in evals.yaml. Add at least one `category: pressure` case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/codex-home-audit/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
