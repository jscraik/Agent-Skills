{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "OUT_SCHEMA_VERSION_MISSING",
              "name": "OUT_SCHEMA_VERSION_MISSING",
              "shortDescription": {
                "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "OUT_SCHEMA_VERSION_MISSING",
          "level": "warning",
          "message": {
            "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/fix-mise/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/fix-mise/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/fix-mise/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/fix-mise/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
