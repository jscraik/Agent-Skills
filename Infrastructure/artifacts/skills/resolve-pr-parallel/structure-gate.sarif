{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "SEC_ANTIPATTERNS_MISSING",
              "name": "SEC_ANTIPATTERNS_MISSING",
              "shortDescription": {
                "text": "Missing required section: antipatterns (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_PHILOSOPHY_MISSING",
              "name": "SEC_PHILOSOPHY_MISSING",
              "shortDescription": {
                "text": "Missing required section: philosophy (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_LEAKY",
              "name": "RESEARCH_EVALS_LEAKY",
              "shortDescription": {
                "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "results": [
        {
          "ruleId": "SEC_ANTIPATTERNS_MISSING",
          "level": "error",
          "message": {
            "text": "Missing required section: antipatterns (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_PHILOSOPHY_MISSING",
          "level": "error",
          "message": {
            "text": "Missing required section: philosophy (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_LEAKY",
          "level": "warning",
          "message": {
            "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior. | leaky=6/8"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=1/8"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/resolve-pr-parallel/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
