{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_COMMANDS",
              "name": "PI_COMMANDS",
              "shortDescription": {
                "text": "[medium] Command-like instructions detected; ensure commands are gated and safe."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_OBFUSCATION",
              "name": "PI_OBFUSCATION",
              "shortDescription": {
                "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_OVERRIDE",
              "name": "PI_OVERRIDE",
              "shortDescription": {
                "text": "[high] Potential prompt-injection override language detected; ensure this is not instructing the model to bypass system/developer instructions."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/frontend-ui/visual-explainer/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/frontend-ui/visual-explainer/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_COMMANDS",
          "level": "warning",
          "message": {
            "text": "[medium] Command-like instructions detected; ensure commands are gated and safe. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/frontend-ui/visual-explainer/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_OBFUSCATION",
          "level": "warning",
          "message": {
            "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks. | references/css-patterns.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/frontend-ui/visual-explainer/SKILL.md"
                }
              }
            }
          ]
        },
        {
