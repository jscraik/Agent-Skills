{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PATH_ABSOLUTE",
              "name": "PATH_ABSOLUTE",
              "shortDescription": {
                "text": "Absolute paths detected; prefer repo-relative paths."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "REPO_SCRIPTS_UNREFERENCED",
              "name": "REPO_SCRIPTS_UNREFERENCED",
              "shortDescription": {
                "text": "Infrastructure/scripts/ exists but is not referenced in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PATH_ABSOLUTE",
          "level": "warning",
          "message": {
            "text": "Absolute paths detected; prefer repo-relative paths."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/biome-linting/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "REPO_SCRIPTS_UNREFERENCED",
          "level": "warning",
          "message": {
            "text": "Infrastructure/scripts/ exists but is not referenced in SKILL.md."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/biome-linting/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/biome-linting/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/biome-linting/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
