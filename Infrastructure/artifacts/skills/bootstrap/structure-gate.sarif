{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PATH_ABSOLUTE",
              "name": "PATH_ABSOLUTE",
              "shortDescription": {
                "text": "Absolute paths detected; prefer repo-relative paths."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_TOOL_CHAIN",
              "name": "PI_TOOL_CHAIN",
              "shortDescription": {
                "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_LEAKY",
              "name": "RESEARCH_EVALS_LEAKY",
              "shortDescription": {
                "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EXAMPLES_MISSING",
              "name": "SEC_EXAMPLES_MISSING",
              "shortDescription": {
                "text": "Missing recommended section: examples (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PATH_ABSOLUTE",
          "level": "warning",
          "message": {
            "text": "Absolute paths detected; prefer repo-relative paths."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-large.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_TOOL_CHAIN",
          "level": "warning",
          "message": {
            "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior. | SKILL.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_LEAKY",
          "level": "warning",
          "message": {
            "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior. | leaky=2/3"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=1/3"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | Infrastructure/references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | Infrastructure/references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EXAMPLES_MISSING",
          "level": "warning",
          "message": {
            "text": "Missing recommended section: examples (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/agent-ops/bootstrap/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
