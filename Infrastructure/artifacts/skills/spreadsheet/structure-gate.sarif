{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "SEC_CONSTRAINTS_MISSING",
              "name": "SEC_CONSTRAINTS_MISSING",
              "shortDescription": {
                "text": "Missing required section: constraints (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "SEC_PHILOSOPHY_MISSING",
              "name": "SEC_PHILOSOPHY_MISSING",
              "shortDescription": {
                "text": "Missing required section: philosophy (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "fail"
              }
            },
            {
              "id": "PI_BINARY_ATTACHMENT",
              "name": "PI_BINARY_ATTACHMENT",
              "shortDescription": {
                "text": "Binary attachment detected; manual review required (prompt scan skipped)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "REPO_ASSETS_UNREFERENCED",
              "name": "REPO_ASSETS_UNREFERENCED",
              "shortDescription": {
                "text": "assets/ exists but is not referenced in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_LEAKY",
              "name": "RESEARCH_EVALS_LEAKY",
              "shortDescription": {
                "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "results": [
        {
          "ruleId": "SEC_CONSTRAINTS_MISSING",
          "level": "error",
          "message": {
            "text": "Missing required section: constraints (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_PHILOSOPHY_MISSING",
          "level": "error",
          "message": {
            "text": "Missing required section: philosophy (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/icon-small.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_BINARY_ATTACHMENT",
          "level": "warning",
          "message": {
            "text": "Binary attachment detected; manual review required (prompt scan skipped). | agents/assets/spreadsheet.png"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "REPO_ASSETS_UNREFERENCED",
          "level": "warning",
          "message": {
            "text": "assets/ exists but is not referenced in SKILL.md."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_LEAKY",
          "level": "warning",
          "message": {
            "text": "Most positive eval prompts mention the skill name directly. Prefer natural user phrasing to test real routing behavior. | leaky=3/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=1/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Skills/content-publishing/spreadsheet/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
