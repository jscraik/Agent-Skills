            result = skills_commands.skills_budget(repo_root, default_max=args.default_max)
        elif args.action in ("capabilities", "capability"): result = skills_commands.skills_capabilities(repo_root, runtime_target=args.runtime_target)
        elif args.action == "codex-preview": result = skills_commands.skills_codex_preview(repo_root)
        elif args.action == "load-preview":
            result = skills_commands.skills_load_preview(repo_root)
        elif args.action == "render-preview":
            result = skills_commands.skills_render_preview(repo_root, context_window=args.context_window)
        elif args.action == "config":
            if args.config_action == "explain":
                result = skills_commands.skills_config_explain(repo_root)
            else:
                result = build_unknown_action_result("skills config", args.config_action)
        elif args.action == "inject-preview":
            result = skills_commands.skills_inject_preview(repo_root, text=" ".join(args.text))
        elif args.action == "implicit-preview":
            result = skills_commands.skills_implicit_preview(repo_root, command=args.command, workdir=args.workdir)
        elif args.action == "handles":
            result = skills_commands.skills_handles(
                repo_root,
                check=args.check,
                include_handles=not args.no_handles,
                write_projection=args.write_projection,
                check_projection=args.check_projection,
                dry_run=args.dry_run,
            )
        elif args.action == "resolve":
            result = skills_commands.skills_resolve(repo_root, handle=args.handle)
        elif args.action == "parse":
            result = skills_commands.skills_parse(repo_root, request_text=" ".join(args.request))
        elif args.action == "proof":
            result = skills_commands.skills_proof(repo_root, handle=args.handle, runtime_target=args.runtime_target)
        elif args.action == "prove":
            result = skills_commands.skills_prove(repo_root, handle=" ".join(args.handle))
        elif args.action == "explain":
            result = skills_commands.explain_skill(repo_root, handle=args.handle)
        elif args.action == "doctor":
            result = skills_commands.skills_doctor(repo_root, target=args.target, strict=args.strict, codex_parity=args.codex_parity)
        elif args.action == "package":
            verify_flags_present = any([args.expected_sha256, args.trusted_provenance, args.rollback_journal])
            package_flags_present = args.strict or args.checkout_test
            if args.target == "verify" and not args.verify_target:
                result = build_argument_error("skills", "package", raw_args, parser_error="the following arguments are required: verify_target")
            elif args.target == "verify" and package_flags_present:
                result = build_argument_error("skills", "package", raw_args, parser_error="unexpected package-only arguments")
            elif args.target != "verify" and (args.verify_target or verify_flags_present):
                result = build_argument_error("skills", "package", raw_args, parser_error="unexpected verify-only arguments")
            elif args.target == "verify":
                result = skills_commands.skills_package_verify(
                    repo_root,
                    target=args.verify_target,
                    expected_sha256=args.expected_sha256,
                    trusted_provenance=args.trusted_provenance,
                    rollback_journal=args.rollback_journal,
                )
            else:
                result = skills_commands.skills_package(repo_root, target=args.target, strict=args.strict, checkout_test=args.checkout_test)
        elif args.action == "conformance":
            if args.conformance_action == "run":
                result = skills_commands.skills_conformance_run(
                    repo_root,
                    suite=args.suite,
                    evidence_dir=args.evidence_dir,
                )
            else:
                result = build_unknown_action_result("skills conformance", args.conformance_action)
        elif args.action == "profiles":
            result = skills_commands.skills_profiles(repo_root, profile=args.profile)
        elif args.action == "events":
            result = skills_commands.skills_events(repo_root, event_type=args.event_type)
        elif args.action == "memory":
            result = skills_commands.skills_memory(
                repo_root,
                mode=args.mode,
                query=args.query,
                limit=args.limit,
                source_id=args.source_id,
            )
        elif args.action == "route":
            result = skills_commands.route_skills(
                repo_root,
                request=" ".join(args.request),
                top_k=args.top_k,
                considered_limit=args.considered_limit,
            )
        elif args.action == "goal":
            result = skills_commands.goal_skills(
                repo_root,
                intent_text=" ".join(args.intent),
                top_k=args.top_k,
                considered_limit=args.considered_limit,
            )
        elif args.action == "improve":
            result = skills_commands.improve_skills(
                repo_root,
                goal_text=" ".join(args.goal),
                top_k=args.top_k,
                considered_limit=args.considered_limit,
            )
        elif args.action == "starter":
            result = skills_commands.list_skills(
                repo_root,
                category=None,
                starter=True,
                archetype=args.archetype,
                limit=args.limit,
            )
        elif args.action == "sync":
            result = skills_commands.sync_skills(repo_root, scope=args.scope, dry_run=args.dry_run, projection=args.projection, plugin_cache_refresh=args.plugin_cache_refresh)
        elif args.action == "audit":
            result = skills_commands.audit_skill(repo_root, skill_path=args.path, level=args.level)
        elif args.action == "external-review":
            result = skills_commands.external_review_skill(repo_root, skill_path=args.path, audit_level=args.audit_level, skip_plugin_eval=args.skip_plugin_eval, skip_tessl=args.skip_tessl, skip_tessl_review=args.skip_tessl_review, include_snyk=args.include_snyk, timeout_seconds=args.timeout_seconds, report_path=args.report_path, dashboard=args.dashboard, dashboard_path=args.dashboard_path)
        elif args.action == "validate-skill-gate":
            result = skills_commands.validate_skill_gate(repo_root, skill_path=args.path)
        elif args.action == "validate-openai-format":
            result = skills_commands.validate_openai_skill_format(repo_root, skill_path=args.path, mode=args.mode)
        elif args.action == "validate-boundaries":
            result = skills_commands.validate_skill_boundaries(repo_root, handle=args.handle)
        elif args.action == "install":
            result = skills_commands.install_skill(repo_root, url=args.url, remediate=args.remediate, dest=args.dest, dry_run=args.dry_run)
        elif args.action == "fold":
            result = skills_commands.fold_skills(repo_root, source=args.source, target=args.target, sensitivity=args.sensitivity)
        elif args.action == "init":
            result = skills_commands.init_skill(repo_root, name=args.name, category=args.category, description=args.description)
        else:
            result = build_unknown_action_result(
                "skills",
                args.action,
            )
    elif args.topic == "reviewers":
        if args.action == "resolve":
            result = skills_commands.reviewers_resolve(repo_root, handle=args.handle)
        else:
            result = build_unknown_action_result(
                "reviewers",
                args.action,
            )
    elif args.topic == "sdk":
        result = dispatch_sdk(repo_root, args)
    elif args.topic == "runtime":
        result = dispatch_runtime(repo_root, args)
    elif args.topic == "plugins":
        if args.action == "list":
            result = list_plugins_state(repo_root)
        elif args.action == "status":
            result = status_plugin_state(repo_root, name=args.name)
        elif args.action == "doctor":
            result = doctor_plugins_state(repo_root)
        elif args.action == "sync-local-runtime":
            result = sync_local_runtime_plugins(repo_root, dry_run=args.dry_run)
        elif args.action == "prune-stale-config":
            result = prune_stale_plugin_config(repo_root, dry_run=args.dry_run, stability_seconds=args.stability_seconds, stability_interval_seconds=args.stability_interval_seconds, verify_stable_when_clean=args.verify_stable_when_clean)
        elif args.action in {"init", "create"}:
            companion = [
                name
                for enabled, name in (
                    (args.with_scripts, "scripts"),
                    (args.with_assets, "assets"),
                    (args.with_references, "references"),
                    (args.with_workflows, "workflows"),
                )
                if enabled
            ]
            result = init_plugin(
                repo_root,
                name=args.name,
                category=args.category,
                with_marketplace=args.with_marketplace,
                companion_folders=companion,
                action=args.action,
            )
        elif args.action in {"install", "import"}:
            result = install_plugin(repo_root, url=args.url, plugin_path=args.path, name=args.name, ref=args.ref, dest=args.dest, validation_level=args.validation_level, allow_untrusted_source=args.allow_untrusted_source, allow_unpinned_ref=args.allow_unpinned_ref, sync_profile=args.sync_profile, require_desktop_loadable=args.require_desktop_loadable, dry_run=args.dry_run, action=args.action)
        elif args.action == "harden":
            result = harden_plugin(repo_root, plugin_path=args.plugin_path, require_marketplace=not args.no_require_marketplace, marketplace_path=args.marketplace_path, run_compat=not args.skip_compat, run_marketplace_audit=not args.skip_marketplace_audit, allow_legacy_marketplace_path=not args.strict_marketplace_path)
        elif args.action == "uninstall":
            result = uninstall_plugin(repo_root, name=args.name, dry_run=args.dry_run)
        else:
            result = build_unknown_action_result("plugins", args.action)
    elif args.topic == "evals":
        if args.action == "run":
            result = run_evals(
                repo_root,
                path=args.path,
                mode=args.mode,
                dashboard=not args.no_dashboard,
                runner=args.runner,
                skip_tessl=args.skip_tessl,
                allow_tessl_project_save=args.allow_tessl_project_save,
                tessl_live_private=args.tessl_live_private,
                tessl_workspace=args.tessl_workspace,
                tessl_live_dry_run=args.tessl_live_dry_run,
                model=args.model,
                cases=args.case,
            )
        elif args.action == "benchmark":
            result = benchmark_portfolio(repo_root)
        elif args.action == "dashboard":
            result = dashboard_report(repo_root)
        elif args.action == "macro-report":
            macro_report_kwargs = {"output_dir": args.output_dir}
            if args.summaries_glob:
                macro_report_kwargs["summaries_glob"] = args.summaries_glob
            result = macro_eval_report(repo_root, **macro_report_kwargs)
        elif args.action == "prepare-tessl-scenarios":
            result = prepare_tessl_scenario_generation(
                repo_root,
                path=args.path,
                workspace=args.tessl_workspace,
                dry_run=args.dry_run,
            )
        else:
            result = build_unknown_action_result(
                "evals",
                args.action,
            )
    elif args.topic == "workouts":
        result = dispatch_workouts(repo_root, args)
    elif args.topic == "graph":
        if args.action == "related":
            result = graph_related(repo_root, skill=args.skill, depth=args.depth,
                                   reverse=args.reverse, topic=args.topic_filter, tier=args.tier)
        elif args.action == "find":
            result = graph_find(repo_root, query=args.query, topic=args.topic_filter, tier=args.tier)
        elif args.action == "info":
            result = graph_info(repo_root, skill=args.skill)
        elif args.action == "chain":
            result = graph_chain(repo_root, from_skill=args.from_skill, to_skill=args.to_skill)
        elif args.action == "list":
            result = graph_list(repo_root, topic=args.topic_filter, tier=args.tier)
        elif args.action == "topics":
            result = graph_topics(repo_root)
        else:
            result = build_unknown_action_result(
                "graph",
                args.action,
            )
    elif args.topic == "mcp":
        if args.action == "sync":
            result = sync_mcp(repo_root, dry_run=args.dry_run)
        else:
            result = build_unknown_action_result(
                "mcp",
                args.action,
            )
    elif args.topic == "memory":
        if args.action == "list":
            result = memory_list(repo_root, source_id=args.source_id, limit=args.limit)
        elif args.action == "read":
            result = memory_read(repo_root, identifier=args.identifier)
        elif args.action == "search":
            result = memory_search(repo_root, query=args.query, source_id=args.source_id, limit=args.limit)
        else:
            result = build_unknown_action_result(
                "memory",
                args.action,
            )
    elif args.topic == "wiki":
        if args.action == "lint":
            result = wiki_lint(repo_root, wiki_root=args.wiki_root, max_age_days=args.max_age_days)
        elif args.action == "ingest":
            result = wiki_ingest(
                repo_root,
                title=args.title,
                sources=args.source or [],
                summary=args.summary,
                tags=args.tag or [],
                dry_run=args.dry_run,
            )
        elif args.action == "add":
            title = args.title
            summary = args.summary
            source = args.source
            intent = args.intent
            status = args.status
            destination = args.destination
            tags = args.tag or []
            if args.interactive:
                if args.json:
                    result.status = "error"
                    result.errors.append(
                        ErrorObject(
                            code=ErrorCode.ERR_VALIDATION,
                            message="--interactive cannot be combined with --json.",
                            fix_suggestion="Use interactive mode without --json or pass all fields explicitly.",
                        )
                    )
                else:
                    print("🧭 Wiki triage questionnaire")
                    title = title or prompt_nonempty("Title: ")
                    summary = summary or prompt_nonempty("Summary: ")
                    source = source or prompt_nonempty("Source: ")
                    intent = intent or prompt_choice(
                        "Intent:",
                        ["finding", "playbook", "design-asset", "lesson-learned"],
                    )
                    status = status or prompt_choice(
                        "Status:",
                        ["needs-verification", "verified", "fix-now"],
                    )
                    destination = destination or prompt_choice(
                        "Destination:",
                        ["failures", "playbooks", "assets/ui", "learnings"],
                    )
            required_missing = []
            if not title:
                required_missing.append("title")
            if not summary:
                required_missing.append("summary")
            if not source:
                required_missing.append("source")
            if not intent:
                required_missing.append("intent")
            if not status:
                required_missing.append("status")
            if result.status != "error" and required_missing:
                result.status = "error"
                validation_parts = ["./bin/ask", "wiki", "add"]
                if title:
                    validation_parts.append(title)
                if summary:
                    validation_parts.extend(["--summary", summary])
                if source:
                    validation_parts.extend(["--source", source])
                if intent:
                    validation_parts.extend(["--intent", intent])
                if status:
                    validation_parts.extend(["--status", status])
                if destination:
                    validation_parts.extend(["--destination", destination])
                for tag in tags:
                    validation_parts.extend(["--tag", tag])
                if args.dry_run:
                    validation_parts.append("--dry-run")
                validation_parts.extend(["--json", "--robot"])
                result.data["validation_commands"] = [replay_command(*validation_parts)]
                result.errors.append(
                    ErrorObject(
                        code=ErrorCode.ERR_VALIDATION,
                        message=f"Missing required fields for wiki add: {', '.join(required_missing)}",
                        fix_suggestion="Use --interactive or pass --summary, --source, --intent, and --status explicitly.",
                    )
                )
            elif result.status != "error":
                result = wiki_add(
                    repo_root,
                    title=title,
                    summary=summary,
                    source=source,
                    intent=intent,
                    status=status,
                    destination=destination,
                    tags=tags,
                    dry_run=args.dry_run,
                )
        elif args.action == "query":
            result = wiki_query(
                repo_root,
                query=args.query,
                wiki_root=args.wiki_root,
                limit=args.limit,
            )
        elif args.action == "add-asset":
            asset_path = args.asset_path
            title = args.title
            summary = args.summary
            source = args.source
            status = args.status
            destination = args.destination
            tags = args.tag or []
            if args.interactive:
                if args.json:
                    result.status = "error"
                    result.errors.append(
                        ErrorObject(
                            code=ErrorCode.ERR_VALIDATION,
                            message="--interactive cannot be combined with --json.",
                            fix_suggestion="Use interactive mode without --json or pass all fields explicitly.",
                        )
                    )
                else:
                    print("🖼️ Wiki asset questionnaire")
                    asset_path = asset_path or prompt_nonempty("Asset path: ")
                    title = title or prompt_nonempty("Title: ")
                    summary = summary or prompt_nonempty("Summary: ")
                    source = source or prompt_optional("Source (optional): ")
                    status = status or prompt_choice(
                        "Status:",
                        ["needs-verification", "verified", "fix-now"],
                    )
                    destination = destination or prompt_choice(
                        "Destination:",
                        ["assets/ui", "learnings"],
                    )
            required_missing = []
            if not asset_path:
                required_missing.append("asset_path")
            if not title:
                required_missing.append("title")
            if not summary:
                required_missing.append("summary")
            status = status or "verified"
            destination = destination or "assets/ui"
            if result.status != "error" and required_missing:
                result.status = "error"
                validation_parts = ["./bin/ask", "wiki", "add-asset"]
                if asset_path:
                    validation_parts.append(asset_path)
                if title:
                    validation_parts.extend(["--title", title])
                if summary:
                    validation_parts.extend(["--summary", summary])
                if source:
                    validation_parts.extend(["--source", source])
                if status:
                    validation_parts.extend(["--status", status])
                if destination:
                    validation_parts.extend(["--destination", destination])
                for tag in tags:
                    validation_parts.extend(["--tag", tag])
                if args.dry_run:
                    validation_parts.append("--dry-run")
                validation_parts.extend(["--json", "--robot"])
                result.data["validation_commands"] = [replay_command(*validation_parts)]
                result.errors.append(
                    ErrorObject(
                        code=ErrorCode.ERR_VALIDATION,
                        message=f"Missing required fields for wiki add-asset: {', '.join(required_missing)}",
                        fix_suggestion="Use --interactive or pass asset_path, --title, and --summary explicitly.",
                    )
                )
            elif result.status != "error":
                result = wiki_add_asset(
                    repo_root,
                    asset_path=asset_path,
                    title=title,
                    summary=summary,
                    source=source,
                    status=status,
                    destination=destination,
                    tags=tags,
                    dry_run=args.dry_run,
                )
        else:
            result = build_unknown_action_result(
                "wiki",
                args.action,
            )
    result.metadata["command"] = " ".join(sys.argv[1:])
    if correction_note:
        result.metadata["correction_note"] = correction_note.replace("\n", " ")
    result.telemetry["latency_ms"] = int((time.time() - start_time) * 1000)
    if args.trace_id:
        result.trace_id = args.trace_id # Ensure it persists if command function replaced result
    if args.json:
        print(result.to_json(repo_root=str(repo_root)))
    else:
        if result.status == "success":
            if args.topic:
                if args.topic == "repo" and args.action == "status":
                    print(f"✅ Success: {result.metadata['command']}")
                    print(f"  Root: {result.data['repo_root']}")
                    print(f"  Synced: {result.data['skills_synced']}")
                    print_first_validation_command(result.data)
                elif args.topic == "repo" and args.action == "validate":
                    print(f"✅ Validation passed! ({result.data['warn_only_issues']} warnings)")
                    if result.data.get("scope") and result.data.get("scope") != "all":
                        print(f"   Scope: {result.data['scope']}")
                    if result.data.get("changed_files"):
                        print(f"   Scoped to {len(result.data['changed_files'])} changed file(s)")
                elif args.topic == "repo" and args.action == "check-stability":
                    print(f"✅ Stability check passed ({result.data['stable_count']} stable skills)")
                    if args.changed_files:
                        print(f"   Checked {result.data['checked_files']} changed file(s)")
                    print_first_validation_command(result.data)
                elif args.topic == "repo" and args.action == "doctor":
                    doctor = result.data.get("doctor", result.data)
                    for line in render_golden_path_summary(
                        doctor,
                        title="Repo doctor",
                        status_icon="✅",
                    ):
                        print(line)
                    signals = doctor.get("signals", {})
                    capability = signals.get("capability_readiness", {}).get("details", {})
                    memory = signals.get("memory_readiness", {}).get("details", {})
                    package = signals.get("package_readiness", {}).get("details", {})
                    if capability:
                        print(
                            "  Capability readiness: "
                            f"{signals.get('capability_readiness', {}).get('state')} "
                            f"({capability.get('profile_contract_gap_count', 0)} profile gaps, "
                            f"{capability.get('event_contract_gap_count', 0)} event gaps)"
                        )
                    if memory:
                        print(
                            "  Memory readiness: "
                            f"{signals.get('memory_readiness', {}).get('state')} "
                            f"({memory.get('entry_count', 0)} entries, "
                            f"{memory.get('provider_model')})"
                        )
                    if package:
                        print(
                            "  Package readiness: "
                            f"{signals.get('package_readiness', {}).get('state')} "
                            f"({package.get('target')}, "
                            f"{package.get('missing_field_count', 0)} missing fields)"
                        )
                elif args.topic == "repo" and args.action == "closeout":
                    closeout = result.data.get("repo_closeout", {})
                    readiness = closeout.get("commit_readiness", {})
                    capability = closeout.get("capability_readiness", {})
                    memory = closeout.get("memory_readiness", {})
                    package = closeout.get("package_readiness", {})
                    runtime_evidence = closeout.get("runtime_evidence", {})
                    focused = closeout.get("focused_validation", [])
                    print(f"Repo closeout: {closeout.get('agent_summary')}")
                    print(f"  Commit ready: {readiness.get('ready')}")
                    print(f"  Capability readiness: {capability.get('status')} ({capability.get('contract_gap_count', 0)} gaps)")
                    blocker_classes = capability.get("eval_blocker_classes") or []
                    if blocker_classes:
                        count = capability.get("eval_blocker_class_count", len(blocker_classes))
                        print(f"  Eval blocker classes: {count} ({', '.join(blocker_classes)})")
                    print(f"  Memory readiness: {memory.get('status')} ({memory.get('entry_count', 0)} entries)")
                    print(f"  Package readiness: {package.get('status')} ({package.get('missing_field_count', 0)} missing fields)")
                    print(f"  Runtime evidence: {runtime_evidence.get('status')} ({runtime_evidence.get('runtime_card_count', 0)} cards)")
                    boundaries = runtime_evidence.get("truth_boundaries") or {}
                    if boundaries:
                        boundary_text = ", ".join(
                            [
                                f"command={boundaries.get('command_proof')}",
                                f"schema={boundaries.get('schema_proof')}",
                                f"PR={boundaries.get('pr_truth')}",
                                f"tracker={boundaries.get('tracker_truth')}",
                                f"docs={boundaries.get('docs_truth')}",
                            ]
                        )
                        print(f"  Runtime evidence boundaries: {boundary_text}")
                    if focused:
                        ids = [item.get("id") for item in focused if item.get("id")]
                        print(f"  Focused validation: {', '.join(ids)}")
                    print(f"  Next: {closeout.get('next_command')}")
                elif args.topic == "repo" and args.action == "doctor-catalog":
                    report = result.data.get("catalog_parity", {})
                    print(f"✅ Catalog parity: {report.get('decision_status', 'resolved')}")
                    print(f"  Canonical count: {report.get('canonical_count')}")
                    print(f"  Policy identity: {report.get('policy_identity')}")
                    for surface in report.get("surfaces", []):
                        print(
                            "  - "
                            f"{surface.get('surface_name')}: "
                            f"{surface.get('observed_count')} / {surface.get('canonical_count')} "
                            f"(parity_ok={surface.get('parity_ok')})"
                        )
                elif args.topic == "repo" and args.action == "provider-audit":
                    report = result.data.get("provider_policy", {})
                    print("✅ Provider policy: "
                          f"{report.get('status')} ({report.get('violation_count', 0)} violation(s))")
                    print_first_validation_command(result.data)
                elif args.topic == "repo" and args.action == "surface":
                    report = result.data.get("repo_surface", {})
                    summary = report.get("summary", {})
                    print(f"✅ Repo surface: {summary.get('total_paths', 0)} tracked path(s), "
                          f"{summary.get('blocking_findings', 0)} blocking finding(s), "
                          f"status={report.get('status')}")
                    print_first_validation_command(result.data)
                elif args.topic == "repo" and args.action == "yaml-inspect":
                    payload = result.data.get("yaml", {})
                    detail = f" query={payload.get('query')} value={payload.get('query_value')!r}" if payload.get("query") else " " + " ".join(f"{name}={payload.get(name)}" for name in ("root_type", "top_level_keys", "item_count") if payload.get(name) is not None)
                    print(f"✅ YAML inspect: {result.data.get('path', payload.get('path', args.path))}{detail}")
                    print_first_validation_command(result.data)
                elif args.topic == "skills" and args.action == "list":
                    print(f"Discovered {len(result.data['skills'])} skills:")
