                if prompts:
                    print("Disambiguation prompts:")
                    for prompt in prompts:
                        print(f"  - {prompt}")
                print_first_validation_command(goal)
                print("")
            error_message = error.message
            if args.topic == "skills" and args.action == "audit" and " First failures:" in error_message:
                error_message = error_message.split(" First failures:", 1)[0]
            print(f"❌ Error: {error_message}")
            if error.fix_suggestion:
                print(f"\n💡 {error.fix_suggestion}")
            if args.topic == "skills":
                if args.action == "audit":
                    family_data = result.data.get("family_benchmarks")
                    if isinstance(family_data, dict) and int(family_data.get("exit_code", 0) or 0) != 0:
                        fail_lines = skills_commands.extract_family_fail_lines(str(family_data.get("stdout", "")))
                        if fail_lines:
                            print("\n🔎 Family benchmark failures (first 3):")
                            for fail in fail_lines[:3]:
                                print(f"   - {fail}")
                            remaining = len(fail_lines) - 3
                            if remaining > 0:
                                print(f"   ... and {remaining} more (use --json for full details)")
                        else:
                            for raw_line in str(family_data.get("stderr", "")).splitlines():
                                line = raw_line.strip()
                                if line:
                                    print("\n🔎 Family benchmark error:")
                                    print(f"   {line}")
                                    break
                    if "diagnostics" in result.data: print(result.data["diagnostics"]["stdout"])
                    if "security_gate" in result.data: print(result.data["security_gate"]["stdout"])
                    print("\n📚 Audit examples:")
                    print("   ask skills audit backend-platform/cli-spec --level compat")
                    print("   ask skills audit backend-platform/cli-spec --level strict")
                    print("   ask skills audit Plugins/skill-factory/skills/code_quality_review/skill-builder --level strict")
                elif args.action in ("install", "fold", "init"):
                    if "raw_output" in result.data: print(result.data["raw_output"])
                    if "raw_error" in result.data: print(result.data["raw_error"])
                    if args.action in {"fold", "init"}:
                        print_first_validation_command(result.data)
                    if args.action == "init":
                            print("\n📚 Init examples:\n   ask skills init my-skill --category frontend-ui --description 'Does X'\n   ask skills init security-guard --category security-ops --description 'Validates Y'")
                    elif args.action == "install":
                            print("\n📚 Install examples:\n   ask skills install https://github.com/user/repo --remediate")
                elif args.topic == "skills":
                    print_first_validation_command(result.data)
            elif args.topic == "plugins" and args.action in (
                "init",
                "create",
                "install",
                "import",
                "harden",
                "sync-local-runtime",
                "prune-stale-config",
                "uninstall",
            ):
                if "raw_output" in result.data: print(result.data["raw_output"])
                if "raw_error" in result.data: print(result.data["raw_error"])
                print_first_validation_command(result.data)
                if "command_runs" in result.data:
                    print("\n🔧 Command execution details:")
                    for run in result.data["command_runs"]:
                        print(f"\n  Step: {run.get('step')}")
                        print(f"  Command: {run.get('command')}")
                        print(f"  Return code: {run.get('returncode')}")
                        if run.get('stdout'):
                            if getattr(args, 'verbose', False):
                                print(f"  Stdout:\n{repr(run.get('stdout'))}")
                            else:
                                print("  (Stdout elided. Use --verbose to view)")
                        if run.get('stderr'):
                            if getattr(args, 'verbose', False):
                                print(f"  Stderr:\n{repr(run.get('stderr'))}")
                            else:
                                print("  (Stderr elided. Use --verbose to view)")
                    print("\n📚 Plugin examples:\n   ask plugins init my-plugin --category third-party --with-marketplace\n   ask plugins install https://github.com/<owner>/<repo> --path Plugins/<name>\n   ask plugins harden Plugins/my-plugin\n   ask plugins sync-local-runtime")
            elif args.topic == "plugins":
                print_first_validation_command(result.data)
            elif args.topic == "reviewers":
                print_first_validation_command(result.data)
            elif args.topic == "evals":
                if "raw_output" in result.data: print(result.data["raw_output"])
                if "raw_error" in result.data: print(result.data["raw_error"])
                print_first_validation_command(result.data)
                print("\n📚 Eval examples:\n   ask evals run backend/cli-spec --mode smoke\n   ask evals run backend/cli-spec --mode release")
            elif args.topic == "graph":
                print_first_validation_command(result.data)
                print("\n📚 Graph examples:\n   ask graph find security\n   ask graph related skill-builder --depth 2\n   ask graph chain skill-creator skill-installer\n   ask graph info cli-spec")
            elif args.topic == "repo":
                print_first_validation_command(result.data)
                if args.action == "validate": print(result.data.get("raw_output", ""))
                if args.action == "check-stability" and "errors" in result.data:
                    for e in result.data["errors"]: print(f"   ERROR: {e}")
                if args.action == "doctor" and "doctor" in result.data:
                    for line in render_golden_path_summary(result.data["doctor"], indent="   "):
                        print(line)
                if args.action == "surface" and "repo_surface" in result.data:
                    summary = result.data["repo_surface"].get("summary", {})
                    print("   Surface summary: " f"{summary.get('total_paths', 0)} tracked path(s), " f"{summary.get('blocking_findings', 0)} blocking finding(s)")
                print("\n📚 Repo examples:\n   ask repo status\n   ask repo validate --ephemeral\n   ask repo doctor-catalog --strict\n   ask repo surface --json\n   ask repo check-stability --changed-files backend/cli-spec/SKILL.md")
            elif args.topic == "mcp":
                print_first_validation_command(result.data)
                print("\n📚 MCP examples:\n   ask mcp sync\n   ask mcp sync --dry-run")
            elif args.topic == "memory":
                print_first_validation_command(result.data)
            elif args.topic == "runtime":
                print_first_validation_command(result.data)
            elif args.topic == "wiki":
                print_first_validation_command(result.data)
                print("\n📚 Wiki examples:\n   ask wiki lint\n   ask wiki ingest 'Title' --summary 'Summary' --source '<source>'\n   ask wiki add --interactive\n   ask wiki query 'prompt injection'\n   ask wiki add-asset ./tmp/screenshot.png --title 'UI reference' --summary 'Capture for reuse'\n   ask wiki add-asset --interactive")
            elif args.topic == "workouts":
                print_first_validation_command(result.data)
                print("\n📚 Workout examples:\n   ask workouts list\n   ask workouts run agent-ops/verification-before-completion --attempts 2\n   ask workouts score agent-ops/verification-before-completion\n   ask workouts promote agent-ops/verification-before-completion --dry-run")
    if result.status == "success":
        sys.exit(0)
    else:
        sys.exit(exit_code_for_errors(result.errors))
if __name__ == "__main__":
    main()
