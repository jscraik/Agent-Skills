#!/usr/bin/env python3
import importlib
import sys
import time
from pathlib import Path

repo_root_path = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(repo_root_path / "utilities" / "skill-builder" / "scripts"))
sys.path.insert(0, str(repo_root_path / "scripts"))
sys.path.insert(0, str(repo_root_path / "scripts" / "lib"))

cli_dispatch = importlib.import_module("ask.cli_dispatch_entrypoint")
cli_errors = importlib.import_module("ask.cli_errors")
cli_exit = importlib.import_module("ask.cli_exit")
cli_parser = importlib.import_module("ask.cli_parser")
cli_renderer = importlib.import_module("ask.cli_renderer")
cli_request = importlib.import_module("ask.cli_request")
context = importlib.import_module("ask.context")
envelope = importlib.import_module("ask.envelope")


def main() -> None:
    start_time = time.time()
    parser = cli_parser.build_parser()
    parsed_command = cli_request.parse_command(parser)
    args = parsed_command.args
    raw_args = parsed_command.raw_args
    correction_note = parsed_command.correction_note
    prefix_flags, _ = cli_errors.consume_global_prefix_flags(raw_args)
    if "--json" in prefix_flags:
        args.json = True
    if "--trace-id" in prefix_flags:
        trace_idx = prefix_flags.index("--trace-id")
        if trace_idx + 1 < len(prefix_flags):
            args.trace_id = prefix_flags[trace_idx + 1]
    repo_root = context.find_repo_root()
    result = envelope.CallResult()
    if args.trace_id:
        result.trace_id = args.trace_id
    if correction_note and not args.json:
        print(f"{correction_note}\n")
    result = cli_dispatch.dispatch_command(
        cli_dispatch.DispatchRequest(
            parser=parser,
            repo_root=repo_root,
            args=args,
            raw_args=raw_args,
            correction_note=correction_note,
            result=result,
            start_time=start_time,
        )
    )
    cli_renderer.render_result(parser, repo_root, args, result)
    sys.exit(
        0
        if result.status == "success"
        else cli_exit.exit_code_for_errors(result.errors)
    )


if __name__ == "__main__":
    main()
