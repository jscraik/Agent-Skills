# Valid commands for fuzzy matching
VALID_TOPICS = ["repo", "skills", "plugins", "evals", "graph", "mcp", "wiki"]
VALID_ACTIONS = {
    "repo": ["status", "validate", "check-stability", "doctor-catalog"],
    "skills": ["list", "route", "goal", "starter", "sync", "audit", "install", "fold", "init"],
    "plugins": ["list", "status", "doctor", "init", "create", "install", "import", "harden", "uninstall"],
    "evals": ["run", "benchmark", "dashboard"],
    "graph": ["related", "find", "info", "chain", "list", "topics"],
    "mcp": ["sync"],
    "wiki": ["lint", "ingest", "add", "query", "add-asset"],
}

# Common mistakes and their corrections
FUZZY_MATCHES = {
    # Topic typos
    "skill": "skills",
    "skil": "skills",
    "skils": "skills",
    "repo": "repo",
    "rep": "repo",
    "plugin": "plugins",
    "plug": "plugins",
    "eval": "evals",
    "evaluation": "evals",
    "mcp": "mcp",
    "mc": "mcp",
    "wiki": "wiki",
    "wik": "wiki",
    "wili": "wiki",
    # Action typos for skills
    "aud": "audit",
    "audt": "audit",
    "sync": "sync",
    "syn": "sync",
    "install": "install",
    "instal": "install",
    "list": "list",
    "ls": "list",
    "init": "init",
    "create": "init",
    "harden": "harden",
    "fold": "fold",
    "merge": "fold",
    # Graph actions
    "search": "find",
    "query": "find",
    "related": "related",
    "rel": "related",
    "neighbors": "related",
    "info": "info",
    "show": "info",
    "details": "info",
    "chain": "chain",
    "path": "chain",
    "route": "chain",
    "goal": "goal",
    "doctor": "doctor-catalog",
    "catalog": "doctor-catalog",
    "topics": "topics",
    "tags": "topics",
    "categories": "topics",
    # Wiki actions
    "ingest": "ingest",
    "import": "ingest",
    "add": "add",
    "triage": "add",
    "lookup": "query",
    "asset": "add-asset",
    "add-asset": "add-asset",
    "lint": "lint",
    "check": "lint",
}


def get_closest_match(query: str, options: List[str], cutoff: float = 0.6) -> Optional[str]:
    """Find closest match using difflib."""
    matches = difflib.get_close_matches(query, options, n=1, cutoff=cutoff)
    return matches[0] if matches else None


def format_correction(original: str, corrected: str, robot_mode: bool = False) -> str:
    """Format a command correction message."""
    if robot_mode:
        return f"🤖 Robot mode: Interpreting '{original}' as '{corrected}'\n   💡 Tip: Use '{corrected}' for exact matching next time."
    return f"💡 Did you mean: '{corrected}'? (Use --robot to auto-correct)"


def consume_global_prefix_flags(raw_args: List[str]) -> Tuple[List[str], List[str]]:
    """Split leading global flags from positional command tokens."""
    global_flags = {"--json", "--trace-id", "--robot", "--agent-mode", "-r", "--help", "-h"}
    prefix_flags: List[str] = []
    idx = 0
    while idx < len(raw_args) and raw_args[idx].startswith("-"):
        flag = raw_args[idx]
        if flag not in global_flags:
            break
        prefix_flags.append(flag)
        idx += 1
        if flag in {"--trace-id"} and idx < len(raw_args) and not raw_args[idx].startswith("-"):
            prefix_flags.append(raw_args[idx])
            idx += 1
    return prefix_flags, raw_args[idx:]


def build_helpful_error(topic: Optional[str], action: Optional[str], raw_args: List[str], repo_root: Path) -> CallResult:
    """Build a helpful error message with examples."""
    result = CallResult()
    result.status = "error"

    error_msg = "I couldn't understand that command."
    suggestions = []
    examples = []

    # Try to figure out what they meant
    if not topic:
        error_msg = "Missing or unknown command topic."
        suggestions.append(f"Valid topics: {', '.join(VALID_TOPICS)}")
        if raw_args:
            guess = get_closest_match(raw_args[0], VALID_TOPICS)
            if guess:
                suggestions.append(f"💡 Did you mean 'ask {guess}'?")
    elif topic not in VALID_TOPICS:
        guess = get_closest_match(topic, VALID_TOPICS)
        if guess:
            error_msg = f"Unknown topic: '{topic}'"
            suggestions.append(f"💡 Did you mean 'ask {guess}'?")
        else:
            error_msg = f"Unknown topic: '{topic}'"
            suggestions.append(f"Valid topics: {', '.join(VALID_TOPICS)}")
    elif not action:
        error_msg = f"Missing action for 'ask {topic}'"
        valid_actions = VALID_ACTIONS.get(topic, [])
        suggestions.append(f"Valid actions: {', '.join(valid_actions)}")
    elif action not in VALID_ACTIONS.get(topic, []):
        valid = VALID_ACTIONS.get(topic, [])
        guess = get_closest_match(action, valid)
        if guess:
            error_msg = f"Unknown action: '{action}' for topic '{topic}'"
            suggestions.append(f"💡 Did you mean 'ask {topic} {guess}'?")
        else:
            error_msg = f"Unknown action: '{action}' for topic '{topic}'"
            suggestions.append(f"Valid actions: {', '.join(valid)}")

    # Add relevant examples based on context
    if topic == "skills" or not topic:
        examples.extend([
            "ask skills list",
            "ask skills route \"find me the right skill for this request\"",
            "ask skills goal \"implement this feature safely\"",
            "ask skills starter --archetype delivery",
            "ask skills audit backend/cli-spec --level strict",
            "ask skills init my-skill --category backend --description 'Does something useful'",
        ])
    if topic == "graph" or not topic:
        examples.extend([
            "ask graph find security",
            "ask graph related skill-builder --depth 2",
            "ask graph info cli-spec",
        ])
    if topic == "repo" or not topic:
        examples.extend([
            "ask repo status",
            "ask repo validate --ephemeral",
            "ask repo doctor-catalog --strict",
            "ask repo check-stability",
        ])
    if topic == "mcp" or not topic:
        examples.extend([
            "ask mcp sync",
            "ask mcp sync --dry-run",
        ])
    if topic == "wiki" or not topic:
        examples.extend([
            "ask wiki lint",
            "ask wiki ingest 'Title' --summary 'Summary' --source '<source>'",
            "ask wiki add --interactive",
            "ask wiki query '1password signing'",
            "ask wiki add-asset /path/to/screenshot.png --title 'Checkout flow' --summary 'Reference layout' --status verified",
            "ask wiki add-asset --interactive",
        ])

    # Build the full error message
    full_message = f"❌ {error_msg}\n"
    if suggestions:
        full_message += "\n" + "\n".join(f"   {s}" for s in suggestions)
    if examples:
        full_message += "\n\n📚 Examples:\n"
        full_message += "\n".join(f"   • {e}" for e in examples[:4])

    result.errors.append(ErrorObject(
        code=ErrorCode.ERR_VALIDATION,
        message=full_message,
        fix_suggestion="Use 'ask --help' for full usage information."
    ))

    return result


def try_fuzzy_parse(raw_args: List[str], robot_mode: bool = False) -> Tuple[Optional[str], Optional[str], List[str], Optional[str]]:
    """
    Try to parse args with fuzzy matching.
    Returns: (topic, action, remaining_args, correction_note)
    """
    if not raw_args:
        return None, None, [], None

    # Skip leading global flags (--json, --trace-id, --robot, etc.)
    prefix_flags, working_args = consume_global_prefix_flags(raw_args)
    if not working_args:
        return None, None, raw_args, None

    correction_note = None

    # Alias normalization:
    # - ask goal "<intent>" -> ask skills goal "<intent>"
    # - ask doctor catalog -> ask repo doctor-catalog
    if working_args[0] == "goal":
        topic = "skills"
        action = "goal"
        return topic, action, prefix_flags + working_args[1:], format_correction("goal", "skills goal", robot_mode)
    if len(working_args) >= 2 and working_args[0] == "doctor" and working_args[1] == "catalog":
        topic = "repo"
        action = "doctor-catalog"
        return topic, action, prefix_flags + working_args[2:], format_correction("doctor catalog", "repo doctor-catalog", robot_mode)

    topic = working_args[0]
    remaining = working_args[1:]

    # Try fuzzy match on topic
    if topic not in VALID_TOPICS:
        # Check direct fuzzy matches
        if topic in FUZZY_MATCHES:
            corrected = FUZZY_MATCHES[topic]
            if corrected in VALID_TOPICS:
                correction_note = format_correction(topic, corrected, robot_mode)
                topic = corrected
        else:
            # Try difflib
            guess = get_closest_match(topic, VALID_TOPICS)
            if guess:
                correction_note = format_correction(topic, guess, robot_mode)
                topic = guess

    # Get action if available
    action = None
    if remaining:
        action = remaining[0]
        valid_actions = VALID_ACTIONS.get(topic, [])

        if action not in valid_actions:
            # Try fuzzy match on action
            if action in FUZZY_MATCHES:
                corrected = FUZZY_MATCHES[action]
                if corrected in valid_actions:
                    if correction_note:
                        correction_note += f"\n   Also interpreting '{action}' as '{corrected}'"
                    else:
                        correction_note = format_correction(action, corrected, robot_mode)
                    action = corrected
            else:
                guess = get_closest_match(action, valid_actions)
                if guess:
                    if correction_note:
                        correction_note += f"\n   Also interpreting '{action}' as '{guess}'"
                    else:
                        correction_note = format_correction(action, guess, robot_mode)
                    action = guess

            # If we couldn't match to a valid action, preserve the original action
            # so later VALID_ACTIONS validation can produce the proper unknown-action message

        remaining = remaining[1:]

    # Combine prefix flags with remaining args for downstream processing
    full_remaining = prefix_flags + remaining
    return topic, action, full_remaining, correction_note


def _safe_input(prompt: str) -> Optional[str]:
    """Prompt with defensive handling of EOFError and KeyboardInterrupt."""
    try:
        return input(prompt)
    except (EOFError, KeyboardInterrupt):
        print("\n\nInteractive input cancelled by user.")
        raise SystemExit(130)


def _prompt_choice(prompt: str, options: List[str]) -> str:
    """Prompt the operator for one option using 1-based indexing."""
    print(prompt)
    for idx, option in enumerate(options, start=1):
        print(f"  {idx}. {option}")
    while True:
        raw = _safe_input("> ").strip()
        if raw.isdigit():
            choice = int(raw)
            if 1 <= choice <= len(options):
                return options[choice - 1]
        if raw in options:
            return raw
        print(f"Please choose 1-{len(options)} or type an exact option value.")


def _prompt_nonempty(prompt: str) -> str:
    """Prompt until a non-empty string is entered."""
    while True:
        value = _safe_input(prompt).strip()
        if value:
            return value
        print("This value cannot be empty.")


def _prompt_optional(prompt: str) -> str:
    """Prompt for an optional value (can be empty)."""
    return _safe_input(prompt).strip()

