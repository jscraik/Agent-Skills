                    print_first_validation_command(report)
                elif args.topic == "skills" and args.action in ("codex-preview", "capabilities", "capability"):
                    print("\n".join(skills_commands.format_codex_preview_human(result.data.get("codex_preview", {})) if args.action == "codex-preview" else skills_commands.format_capabilities_human(result.data.get("capability_discovery", {}))))
                elif args.topic == "skills" and args.action == "load-preview":
                    preview = result.data.get("codex_load_preview", {})
                    print(
                        "Codex load preview: "
