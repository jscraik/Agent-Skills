# Error Code Mapping (per spec Error Registry)
ERROR_MAP = {
    ErrorCode.SUCCESS: ExitCode.SUCCESS,
    ErrorCode.ERR_RUNTIME: ExitCode.ERR_RUNTIME,
    ErrorCode.ERR_VALIDATION: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_PI_GUARD: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_PATH_TRAVERSAL: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_SCHEMA_INVALID: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_INVALID_HANDOFF: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_INVALID_STATE: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_INVALID_SCOPE: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_INVALID_PROJECTION_MODE: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_DEFERRED_PROJECTION_MODE: ExitCode.ERR_VALIDATION,
    ErrorCode.ERR_DEPENDENCY: ExitCode.ERR_DEPENDENCY,
    ErrorCode.ERR_CONFLICT: ExitCode.ERR_CONFLICT,
    ErrorCode.ERR_REDUNDANCY: ExitCode.ERR_CONFLICT,
    ErrorCode.ERR_AUTH: ExitCode.ERR_AUTH,
}

def get_closest_match(query: str, options: List[str], cutoff: float = 0.6) -> Optional[str]:
    """Find closest match using difflib."""
    matches = difflib.get_close_matches(query, options, n=1, cutoff=cutoff)
    return matches[0] if matches else None


def format_correction(original: str, corrected: str, robot_mode: bool = False) -> str:
    """Format a command correction message."""
    if robot_mode:
        return f"🤖 Robot mode: Interpreting '{original}' as '{corrected}'\n   💡 Tip: Use '{corrected}' for exact matching next time."
    return f"💡 Did you mean: '{corrected}'? (Use --robot to auto-correct)"


def _normalize_token(token: str) -> str:
    """Normalize a command token for robust fuzzy matching."""
    return token.strip().lower().replace("_", "-")


def _extract_argparse_error(stderr_text: Optional[str]) -> Optional[str]:
    """Extract the actionable argparse error line."""
    if not stderr_text:
        return None
    lines = [line.strip() for line in stderr_text.splitlines() if line.strip()]
    for line in lines:
        if line.startswith("ask: error:"):
            return line.replace("ask: error:", "", 1).strip()
    return lines[-1] if lines else None


def _example_commands(topic: Optional[str], action: Optional[str], *, limit: int = 3) -> List[str]:
    """Return contextual command examples, preferring command-specific examples."""
    if topic and action and (topic, action) in COMMAND_EXAMPLES:
        return COMMAND_EXAMPLES[(topic, action)][:limit]
    if topic and topic in TOPIC_EXAMPLES:
        return TOPIC_EXAMPLES[topic][:limit]
    fallback = []
    for fallback_topic in ("skills", "repo", "graph"):
        fallback.extend(TOPIC_EXAMPLES.get(fallback_topic, []))
    return fallback[:limit]


def _merge_corrections(existing: Optional[str], new_note: Optional[str]) -> Optional[str]:
    """Merge correction notes without duplicating text blocks."""
    if not existing:
        return new_note
    if not new_note:
        return existing
    if new_note in existing:
        return existing
    return f"{existing}\n{new_note}"


def consume_global_prefix_flags(raw_args: List[str]) -> Tuple[List[str], List[str]]:
    """Split leading global flags from positional command tokens."""
    global_flags = {"--json", "--trace-id", "--robot", "--agent-mode", "-r", "--help", "-h"}
    prefix_flags: List[str] = []
    idx = 0
    while idx < len(raw_args) and raw_args[idx].startswith("-"):
        flag = raw_args[idx]
        if flag not in global_flags:
            break
        prefix_flags.append(flag)
        idx += 1
        if flag in {"--trace-id"} and idx < len(raw_args) and not raw_args[idx].startswith("-"):
            prefix_flags.append(raw_args[idx])
            idx += 1
    return prefix_flags, raw_args[idx:]


def build_helpful_error(
    topic: Optional[str],
    action: Optional[str],
    raw_args: List[str],
    *,
    parser_error: Optional[str] = None,
) -> CallResult:
    """Build a detailed error message when command intent is unclear."""
    result = CallResult()
    result.status = "error"

    entered = "ask " + " ".join(raw_args) if raw_args else "ask"
    _, working_args = consume_global_prefix_flags(raw_args)
    parsed_error = _extract_argparse_error(parser_error)
    error_msg = "I couldn't reliably determine command intent."
    suggestions: List[str] = []
    examples = _example_commands(topic, action, limit=3)

    # Try to figure out what they meant
    if not topic:
        error_msg = "Missing or unknown command topic."
        suggestions.append(f"Start with a topic: {', '.join(VALID_TOPICS)}")
        if working_args:
            first = _normalize_token(working_args[0])
            action_topics = ACTION_TO_TOPICS.get(first, [])
            if len(action_topics) == 1:
                guessed_topic = action_topics[0]
                suggestions.append(f"'{first}' is an action under '{guessed_topic}'. Try 'ask {guessed_topic} {first}'.")
                examples = _example_commands(guessed_topic, first, limit=3)
            elif len(action_topics) > 1:
                topics_text = ", ".join(action_topics)
                suggestions.append(f"'{first}' is ambiguous and exists under topics: {topics_text}.")
            else:
                guess = get_closest_match(first, VALID_TOPICS)
                if guess:
                    suggestions.append(f"Closest topic guess: 'ask {guess}'.")
    elif topic not in VALID_TOPICS:
        normalized_topic = _normalize_token(topic)
        action_topics = ACTION_TO_TOPICS.get(normalized_topic, [])
        if len(action_topics) == 1:
            inferred_topic = action_topics[0]
            error_msg = f"Unknown topic: '{topic}'"
            suggestions.append(
                f"'{normalized_topic}' is an action under '{inferred_topic}'. Try 'ask {inferred_topic} {normalized_topic}'."
            )
            examples = _example_commands(inferred_topic, normalized_topic, limit=3)
        elif len(action_topics) > 1:
            error_msg = f"Unknown topic: '{topic}'"
            options = ", ".join(action_topics)
            suggestions.append(
                f"'{normalized_topic}' is ambiguous and can belong to: {options}. Use an explicit topic."
            )
            examples = [f"ask {candidate_topic} {normalized_topic}" for candidate_topic in action_topics[:3]]
            examples.extend(_example_commands(None, None, limit=max(0, 3 - len(examples))))
        else:
            guess = get_closest_match(normalized_topic, VALID_TOPICS)
            if guess:
                error_msg = f"Unknown topic: '{topic}'"
                suggestions.append(f"Closest topic guess: 'ask {guess}'.")
                examples = _example_commands(guess, None, limit=3)
            else:
                error_msg = f"Unknown topic: '{topic}'"
                suggestions.append(f"Valid topics: {', '.join(VALID_TOPICS)}")
    elif not action:
        error_msg = f"Missing action for 'ask {topic}'"
        valid_actions = VALID_ACTIONS.get(topic, [])
        suggestions.append(f"Valid actions for '{topic}': {', '.join(valid_actions)}")
        examples = _example_commands(topic, None, limit=3)
    elif action not in VALID_ACTIONS.get(topic, []):
        valid = VALID_ACTIONS.get(topic, [])
        guess = get_closest_match(action, valid)
        if guess:
            error_msg = f"Unknown action: '{action}' for topic '{topic}'"
            suggestions.append(f"Closest action guess: 'ask {topic} {guess}'.")
            examples = _example_commands(topic, guess, limit=3)
        else:
            error_msg = f"Unknown action: '{action}' for topic '{topic}'"
            suggestions.append(f"Valid actions for '{topic}': {', '.join(valid)}")
            examples = _example_commands(topic, None, limit=3)

    # Build the full error message
    full_message = f"❌ {error_msg}\n\n   Entered: `{entered}`"
    if parsed_error:
        full_message += f"\n   Parser detail: {parsed_error}"
    if suggestions:
        full_message += "\n\n🧭 Guidance:\n"
        full_message += "\n".join(f"   • {s}" for s in suggestions)
    if examples:
        full_message += "\n\n📚 Try one of these:\n"
        full_message += "\n".join(f"   • {e}" for e in examples[:3])

    fix_suggestion = "Use 'ask --help' for global usage or '<topic> <action> --help' for command details."
    if topic in VALID_ACTIONS:
        fix_suggestion = f"Valid actions: {', '.join(VALID_ACTIONS[topic])}"

    result.errors.append(ErrorObject(
        code=ErrorCode.ERR_VALIDATION,
        message=full_message,
        fix_suggestion=fix_suggestion,
    ))

    return result


def build_argument_error(
    topic: str,
    action: str,
    raw_args: List[str],
    *,
    parser_error: Optional[str] = None,
) -> CallResult:
    """Build a detailed error when command intent is clear but args are invalid."""
    result = CallResult()
    result.status = "error"
    entered = "ask " + " ".join(raw_args) if raw_args else f"ask {topic} {action}"
    parsed_error = _extract_argparse_error(parser_error) or "Argument syntax was invalid for this command."
    examples = _example_commands(topic, action, limit=3)

    message_lines = [
        "❌ Command intent was understood, but argument syntax is invalid.",
        "",
        f"   Entered: `{entered}`",
        f"   Parsed intent: `ask {topic} {action}`",
        f"   Parser detail: {parsed_error}",
        "",
        "🧭 Guidance:",
        f"   • Run `ask {topic} {action} --help` to see required/optional arguments.",
    ]
    if examples:
        message_lines.append("   • Use one of the valid example forms below.")
        message_lines.append("")
        message_lines.append("📚 Valid examples:")
        for example in examples:
            message_lines.append(f"   • {example}")

    result.errors.append(
        ErrorObject(
            code=ErrorCode.ERR_VALIDATION,
            message="\n".join(message_lines),
            fix_suggestion=f"Run 'ask {topic} {action} --help' and retry with the shown argument shape.",
        )
    )
    return result


def parse_args_with_capture(parser: argparse.ArgumentParser, argv: List[str]) -> Tuple[Optional[argparse.Namespace], Optional[int], str]:
    """Parse CLI args while capturing argparse stderr for richer error reporting."""
    import contextlib
    import io

    stderr_buffer = io.StringIO()
    try:
        with contextlib.redirect_stderr(stderr_buffer):
            parsed = parser.parse_args(argv)
        return parsed, None, stderr_buffer.getvalue()
    except SystemExit as exc:
        return None, int(exc.code), stderr_buffer.getvalue()


def try_fuzzy_parse(raw_args: List[str], robot_mode: bool = False) -> Tuple[Optional[str], Optional[str], List[str], Optional[str]]:
    """
    Try to parse args with fuzzy matching.
    Returns: (topic, action, remaining_args, correction_note)
    """
    if not raw_args:
        return None, None, [], None

    # Skip leading global flags (--json, --trace-id, --robot, etc.)
    prefix_flags, working_args = consume_global_prefix_flags(raw_args)
    if not working_args:
        return None, None, raw_args, None

    correction_note: Optional[str] = None
    first_token = _normalize_token(working_args[0])
    second_token = _normalize_token(working_args[1]) if len(working_args) > 1 else None

    # Alias normalization:
    # - ask goal "<intent>" -> ask skills goal "<intent>"
    # - ask doctor catalog -> ask repo doctor-catalog
    if first_token == "goal":
        topic = "skills"
        action = "goal"
        return topic, action, prefix_flags + working_args[1:], format_correction("goal", "skills goal", robot_mode)
    if len(working_args) >= 2 and first_token == "doctor" and second_token == "catalog":
        topic = "repo"
        action = "doctor-catalog"
        return topic, action, prefix_flags + working_args[2:], format_correction("doctor catalog", "repo doctor-catalog", robot_mode)

    # Swapped ordering recovery: `ask list skills` -> `ask skills list`
    if len(working_args) >= 2:
        swapped_topic_candidate = second_token
        swapped_action_candidate = first_token
        if swapped_topic_candidate in VALID_TOPICS:
            swapped_valid_actions = VALID_ACTIONS.get(swapped_topic_candidate, [])
            resolved_swapped_action = None
            if swapped_action_candidate in swapped_valid_actions:
                resolved_swapped_action = swapped_action_candidate
            else:
                mapped_action = FUZZY_MATCHES.get(swapped_action_candidate)
                if mapped_action in swapped_valid_actions:
                    resolved_swapped_action = mapped_action
                else:
                    guess_action = get_closest_match(swapped_action_candidate, swapped_valid_actions)
                    if guess_action:
                        resolved_swapped_action = guess_action
            if resolved_swapped_action:
                correction_note = format_correction(
                    f"{working_args[0]} {working_args[1]}",
                    f"{swapped_topic_candidate} {resolved_swapped_action}",
                    robot_mode,
                )
                return (
                    swapped_topic_candidate,
                    resolved_swapped_action,
                    prefix_flags + working_args[2:],
                    correction_note,
                )

    topic = first_token
    remaining = working_args[1:]

    # Topic recovery:
    # 1) explicit typo maps
    # 2) close match on known topics
    # 3) infer topic from action when action is unique to one topic
    if topic not in VALID_TOPICS:
        if topic in FUZZY_MATCHES and FUZZY_MATCHES[topic] in VALID_TOPICS:
            corrected = FUZZY_MATCHES[topic]
            correction_note = format_correction(working_args[0], corrected, robot_mode)
            topic = corrected
        else:
            guess = get_closest_match(topic, VALID_TOPICS)
            if guess:
                correction_note = format_correction(working_args[0], guess, robot_mode)
                topic = guess
            else:
                unique_topics = ACTION_TO_TOPICS.get(topic, [])
                if len(unique_topics) == 1:
                    inferred_topic = unique_topics[0]
                    correction_note = format_correction(working_args[0], f"{inferred_topic} {topic}", robot_mode)
                    return inferred_topic, topic, prefix_flags + working_args[1:], correction_note

    # Resolve action token; permit flags before action in robot mode.
    action = None
    action_index = None
    for idx, token in enumerate(remaining):
        if token.startswith("-"):
            continue
        action = _normalize_token(token)
        action_index = idx
        break

    if action is not None:
        valid_actions = VALID_ACTIONS.get(topic, [])
        original_action = action
        if action not in valid_actions:
            mapped_action = FUZZY_MATCHES.get(action)
            if mapped_action in valid_actions:
                action = mapped_action
            else:
                guess = get_closest_match(action, valid_actions)
                if guess:
                    action = guess
        if action != original_action:
            correction_note = _merge_corrections(
                correction_note,
                format_correction(original_action, action, robot_mode),
            )

        # Remove just the action token; keep all other args/flags in order.
        remaining = remaining[:action_index] + remaining[action_index + 1:]

    # Combine prefix flags with remaining args for downstream processing
    full_remaining = prefix_flags + remaining
    return topic, action, full_remaining, correction_note


def _safe_input(prompt: str) -> Optional[str]:
    """Prompt with defensive handling of EOFError and KeyboardInterrupt."""
    try:
        return input(prompt)
    except (EOFError, KeyboardInterrupt):
        print("\n\nInteractive input cancelled by user.")
        raise SystemExit(130)


def _prompt_choice(prompt: str, options: List[str]) -> str:
    """Prompt the operator for one option using 1-based indexing."""
    print(prompt)
    for idx, option in enumerate(options, start=1):
        print(f"  {idx}. {option}")
    while True:
        raw = _safe_input("> ").strip()
        if raw.isdigit():
            choice = int(raw)
            if 1 <= choice <= len(options):
                return options[choice - 1]
        if raw in options:
            return raw
        print(f"Please choose 1-{len(options)} or type an exact option value.")


def _prompt_nonempty(prompt: str) -> str:
    """Prompt until a non-empty string is entered."""
    while True:
        value = _safe_input(prompt).strip()
        if value:
            return value
        print("This value cannot be empty.")


def _prompt_optional(prompt: str) -> str:
    """Prompt for an optional value (can be empty)."""
    return _safe_input(prompt).strip()

def main():
    start_time = time.time()

    # Check for robot mode in raw args before parsing
    raw_args = sys.argv[1:]
    alias_correction_note = None
    prefix_flags, positional_args = consume_global_prefix_flags(raw_args)
    first_positional = _normalize_token(positional_args[0]) if positional_args else None
    second_positional = _normalize_token(positional_args[1]) if len(positional_args) > 1 else None
    if first_positional == "goal":
        raw_args = [*prefix_flags, "skills", "goal", *positional_args[1:]]
        alias_correction_note = "💡 Alias: 'ask goal' maps to 'ask skills goal'."
    elif first_positional == "doctor" and second_positional == "catalog":
        raw_args = [*prefix_flags, "repo", "doctor-catalog", *positional_args[2:]]
        alias_correction_note = "💡 Alias: 'ask doctor catalog' maps to 'ask repo doctor-catalog'."

    robot_mode = any(flag in raw_args for flag in ["--robot", "--agent-mode", "-r"])

    # Keep raw_args intact for parse_args() so robot flags are properly handled
    # Use filtered_args only for early help detection (before parser setup)
    filtered_args = [a for a in raw_args if a not in ["--robot", "--agent-mode", "-r"]]

    # Use a parent parser for global flags to share them with subcommands
    global_parser = argparse.ArgumentParser(add_help=False)
    global_parser.add_argument("--json", action="store_true", help="Output results in JSON format for programmatic use")
    global_parser.add_argument("--trace-id", help="Trace ID for correlating logs", default=os.environ.get("ASK_TRACE_ID"))
    global_parser.add_argument("--robot", "--agent-mode", "-r", dest="robot_mode", action="store_true",
                               help="AI-agent mode: honors clear intent despite minor syntax issues, emits correction notes, and returns detailed guided errors on ambiguity")

    parser = argparse.ArgumentParser(
        prog="ask",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Agent Skills Kit CLI. Use --robot / --agent-mode / -r for AI-agent workflows.",
        parents=[global_parser],
    )
    subparsers = parser.add_subparsers(dest="topic", help="Command topics (use --robot for fuzzy matching)")
    # --- repo ---
    repo_parser = subparsers.add_parser("repo", help="Repository management", parents=[global_parser])
    repo_subparsers = repo_parser.add_subparsers(dest="action")
    repo_status_parser = repo_subparsers.add_parser("status", help="Show repository status", parents=[global_parser])
    repo_status_parser.add_argument("--verbose", action="store_true", help="Include more details")
    repo_validate_parser = repo_subparsers.add_parser("validate", help="Run all repository validations", parents=[global_parser])
    repo_validate_parser.add_argument("--ephemeral", action="store_true", help="Do not mutate repo validation artifacts")
    repo_validate_parser.add_argument("--fail-fast", action="store_true", help="Stop after the first required failure")
    repo_validate_parser.add_argument("--changed-files", nargs="+", default=[], help="Scope validation to these changed files")

    repo_stability_parser = repo_subparsers.add_parser("check-stability", help="Check stable skills not deleted without deprecation", parents=[global_parser])
    repo_stability_parser.add_argument("--changed-files", nargs="+", default=[], help="Changed SKILL.md files to check")
    repo_doctor_catalog_parser = repo_subparsers.add_parser(
        "doctor-catalog",
        help="Diagnose canonical catalog parity drift",
        parents=[global_parser],
    )
    repo_doctor_catalog_parser.add_argument("--strict", action="store_true", help="Enable strict trend and stamp enforcement")
    repo_subparsers.add_parser("provider-audit", help="Audit active paths for legacy provider drift", parents=[global_parser])

    # --- skills ---
    skills_parser = subparsers.add_parser("skills", help="Skill management", parents=[global_parser])
    skills_subparsers = skills_parser.add_subparsers(dest="action")
    skills_list_parser = skills_subparsers.add_parser("list", help="List discovered skills", parents=[global_parser])
    skills_list_parser.add_argument("--category", help="Filter by category")
    skills_list_parser.add_argument("--advanced", action="store_true", help="Include lane skills hidden in default listings")
    skills_list_parser.add_argument("--starter", action="store_true", help="Return starter-mode curated skills")
    skills_list_parser.add_argument("--archetype", default="general", help="Starter archetype (general|delivery|review|docs)")
    skills_list_parser.add_argument("--limit", type=int, default=12, help="Max starter skills to return")
    skills_budget_parser = skills_subparsers.add_parser("budget", help="Verify default skill runtime budget", parents=[global_parser])
    skills_budget_parser.add_argument("--default-max", type=int, default=30, help="Maximum default-visible skills")
    skills_handles_parser = skills_subparsers.add_parser("handles", help="List or validate command-visible skill handles", parents=[global_parser])
    skills_handles_parser.add_argument("--check", action="store_true", help="Fail when command-handle validation finds drift")
    skills_handles_parser.add_argument("--no-handles", action="store_true", help="Omit the full handle list from JSON output")
    skills_handles_parser.add_argument("--write-projection", action="store_true", help="Write .skillsets/command-surface.json from rooted manifests")
    skills_handles_parser.add_argument("--write-command-handles", action="store_true", help="Write generated runtime command handles for non-root handles")
    skills_handles_parser.add_argument("--check-command-handles", action="store_true", help="Verify generated runtime command handles exist and match rooted manifests")
    skills_handles_parser.add_argument("--dry-run", action="store_true", help="Preview generated projection or command-handle writes without changing files")
    skills_resolve_parser = skills_subparsers.add_parser("resolve", help="Resolve a command-visible skill handle", parents=[global_parser])
    skills_resolve_parser.add_argument("handle", help="Skill handle to resolve, with or without leading $")
    skills_parse_parser = skills_subparsers.add_parser(
        "parse",
        help="Parse and resolve $ skill and @ reviewer handles from a prompt",
        parents=[global_parser],
    )
    skills_parse_parser.add_argument(
        "request",
        nargs="+",
        help="Prompt text containing $ skill and @ reviewer handles",
    )
    skills_proof_parser = skills_subparsers.add_parser("proof", help="Prove a command handle reaches workspace and user runtime surfaces", parents=[global_parser])
    skills_proof_parser.add_argument("handle", help="Skill handle to prove, with or without leading $")

    # --- reviewers ---
    reviewers_parser = subparsers.add_parser("reviewers", help="Reviewer/subagent handle management", parents=[global_parser])
    reviewers_subparsers = reviewers_parser.add_subparsers(dest="action")
    reviewers_resolve_parser = reviewers_subparsers.add_parser("resolve", help="Resolve a reviewer/subagent handle", parents=[global_parser])
    reviewers_resolve_parser.add_argument("handle", help="Reviewer handle to resolve, with or without leading @")

    # --- runtime ---
    add_runtime_parser(subparsers, global_parser)

    skills_route_parser = skills_subparsers.add_parser("route", help="Route a request to matching skills", parents=[global_parser])
    skills_route_parser.add_argument("request", nargs="+", help="Request text to route")
    skills_route_parser.add_argument("--top-k", type=int, default=3, help="Max ranked candidates to return")
    skills_route_parser.add_argument("--considered-limit", type=int, default=20, help="Max eligible candidates considered before truncation")

    skills_goal_parser = skills_subparsers.add_parser("goal", help="Resolve intent into one recommended skill", parents=[global_parser])
    skills_goal_parser.add_argument("intent", nargs="+", help="Intent text to route")
    skills_goal_parser.add_argument("--top-k", type=int, default=3, help="Max ranked candidates to consider")
    skills_goal_parser.add_argument("--considered-limit", type=int, default=20, help="Max eligible candidates considered before truncation")

    skills_starter_parser = skills_subparsers.add_parser("starter", help="List starter-mode curated skills", parents=[global_parser])
    skills_starter_parser.add_argument("--archetype", default="general", help="Starter archetype (general|delivery|review|docs)")
    skills_starter_parser.add_argument("--limit", type=int, default=12, help="Max starter skills to return")
    skills_sync_parser = skills_subparsers.add_parser("sync", help="Synchronize skill symlinks", parents=[global_parser])
    skills_sync_parser.add_argument("--scope", choices=["user", "workspace"], default="workspace", help="Tier to sync")
    skills_sync_parser.add_argument("--dry-run", action="store_true", help="Preview changes")
    skills_sync_parser.add_argument(
        "--projection",
        help="Runtime projection mode: flat, rooted, or skill-tree alias for rooted",
    )
    skills_audit_parser = skills_subparsers.add_parser("audit", help="Run audits on a skill", parents=[global_parser])
    skills_audit_parser.add_argument("path", help="Path to the skill directory")
    skills_audit_parser.add_argument("--level", choices=["compat", "strict"], default="compat", help="Audit depth")
    
    skills_install_parser = skills_subparsers.add_parser("install", help="Install a skill from GitHub", parents=[global_parser])
    skills_install_parser.add_argument("url", help="GitHub URL of the skill")
    skills_install_parser.add_argument("--dest", default="Skills/github", help="Repo-relative canonical category directory under Skills/ (default: Skills/github)")
    skills_install_parser.add_argument("--remediate", action="store_true", help="Scaffold missing contract/eval files")
    skills_install_parser.add_argument("--dry-run", action="store_true", help="Preview installation")
    
    skills_fold_parser = skills_subparsers.add_parser("fold", help="Suggest folding source into target", parents=[global_parser])
    skills_fold_parser.add_argument("source", help="Skill to be folded")
    skills_fold_parser.add_argument("target", help="Skill to merge into")
    skills_fold_parser.add_argument("--sensitivity", type=float, default=0.2, help="Overlap threshold")
    
    skills_init_parser = skills_subparsers.add_parser("init", help="Initialize a new skill scaffold", parents=[global_parser])
    skills_init_parser.add_argument("name", help="Name of the new skill")
    skills_init_parser.add_argument("--category", required=True, help="Category directory")
    skills_init_parser.add_argument("--description", required=True, help="Short routing description")

    # --- plugins ---
    plugins_parser = subparsers.add_parser("plugins", help="Plugin management", parents=[global_parser])
    plugins_subparsers = plugins_parser.add_subparsers(dest="action")

    def _add_plugin_init_args(parser):
        parser.add_argument("name", help="Name of the new plugin")
        parser.add_argument("--category", default="third-party", help="Plugin category under Plugins/ (default: third-party)")
        parser.add_argument("--with-marketplace", action="store_true", help="Add to local marketplace")
        parser.add_argument("--with-scripts", action="store_true", help="Add scripts directory")
        parser.add_argument("--with-assets", action="store_true", help="Add assets directory")
        parser.add_argument("--with-references", action="store_true", help="Add references directory")
        parser.add_argument("--with-workflows", action="store_true", help="Add workflows directory")

    def _add_plugin_install_args(parser):
        parser.add_argument("url", help="GitHub URL of the plugin source")
        parser.add_argument("--path", required=True, help="Plugin directory path inside source repo")
        parser.add_argument("--name", help="Override installed plugin name")
        parser.add_argument("--ref", help="Pinned Git ref to install (recommended: commit SHA)")
        parser.add_argument("--dest", default="Plugins/third-party", help="Destination directory relative to repo root")
        parser.add_argument("--validation-level", choices=["strict", "compat"], default="compat", help="Installer validation depth")
        parser.add_argument("--allow-untrusted-source", action="store_true", help="Allow non-allowlisted source repos")
        parser.add_argument("--allow-unpinned-ref", action="store_true", help="Allow non-SHA refs (e.g. main)")
        parser.add_argument("--dry-run", action="store_true", help="Preview installation without writing")

    plugins_subparsers.add_parser("list", help="List plugin lifecycle state", parents=[global_parser])

    plugins_status_parser = plugins_subparsers.add_parser("status", help="Show state for one plugin", parents=[global_parser])
    plugins_status_parser.add_argument("name", help="Plugin name")

    plugins_subparsers.add_parser("doctor", help="Run read-only plugin diagnostics", parents=[global_parser])

    plugins_sync_runtime_parser = plugins_subparsers.add_parser(
        "sync-local-runtime",
        help="Replace copied local-plugin runtime mirrors from canonical Plugins/",
        parents=[global_parser],
    )
    plugins_sync_runtime_parser.add_argument("--dry-run", action="store_true", help="Preview runtime sync without writing")
    
    plugins_init_parser = plugins_subparsers.add_parser("init", help="Initialize a new plugin scaffold", parents=[global_parser])
    _add_plugin_init_args(plugins_init_parser)

    plugins_create_parser = plugins_subparsers.add_parser("create", help="Alias for plugins init", parents=[global_parser])
    _add_plugin_init_args(plugins_create_parser)

    plugins_install_parser = plugins_subparsers.add_parser("install", help="Install a plugin from GitHub", parents=[global_parser])
    _add_plugin_install_args(plugins_install_parser)

    plugins_import_parser = plugins_subparsers.add_parser("import", help="Alias for plugins install", parents=[global_parser])
    _add_plugin_install_args(plugins_import_parser)
    
    plugins_uninstall_parser = plugins_subparsers.add_parser("uninstall", help="Uninstall a plugin and sync config", parents=[global_parser])
    plugins_uninstall_parser.add_argument("name", help="Name of plugin to uninstall")
    plugins_uninstall_parser.add_argument("--dry-run", action="store_true", help="Preview uninstallation without making changes")

    plugins_harden_parser = plugins_subparsers.add_parser("harden", help="Run plugin-builder hardening checks", parents=[global_parser])
    plugins_harden_parser.add_argument("plugin_path", help="Plugin path to harden (for example: Plugins/my-plugin)")
    plugins_harden_parser.add_argument("--marketplace-path", default=".agents/Plugins/marketplace.json", help="Marketplace manifest path")
    plugins_harden_parser.add_argument("--skip-compat", action="store_true", help="Skip audit-compat step")
    plugins_harden_parser.add_argument("--skip-marketplace-audit", action="store_true", help="Skip audit-marketplace step")
    plugins_harden_parser.add_argument("--no-require-marketplace", action="store_true", help="Do not require a matching marketplace entry")
    plugins_harden_parser.add_argument("--strict-marketplace-path", action="store_true", help="Disallow legacy marketplace path override")
    
    # --- evals ---
    evals_parser = subparsers.add_parser("evals", help="Evaluation and Benchmarking", parents=[global_parser])
    evals_subparsers = evals_parser.add_subparsers(dest="action")
    
    evals_run_parser = evals_subparsers.add_parser("run", help="Run evaluation cases for a skill", parents=[global_parser])
    evals_run_parser.add_argument("path", help="Path to the skill directory")
    evals_run_parser.add_argument("--mode", choices=["smoke", "release"], default="smoke", help="Evaluation mode")
    
    evals_subparsers.add_parser("benchmark", help="Run full repository benchmark suite", parents=[global_parser])
    evals_subparsers.add_parser("dashboard", help="Generate evaluation dashboard", parents=[global_parser])

    # --- workouts ---
    add_workouts_parser(subparsers, global_parser)

    # --- graph ---
    graph_parser = subparsers.add_parser("graph", help="Skill graph navigation and discovery", parents=[global_parser])
    graph_subparsers = graph_parser.add_subparsers(dest="action")

    graph_related_parser = graph_subparsers.add_parser("related", help="Find related skills", parents=[global_parser])
    graph_related_parser.add_argument("skill", help="Skill name to find relations for")
    graph_related_parser.add_argument("--depth", type=int, default=1, help="BFS depth")
    graph_related_parser.add_argument("--reverse", action="store_true", help="Follow in-links instead of out-links")
    graph_related_parser.add_argument("--topic-filter", dest="topic_filter", help="Filter by topic")
    graph_related_parser.add_argument("--tier", choices=["stable", "growing", "experimental"], help="Filter by tier")

    graph_find_parser = graph_subparsers.add_parser("find", help="Search for skills", parents=[global_parser])
    graph_find_parser.add_argument("query", help="Search query")
    graph_find_parser.add_argument("--topic-filter", dest="topic_filter", help="Filter by topic")
    graph_find_parser.add_argument("--tier", choices=["stable", "growing", "experimental"], help="Filter by tier")

    graph_info_parser = graph_subparsers.add_parser("info", help="Show skill details", parents=[global_parser])
    graph_info_parser.add_argument("skill", help="Skill name")

    graph_chain_parser = graph_subparsers.add_parser("chain", help="Find path between skills", parents=[global_parser])
    graph_chain_parser.add_argument("from_skill", help="Starting skill")
    graph_chain_parser.add_argument("to_skill", help="Target skill")

    graph_list_parser = graph_subparsers.add_parser("list", help="List all skills in graph", parents=[global_parser])
    graph_list_parser.add_argument("--topic-filter", dest="topic_filter", help="Filter by topic")
    graph_list_parser.add_argument("--tier", choices=["stable", "growing", "experimental"], help="Filter by tier")

    graph_subparsers.add_parser("topics", help="List all topic clusters", parents=[global_parser])

    # --- mcp ---
    mcp_parser = subparsers.add_parser("mcp", help="MCP configuration management", parents=[global_parser])
    mcp_subparsers = mcp_parser.add_subparsers(dest="action")

    mcp_sync_parser = mcp_subparsers.add_parser("sync", help="Sync MCP config from Codex to Codex JSON export", parents=[global_parser])
    mcp_sync_parser.add_argument("--dry-run", action="store_true", help="Preview changes without writing")

    # --- wiki ---
    wiki_parser = subparsers.add_parser("wiki", help="Skill Ops Wiki operations", parents=[global_parser])
    wiki_subparsers = wiki_parser.add_subparsers(dest="action")

    wiki_lint_parser = wiki_subparsers.add_parser("lint", help="Lint wiki links and freshness", parents=[global_parser])
    wiki_lint_parser.add_argument("--wiki-root", default="Wiki/wiki", help="Wiki root path")
    wiki_lint_parser.add_argument("--max-age-days", type=int, default=60, help="Max last_reviewed age before warning")

    wiki_ingest_parser = wiki_subparsers.add_parser("ingest", help="Ingest raw source notes into wiki logs", parents=[global_parser])
    wiki_ingest_parser.add_argument("title", help="Ingest title")
    wiki_ingest_parser.add_argument("--source", action="append", default=[], help="Source reference (repeatable)")
    wiki_ingest_parser.add_argument("--summary", required=True, help="One-paragraph summary")
    wiki_ingest_parser.add_argument("--tag", action="append", default=[], help="Tag (repeatable)")
    wiki_ingest_parser.add_argument("--dry-run", action="store_true", help="Preview output without writing")

    wiki_add_parser = wiki_subparsers.add_parser("add", help="Triage and add a structured wiki note", parents=[global_parser])
    wiki_add_parser.add_argument("title", nargs="?", help="Note title")
    wiki_add_parser.add_argument("--summary", help="Summary text")
    wiki_add_parser.add_argument("--source", help="Primary source reference")
    wiki_add_parser.add_argument(
        "--intent",
        choices=["finding", "playbook", "design-asset", "lesson-learned"],
        help="Triage intent",
    )
    wiki_add_parser.add_argument(
        "--status",
        choices=["needs-verification", "verified", "fix-now"],
        help="Current status",
    )
    wiki_add_parser.add_argument(
        "--destination",
        choices=["failures", "playbooks", "assets/ui", "learnings"],
        help="Override destination folder under Wiki/wiki",
    )
    wiki_add_parser.add_argument("--tag", action="append", default=[], help="Tag (repeatable)")
    wiki_add_parser.add_argument("--interactive", action="store_true", help="Prompt for missing triage fields")
    wiki_add_parser.add_argument("--dry-run", action="store_true", help="Preview output without writing")

    wiki_query_parser = wiki_subparsers.add_parser("query", help="Search wiki pages", parents=[global_parser])
    wiki_query_parser.add_argument("query", help="Search query")
    wiki_query_parser.add_argument("--limit", type=int, default=5, help="Max results to return")
    wiki_query_parser.add_argument("--wiki-root", default="Wiki/wiki", help="Wiki root path")

    wiki_asset_parser = wiki_subparsers.add_parser("add-asset", help="Add screenshot/asset to wiki and create linked note", parents=[global_parser])
    wiki_asset_parser.add_argument("asset_path", nargs="?", help="Path to local asset file")
    wiki_asset_parser.add_argument("--title", help="Asset note title")
    wiki_asset_parser.add_argument("--summary", help="Summary for why this asset matters")
    wiki_asset_parser.add_argument("--source", default="", help="Original source reference (optional)")
    wiki_asset_parser.add_argument("--status", choices=["needs-verification", "verified", "fix-now"], help="Current status")
    wiki_asset_parser.add_argument("--destination", choices=["assets/ui", "learnings"], help="Destination folder under wiki")
    wiki_asset_parser.add_argument("--tag", action="append", default=[], help="Tag (repeatable)")
    wiki_asset_parser.add_argument("--interactive", action="store_true", help="Prompt for missing asset fields")
    wiki_asset_parser.add_argument("--dry-run", action="store_true", help="Preview output without writing")

    # Pre-parse to check for help
    if not filtered_args or filtered_args[0] in ("-h", "--help"):
        parser.print_help()
        sys.exit(0)

    parsed_topic = None
    parsed_action = None
    correction_note = alias_correction_note
    args: Optional[argparse.Namespace] = None

    parsed_args, parse_exit_code, parser_stderr = parse_args_with_capture(parser, raw_args)
    if parsed_args is not None:
        args = parsed_args
        parsed_topic = args.topic
        parsed_action = getattr(args, "action", None)
    else:
        if parse_exit_code == 0:
            sys.exit(0)

        if robot_mode:
            fuzzy_topic, fuzzy_action, remaining_args, fuzzy_note = try_fuzzy_parse(raw_args, robot_mode=True)
            correction_note = _merge_corrections(correction_note, fuzzy_note)
            parsed_topic = fuzzy_topic
            parsed_action = fuzzy_action

            can_attempt_reparse = (
                parsed_topic in VALID_TOPICS
                and parsed_action in VALID_ACTIONS.get(parsed_topic, [])
            )
            if can_attempt_reparse:
                corrected_args = [parsed_topic, parsed_action, *remaining_args]
                corrected_parsed_args, corrected_exit_code, corrected_stderr = parse_args_with_capture(parser, corrected_args)
                if corrected_parsed_args is not None:
                    args = corrected_parsed_args
                else:
                    if corrected_exit_code == 0:
                        sys.exit(0)
                    result = build_argument_error(
                        parsed_topic,
                        parsed_action,
                        raw_args,
                        parser_error=corrected_stderr or parser_stderr,
                    )
                    result.metadata["command"] = " ".join(sys.argv[1:])
                    if correction_note:
                        result.metadata["correction_note"] = correction_note.replace("\n", " ")
                    if "--json" in raw_args:
                        print(result.to_json())
                    else:
                        if correction_note:
                            print(f"{correction_note}\n")
                        print(result.errors[0].message)
                    sys.exit(2)
            else:
                result = build_helpful_error(
                    parsed_topic,
                    parsed_action,
                    raw_args,
                    parser_error=parser_stderr,
                )
                result.metadata["command"] = " ".join(sys.argv[1:])
                if correction_note:
                    result.metadata["correction_note"] = correction_note.replace("\n", " ")
                if "--json" in raw_args:
                    print(result.to_json())
                else:
                    if correction_note:
                        print(f"{correction_note}\n")
                    print(result.errors[0].message)
                sys.exit(2)
        else:
            potential_topic, potential_action, _, _ = try_fuzzy_parse(raw_args, robot_mode=False)
            is_known_command = (
                potential_topic in VALID_TOPICS and
                potential_action in VALID_ACTIONS.get(potential_topic, [])
            )
            if is_known_command:
                result = build_argument_error(
                    potential_topic,
                    potential_action,
                    raw_args,
                    parser_error=parser_stderr,
                )
            else:
                result = build_helpful_error(
                    potential_topic,
                    potential_action,
                    raw_args,
                    parser_error=parser_stderr,
                )
            result.metadata["command"] = " ".join(sys.argv[1:])
            if "--json" in raw_args:
                print(result.to_json())
            else:
                print(result.errors[0].message)
            sys.exit(2)

    # Guard: args must be initialized before use (catches robot-mode parse edge cases)
    if args is None:
        result = CallResult()
        result.status = "error"
        result.errors.append(ErrorObject(
            code=ErrorCode.ERR_VALIDATION,
            message="Failed to parse command arguments.",
            fix_suggestion="Check command format and try again."
        ))
        if "--json" in raw_args:
            print(result.to_json())
        else:
            print("❌ Failed to parse command arguments.")
        sys.exit(2)

    # Preserve leading global flags even when subparser defaults would overwrite them.
    prefix_flags, _ = consume_global_prefix_flags(raw_args)
    if "--json" in prefix_flags:
        args.json = True
    if "--trace-id" in prefix_flags:
        trace_idx = prefix_flags.index("--trace-id")
        if trace_idx + 1 < len(prefix_flags):
            args.trace_id = prefix_flags[trace_idx + 1]

    repo_root = find_repo_root()
    result = CallResult()
    if args.trace_id:
        result.trace_id = args.trace_id

    # Print correction note if in human mode
    if correction_note and not args.json:
        print(f"{correction_note}\n")

    if args.topic == "repo":
        if args.action == "status":
            result = repo_status(repo_root, verbose=args.verbose)
        elif args.action == "validate":
            result = repo_validate(
                repo_root,
                ephemeral=args.ephemeral,
                fail_fast=args.fail_fast,
                changed_files=args.changed_files or [],
            )
        elif args.action == "check-stability":
            result = check_hub_stability(repo_root, changed_files=args.changed_files or [])
        elif args.action == "doctor-catalog":
            result = doctor_catalog(repo_root, strict=args.strict)
        elif args.action == "provider-audit":
            result = provider_audit(repo_root)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'repo'",
                fix_suggestion="Valid actions: status, validate, check-stability, doctor-catalog, provider-audit"
            ))

    elif args.topic == "skills":
        if args.action == "list":
            result = list_skills(
                repo_root,
                category=args.category,
                starter=args.starter,
                archetype=args.archetype,
                limit=args.limit,
                advanced=args.advanced,
            )
        elif args.action == "budget":
            result = skills_budget(repo_root, default_max=args.default_max)
        elif args.action == "handles":
            result = skills_handles(
                repo_root,
                check=args.check,
                include_handles=not args.no_handles,
                write_projection=args.write_projection,
                write_command_handle_files=args.write_command_handles,
                check_command_handle_files=args.check_command_handles,
                dry_run=args.dry_run,
            )
        elif args.action == "resolve":
            result = skills_resolve(repo_root, handle=args.handle)
        elif args.action == "parse":
            result = skills_parse(repo_root, request_text=" ".join(args.request))
        elif args.action == "proof":
            result = skills_proof(repo_root, handle=args.handle)
        elif args.action == "route":
            result = route_skills(
                repo_root,
                request=" ".join(args.request),
                top_k=args.top_k,
                considered_limit=args.considered_limit,
            )
        elif args.action == "goal":
            result = goal_skills(
                repo_root,
                intent_text=" ".join(args.intent),
                top_k=args.top_k,
                considered_limit=args.considered_limit,
            )
        elif args.action == "starter":
            result = list_skills(
                repo_root,
                category=None,
                starter=True,
                archetype=args.archetype,
                limit=args.limit,
            )
        elif args.action == "sync":
            result = sync_skills(repo_root, scope=args.scope, dry_run=args.dry_run, projection=args.projection)
        elif args.action == "audit":
            result = audit_skill(repo_root, skill_path=args.path, level=args.level)
        elif args.action == "install":
            result = install_skill(repo_root, url=args.url, remediate=args.remediate, dest=args.dest, dry_run=args.dry_run)
        elif args.action == "fold":
            result = fold_skills(repo_root, source=args.source, target=args.target, sensitivity=args.sensitivity)
        elif args.action == "init":
            result = init_skill(repo_root, name=args.name, category=args.category, description=args.description)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'skills'",
                fix_suggestion=(
                    "Valid actions: list, budget, handles, resolve, parse, proof, "
                    "route, goal, starter, sync, audit, install, fold, init"
                )
            ))

    elif args.topic == "reviewers":
        if args.action == "resolve":
            result = reviewers_resolve(repo_root, handle=args.handle)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'reviewers'",
                fix_suggestion="Valid actions: resolve"
            ))

    elif args.topic == "runtime":
        result = dispatch_runtime(repo_root, args)

    elif args.topic == "plugins":
        if args.action == "list":
            result = list_plugins_state(repo_root)
        elif args.action == "status":
            result = status_plugin_state(repo_root, name=args.name)
        elif args.action == "doctor":
            result = doctor_plugins_state(repo_root)
        elif args.action == "sync-local-runtime":
            result = sync_local_runtime_plugins(repo_root, dry_run=args.dry_run)
        elif args.action in {"init", "create"}:
            companion = [
                name
                for enabled, name in (
                    (args.with_scripts, "scripts"),
                    (args.with_assets, "assets"),
                    (args.with_references, "references"),
                    (args.with_workflows, "workflows"),
                )
                if enabled
            ]
            result = init_plugin(
                repo_root,
                name=args.name,
                category=args.category,
                with_marketplace=args.with_marketplace,
                companion_folders=companion,
            )
        elif args.action in {"install", "import"}:
            result = install_plugin(
                repo_root,
                url=args.url,
                plugin_path=args.path,
                name=args.name,
                ref=args.ref,
                dest=args.dest,
                validation_level=args.validation_level,
                allow_untrusted_source=args.allow_untrusted_source,
                allow_unpinned_ref=args.allow_unpinned_ref,
                dry_run=args.dry_run,
            )
        elif args.action == "harden":
            result = harden_plugin(
                repo_root,
                plugin_path=args.plugin_path,
                require_marketplace=not args.no_require_marketplace,
                marketplace_path=args.marketplace_path,
                run_compat=not args.skip_compat,
                run_marketplace_audit=not args.skip_marketplace_audit,
                allow_legacy_marketplace_path=not args.strict_marketplace_path,
            )
        elif args.action == "uninstall":
            result = uninstall_plugin(
                repo_root,
                name=args.name,
                dry_run=args.dry_run,
            )
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'plugins'",
                fix_suggestion="Valid actions: list, status, doctor, sync-local-runtime, init, create, install, import, harden, uninstall"
            ))

    elif args.topic == "evals":
        if args.action == "run":
            result = run_evals(repo_root, path=args.path, mode=args.mode)
        elif args.action == "benchmark":
            result = benchmark_portfolio(repo_root)
        elif args.action == "dashboard":
            result = dashboard_report(repo_root)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'evals'",
                fix_suggestion="Valid actions: run, benchmark, dashboard"
            ))

    elif args.topic == "workouts":
        result = dispatch_workouts(repo_root, args)

    elif args.topic == "graph":
        if args.action == "related":
            result = graph_related(repo_root, skill=args.skill, depth=args.depth,
                                   reverse=args.reverse, topic=args.topic_filter, tier=args.tier)
        elif args.action == "find":
            result = graph_find(repo_root, query=args.query, topic=args.topic_filter, tier=args.tier)
        elif args.action == "info":
            result = graph_info(repo_root, skill=args.skill)
        elif args.action == "chain":
            result = graph_chain(repo_root, from_skill=args.from_skill, to_skill=args.to_skill)
        elif args.action == "list":
            result = graph_list(repo_root, topic=args.topic_filter, tier=args.tier)
        elif args.action == "topics":
            result = graph_topics(repo_root)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'graph'",
                fix_suggestion="Valid actions: related, find, info, chain, list, topics"
            ))

    elif args.topic == "mcp":
        if args.action == "sync":
            result = sync_mcp(repo_root, dry_run=args.dry_run)
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'mcp'",
                fix_suggestion="Valid actions: sync"
            ))

    elif args.topic == "wiki":
        if args.action == "lint":
            result = wiki_lint(repo_root, wiki_root=args.wiki_root, max_age_days=args.max_age_days)
        elif args.action == "ingest":
            result = wiki_ingest(
                repo_root,
                title=args.title,
                sources=args.source or [],
                summary=args.summary,
                tags=args.tag or [],
                dry_run=args.dry_run,
            )
        elif args.action == "add":
            title = args.title
            summary = args.summary
            source = args.source
            intent = args.intent
            status = args.status
            destination = args.destination
            tags = args.tag or []

            if args.interactive:
                if args.json:
                    result.status = "error"
                    result.errors.append(
                        ErrorObject(
                            code=ErrorCode.ERR_VALIDATION,
                            message="--interactive cannot be combined with --json.",
                            fix_suggestion="Use interactive mode without --json or pass all fields explicitly.",
                        )
                    )
                else:
                    print("🧭 Wiki triage questionnaire")
                    title = title or _prompt_nonempty("Title: ")
                    summary = summary or _prompt_nonempty("Summary: ")
                    source = source or _prompt_nonempty("Source: ")
                    intent = intent or _prompt_choice(
                        "Intent:",
                        ["finding", "playbook", "design-asset", "lesson-learned"],
                    )
                    status = status or _prompt_choice(
                        "Status:",
                        ["needs-verification", "verified", "fix-now"],
                    )
                    destination = destination or _prompt_choice(
                        "Destination:",
                        ["failures", "playbooks", "assets/ui", "learnings"],
                    )

            required_missing = []
            if not title:
                required_missing.append("title")
            if not summary:
                required_missing.append("summary")
            if not source:
                required_missing.append("source")
            if not intent:
                required_missing.append("intent")
            if not status:
                required_missing.append("status")

            if result.status != "error" and required_missing:
                result.status = "error"
                result.errors.append(
                    ErrorObject(
                        code=ErrorCode.ERR_VALIDATION,
                        message=f"Missing required fields for wiki add: {', '.join(required_missing)}",
                        fix_suggestion="Use --interactive or pass --summary, --source, --intent, and --status explicitly.",
                    )
                )
            elif result.status != "error":
                result = wiki_add(
                    repo_root,
                    title=title,
                    summary=summary,
                    source=source,
                    intent=intent,
                    status=status,
                    destination=destination,
                    tags=tags,
                    dry_run=args.dry_run,
                )
        elif args.action == "query":
            result = wiki_query(
                repo_root,
                query=args.query,
                wiki_root=args.wiki_root,
                limit=args.limit,
            )
        elif args.action == "add-asset":
            asset_path = args.asset_path
            title = args.title
            summary = args.summary
            source = args.source
            status = args.status
            destination = args.destination
            tags = args.tag or []

            if args.interactive:
                if args.json:
                    result.status = "error"
                    result.errors.append(
                        ErrorObject(
                            code=ErrorCode.ERR_VALIDATION,
                            message="--interactive cannot be combined with --json.",
                            fix_suggestion="Use interactive mode without --json or pass all fields explicitly.",
                        )
                    )
                else:
                    print("🖼️ Wiki asset questionnaire")
                    asset_path = asset_path or _prompt_nonempty("Asset path: ")
                    title = title or _prompt_nonempty("Title: ")
                    summary = summary or _prompt_nonempty("Summary: ")
                    source = source or _prompt_optional("Source (optional): ")
                    status = status or _prompt_choice(
                        "Status:",
                        ["needs-verification", "verified", "fix-now"],
                    )
                    destination = destination or _prompt_choice(
                        "Destination:",
                        ["assets/ui", "learnings"],
                    )

            required_missing = []
            if not asset_path:
                required_missing.append("asset_path")
            if not title:
                required_missing.append("title")
            if not summary:
                required_missing.append("summary")
            status = status or "verified"
            destination = destination or "assets/ui"

            if result.status != "error" and required_missing:
                result.status = "error"
                result.errors.append(
                    ErrorObject(
                        code=ErrorCode.ERR_VALIDATION,
                        message=f"Missing required fields for wiki add-asset: {', '.join(required_missing)}",
                        fix_suggestion="Use --interactive or pass asset_path, --title, and --summary explicitly.",
                    )
                )
            elif result.status != "error":
                result = wiki_add_asset(
                    repo_root,
                    asset_path=asset_path,
                    title=title,
                    summary=summary,
                    source=source,
                    status=status,
                    destination=destination,
                    tags=tags,
                    dry_run=args.dry_run,
                )
        else:
            result.status = "error"
            action_msg = f"unknown action '{args.action}'" if args.action else "missing action"
            result.errors.append(ErrorObject(
                code=ErrorCode.ERR_VALIDATION,
                message=f"{action_msg} for topic 'wiki'",
                fix_suggestion="Valid actions: lint, ingest, add, query, add-asset"
            ))

    # Finalize Result Metadata (before output dispatch so both JSON and human modes see it)
    result.metadata["command"] = " ".join(sys.argv[1:])
    if correction_note:
        result.metadata["correction_note"] = correction_note.replace("\n", " ")

    # Finalize Telemetry
    result.telemetry["latency_ms"] = int((time.time() - start_time) * 1000)
    if args.trace_id:
        result.trace_id = args.trace_id # Ensure it persists if command function replaced result

    # Dispatch Output
    if args.json:
        print(result.to_json(repo_root=str(repo_root)))
    else:
        if result.status == "success":
            if args.topic:
                if args.topic == "repo" and args.action == "status":
                    print(f"✅ Success: {result.metadata['command']}")
                    print(f"  Root: {result.data['repo_root']}")
                    print(f"  Synced: {result.data['skills_synced']}")
                elif args.topic == "repo" and args.action == "validate":
                    print(f"✅ Validation passed! ({result.data['warn_only_issues']} warnings)")
                    if result.data.get("changed_files"):
                        print(f"   Scoped to {len(result.data['changed_files'])} changed file(s)")
                elif args.topic == "repo" and args.action == "check-stability":
                    print(f"✅ Stability check passed ({result.data['stable_count']} stable skills)")
                    if args.changed_files:
                        print(f"   Checked {result.data['checked_files']} changed file(s)")
                elif args.topic == "repo" and args.action == "doctor-catalog":
                    report = result.data.get("catalog_parity", {})
                    print(f"✅ Catalog parity: {report.get('decision_status', 'resolved')}")
                    print(f"  Canonical count: {report.get('canonical_count')}")
                    print(f"  Policy identity: {report.get('policy_identity')}")
                    for surface in report.get("surfaces", []):
                        print(
                            "  - "
                            f"{surface.get('surface_name')}: "
                            f"{surface.get('observed_count')} / {surface.get('canonical_count')} "
                            f"(parity_ok={surface.get('parity_ok')})"
                        )
                elif args.topic == "repo" and args.action == "provider-audit":
                    report = result.data.get("provider_policy", {})
                    print(
                        "✅ Provider policy: "
                        f"{report.get('status')} ({report.get('violation_count', 0)} violation(s))"
                    )
                elif args.topic == "skills" and args.action == "list":
                    print(f"Discovered {len(result.data['skills'])} skills:")
                    for skill in result.data["skills"]:
                        print(f"  - {skill['name']} [{skill['category']}]")
                    if result.data.get("policy_identity"):
                        print(f"Policy identity: {result.data['policy_identity']}")
                    if result.data.get("advanced_mode"):
                        print("Advanced mode: visible")
                    if result.data.get("starter_mode"):
                        print(
                            f"Starter mode: archetype={result.data.get('starter_archetype')} "
                            f"limit={result.data.get('starter_limit')}"
                        )
                elif args.topic == "skills" and args.action == "budget":
                    report = result.data.get("runtime_budget", {})
                    print(
                        "✅ Runtime budget: "
                        f"{report.get('default_visible_count')}/{report.get('default_visible_max')} default skills, "
                        f"{report.get('advanced_visible_count')} advanced"
                    )
                elif args.topic == "skills" and args.action == "handles":
                    surface = result.data.get("command_surface", {})
                    print(
                        "✅ Skill handles: "
                        f"{surface.get('handle_count', 0)} handle(s), status={surface.get('status')}"
                    )
                    if result.data.get("policy_identity"):
                        print(f"  Policy identity: {result.data['policy_identity']}")
                    violations = result.data.get("violations", [])
                    if violations:
                        print(f"  Violations: {len(violations)}")
                elif args.topic == "skills" and args.action == "resolve":
                    resolution = result.data.get("resolution", {})
                    print(f"✅ Skill handle: ${resolution.get('handle')}")
                    print(f"  Visibility: {resolution.get('command_visibility')}")
                    print(f"  Source: {resolution.get('source_path')}")
                    if resolution.get("invoke_via"):
                        print(f"  Invoke via: {resolution.get('invoke_via')}")
                elif args.topic == "skills" and args.action == "proof":
                    proof = result.data.get("proof", {})
                    print(f"✅ Skill handle proof: ${proof.get('handle')} ({proof.get('status')})")
                    for gate, passed in proof.get("gates", {}).items():
                        marker = "pass" if passed else "fail"
                        print(f"  {gate}: {marker}")
                    live = proof.get("live_codex_invocation", {})
                    if live.get("status"):
                        print(f"  live invocation: {live.get('status')}")
                elif args.topic == "skills" and args.action == "parse":
                    parsed = result.data.get("parsed", {})
                    print(f"✅ Parse succeeded: {parsed.get('status', 'ok')}")
                    counts = parsed.get("mention_counts", {})
                    print(f"  Skills: {counts.get('skills', 0)}, Reviewers: {counts.get('reviewers', 0)}, Unresolved: {counts.get('unresolved', 0)}")
                    if parsed.get("skill_mentions"):
                        print(f"  Skill mentions: {len(parsed['skill_mentions'])}")
                    if parsed.get("reviewer_mentions"):
                        print(f"  Reviewer mentions: {len(parsed['reviewer_mentions'])}")
                elif args.topic == "reviewers" and args.action == "resolve":
                    resolution = result.data.get("resolution", {})
                    handle = resolution.get("canonical_handle") or resolution.get("handle")
                    print(f"✅ Reviewer handle: @{handle}")
                    print(f"  Visibility: {resolution.get('command_visibility')}")
                    print(f"  Source: {resolution.get('source_path')}")
                elif args.topic == "runtime" and args.action in ("surface", "budget"):
                    report = result.data.get("runtime_surface") or result.data.get("runtime_budget", {})
                    label = "surface" if args.action == "surface" else "budget"
                    print(
                        f"✅ Runtime {label}: "
                        f"{report.get('projection_mode')} projection, "
                        f"{report.get('default_visible_count')}/{report.get('default_visible_max')} default skills, "
                        f"{report.get('hidden_system_count')} system lane"
                    )
                elif args.topic == "skills" and args.action == "route":
                    decision = result.data["decision"]
                    print(f"🧭 Route decision: {decision['decision_status']}")
                    print(f"Policy identity: {decision['policy_identity']}")
                    print(
                        "Considered: "
                        f"{len(decision['considered_candidates'])}/{decision['considered_total']} "
                        f"(limit={decision['considered_limit']}, truncated={decision['considered_truncated']})"
                    )
                    if decision["selected_candidates"]:
                        print("Selected:")
                        for candidate in decision["selected_candidates"]:
                            print(
                                f"  - {candidate['name']} ({candidate['path']}) "
                                f"confidence={candidate.get('confidence', 0.0):.4f}"
                            )
                            rationale = candidate.get("rationale") or []
                            if rationale:
                                print(f"    rationale: {', '.join(rationale)}")
                    if decision.get("failure_class"):
                        print(f"Failure class: {decision['failure_class']}")
                    if decision.get("operator_action"):
                        print(f"Operator action: {decision['operator_action']}")
                    if decision.get("ambiguity_set"):
                        print("Ambiguity set:")
                        for candidate in decision["ambiguity_set"]:
                            print(
                                f"  - {candidate.get('name')} ({candidate.get('path')}) "
                                f"confidence={candidate.get('confidence', 0.0):.4f}"
                            )
                elif args.topic == "skills" and args.action == "goal":
                    goal = result.data["goal_decision"]
                    print(f"🎯 Goal decision: {goal['decision_status']}")
                    print(f"Policy identity: {goal['policy_identity']}")
                    recommended = goal.get("recommended_candidate")
                    if recommended:
                        print(
                            f"Recommended: {recommended.get('name')} "
                            f"({recommended.get('path')})"
                        )
                    alternatives = goal.get("alternative_candidates", [])
                    if alternatives:
                        print("Alternatives:")
                        for candidate in alternatives:
                            print(f"  - {candidate.get('name')} ({candidate.get('path')})")
                    prompts = goal.get("disambiguation_prompts", [])
                    if prompts:
                        print("Disambiguation prompts:")
                        for prompt in prompts:
                            print(f"  - {prompt}")
                elif args.topic == "skills" and args.action == "starter":
                    print(
                        f"Starter skills ({len(result.data['skills'])}) "
                        f"[{result.data.get('starter_archetype', 'general')}]"
                    )
                    for skill in result.data["skills"]:
                        print(f"  - {skill['name']} [{skill['category']}]")
                elif args.topic == "skills" and args.action == "sync":
                    print(f"✅ Planned sync: {len(result.data['plan']['symlinks'])} symlinks.")
                    for log in result.data.get("logs", []):
                        print(f"  {log}")
                    if args.dry_run:
                        print("  (Dry run - no changes made)")
                    if result.data.get("policy_identity"):
                        print(f"  Policy identity: {result.data['policy_identity']}")
                elif args.topic == "workouts":
                    render_workouts_human(args, result)
                elif args.topic == "skills" and args.action == "audit":
                    print(f"✅ Audit passed: {args.path}")
                    print(result.data["diagnostics"]["stdout"])
                elif args.topic == "skills" and args.action == "install":
                    if result.data.get("dry_run"):
                        print("🔍 Dry run - would install:")
                        print(f"   URL: {result.data.get('url')}")
                        print(f"   Skill: {result.data.get('skill_name')}")
                        print(f"   Target: {result.data.get('target_path')}")
                        if result.data.get('remediate'):
                            print("   Remediate: Yes (scaffold missing files)")
                        print("\n💡 To actually install, run:")
                        print(f"   {result.metadata.get('next_steps', ['ask skills install <url>'])[0]}")
                    else:
                        print(f"✅ Installed skill: {result.data.get('skill_name', args.url)}")
                        print(result.data.get("raw_output", ""))
                elif args.topic == "skills" and args.action == "fold":
                    print(f"✅ Result: {result.data['recommendation']}")
                    print(f"  Overlap Score: {result.data['overlap_score']}")
                    print(f"  Rationale: {result.data['rationale']}")
                elif args.topic == "skills" and args.action == "init":
                    print(f"✅ {result.data['message']}")
                elif args.topic == "plugins" and args.action in {"init", "create"}:
                    print(f"✅ {result.data['message']}")
                    print(result.data.get("raw_output", ""))
                    created_manual = result.data.get("created_manual_folders", [])
                    if created_manual:
                        print("Created companion folders:")
                        for folder in created_manual:
                            print(f"  - {folder}")
                elif args.topic == "plugins" and args.action in {"list", "status", "doctor"}:
                    installed_state = result.data.get("installed_state", {})
                    activation_state = result.data.get("activation_state", {})
                    health_state = result.data.get("health_state", {})
                    print(f"Plugins installed: {installed_state.get('plugin_count', 0)}")
                    for plugin in installed_state.get("plugins", []):
                        print(f"  - {plugin.get('name')} ({plugin.get('path')})")
                    print(f"Activation entries: {activation_state.get('plugin_count', 0)}")
                    print(f"Health status: {health_state.get('status', 'unknown')}")
                    blockers = health_state.get("blockers", [])
                    if blockers:
                        print("Blockers:")
                        for blocker in blockers:
                            print(f"  - {blocker}")
                elif args.topic == "plugins" and args.action == "sync-local-runtime":
                    if result.data.get("dry_run"):
                        print("🔍 Dry run - would replace local-plugin runtime mirrors:")
                    else:
                        print(f"✅ {result.data.get('message', 'Replaced local-plugin runtime mirrors.')}")
                    print(f"Profiles: {len(result.data.get('profile_homes', []))}")
                    print(f"Plugins: {', '.join(result.data.get('plugin_names', []))}")
                    for report in result.data.get("runtime_reports", []):
                        print(f"  - {report.get('runtime_root')}")
                        removed = report.get("removed_entries") or []
                        if removed:
                            print(f"    removed: {', '.join(removed)}")
                elif args.topic == "plugins" and args.action in {"install", "import"}:
                    if result.data.get("dry_run"):
                        print("🔍 Dry run - would install plugin:")
                        print(f"   URL: {result.data.get('url')}")
                        print(f"   Source path: {result.data.get('plugin_path')}")
                        print(f"   Name: {result.data.get('plugin_name')}")
                        print(f"   Target: {result.data.get('target_path')}")
                        print("\n💡 To actually install, run:")
                        print(f"   {result.metadata.get('next_steps', ['ask plugins install <url> --path <path>'])[0]}")
                    else:
                        print(f"✅ {result.data.get('message', 'Plugin installed.')}")
                        if result.data.get("raw_output"):
                            print(result.data["raw_output"])
                elif args.topic == "plugins" and args.action == "harden":
                    print(f"✅ {result.data.get('message', 'Plugin hardening checks passed.')}")
                    command_runs = result.data.get("command_runs", [])
                    if command_runs:
                        print("Checks run:")
                        for run in command_runs:
                            print(f"  - {run.get('step')}: {run.get('command')}")
                elif args.topic == "evals":
                    if args.action == "run":
                        print(f"✅ Evaluation complete for {args.path}")
                        print(result.data.get("raw_output", ""))
                    elif args.action == "benchmark":
                        print("✅ Benchmark suite complete.")
                        print(result.data.get("raw_output", ""))
                    elif args.action == "dashboard":
                        print(f"✅ {result.data['message']}")
                elif args.topic == "mcp" and args.action == "sync":
                    if result.data.get("dry_run"):
                        print(f"🔍 Dry run - would sync {result.data['server_count']} MCP server(s):")
                        for server in result.data.get("servers", []):
                            print(f"   • {server}")
                        print(f"\n   Target: {result.data['target_path']}")
                    else:
                        print(f"✅ Synced {result.data['server_count']} MCP servers to {result.data['target_path']}")
                        print("   Re-run `codex mcp list` or restart Codex to pick up changes.")
                elif args.topic == "wiki":
                    if args.action == "lint":
                        print(f"✅ {result.data.get('message', 'Wiki lint passed.')}")
                        if result.data.get("raw_output"):
                            print(result.data["raw_output"])
                    elif args.action == "ingest":
                        if result.data.get("dry_run"):
                            print("🔍 Dry run - would ingest:")
                            print(f"   Raw note: {result.data.get('raw_note')}")
                            print(f"   Log file: {result.data.get('log_file')}")
                        else:
                            print(f"✅ {result.data.get('message', 'Wiki ingest complete.')}")
                            print(f"   Raw note: {result.data.get('raw_note')}")
                            print(f"   Log file: {result.data.get('log_file')}")
                    elif args.action == "add":
                        if result.data.get("dry_run"):
                            print("🔍 Dry run - would add triaged wiki note:")
                        else:
                            print(f"✅ {result.data.get('message', 'Wiki note added.')}")
                        print(f"   Note: {result.data.get('note_path')}")
                        print(f"   Intent: {result.data.get('intent')}")
                        print(f"   Status: {result.data.get('status')}")
                        print(f"   Destination: {result.data.get('destination')}")
                    elif args.action == "query":
                        count = result.data.get("count", 0)
                        print(f"✅ {result.data.get('message', f'Found {count} page(s).')}")
                        for entry in result.data.get("results", []):
                            print(f"   • {entry.get('title')} ({entry.get('path')})")
                            if entry.get("snippet"):
                                print(f"     {entry.get('snippet')}")
                    elif args.action == "add-asset":
                        if result.data.get("dry_run"):
                            print("🔍 Dry run - would add asset-backed wiki note:")
                        else:
                            print(f"✅ {result.data.get('message', 'Asset wiki note added.')}")
                        print(f"   Asset source: {result.data.get('asset_source')}")
                        print(f"   Asset stored: {result.data.get('asset_stored_path')}")
                        print(f"   Note: {result.data.get('note_path')}")
                elif args.topic == "graph":
                    if args.action == "related":
                        print(f"\n📊 {result.data['skill']} [{result.data['direction']}, depth={result.data['depth']}]")
                        print(f"   Found {result.data['count']} related skill(s)\n")
                        for r in result.data['related'][:15]:
                            tier_icon = "★" if r['tier'] == 'stable' else ("◆" if r['tier'] == 'growing' else "◇")
                            weight = f" ×{r['weight']:.1f}" if r['weight'] > 1.2 else ""
                            print(f"   {tier_icon} {r['skill']} [{r['topic']}]{weight}")
                            if r['description']:
                                print(f"      {r['description'][:70]}")
                        if result.data['count'] > 15:
                            print(f"\n   ... and {result.data['count'] - 15} more")
                        print()
                    elif args.action == "find":
                        print(f"\n🔍 Search: '{result.data['query']}' ({result.data['count']} match(es))\n")
                        for n in result.data['matches'][:20]:
                            tier_icon = "★" if n.get('tier') == 'stable' else ("◆" if n.get('tier') == 'growing' else "◇")
                            print(f"   {tier_icon} {n['id']} [{n.get('topic', '?')}] ↓{n.get('in_degree', 0)}")
                        print()
                    elif args.action == "info":
                        n = result.data['node']
                        tier_icon = "★" if n.get('tier') == 'stable' else ("◆" if n.get('tier') == 'growing' else "◇")
                        print(f"\n📋 {result.data['skill']}")
                        print(f"   Topic:     {n.get('topic', 'unknown')}")
                        print(f"   Tier:      {tier_icon} {n.get('tier', 'experimental')}")
                        print(f"   Stability: {n.get('stability', 'unknown')}")
                        print(f"   In-links:  {result.data['metrics']['in_degree']}")
                        print(f"   Out-links: {result.data['metrics']['out_degree']}")
                        out_edges = result.data['out_edges']
                        if out_edges:
                            print("\n   Links to:")
                            for e in out_edges[:10]:
                                w = f" ×{e['weight']:.1f}" if e.get('weight', 1) > 1.2 else ""
                                print(f"      → {e['to']}{w}")
                        print()
                    elif args.action == "chain":
                        if result.data['reachable']:
                            path_str = " → ".join(result.data['path'])
                            print(f"\n🔗 Chain ({result.data['hops']} hops):\n   {path_str}\n")
                        else:
                            print(f"\n❌ No path found from {result.data['from']} to {result.data['to']}\n")
                    elif args.action == "list":
                        filters = result.data['filters']
                        filter_str = f"topic={filters['topic']}" if filters['topic'] else "all"
                        if filters['tier']:
                            filter_str += f", tier={filters['tier']}"
                        print(f"\n📚 Skills [{filter_str}] ({result.data['count']} result(s))\n")
                        for n in result.data['skills']:
                            tier_icon = "★" if n.get('tier') == 'stable' else ("◆" if n.get('tier') == 'growing' else "◇")
                            print(f"   {tier_icon} {n['id']:<35} [{n.get('topic', '?')}] ↓{n.get('in_degree', 0)}")
                        print()
                    elif args.action == "topics":
                        print(f"\n🏷️  Topic Clusters ({result.data['count']} topics)\n")
                        for topic, count in result.data['topics'].items():
                            print(f"   {topic:<25} {count} skill(s)")
                        print()
            else:
                parser.print_help()
        else:
            # Enhanced error output with examples
            error = result.errors[0] if result.errors else ErrorObject(code=ErrorCode.ERR_RUNTIME, message="Unknown error")
            if args.topic == "skills" and args.action == "route" and result.data.get("decision"):
                decision = result.data["decision"]
                print(f"🧭 Route decision: {decision.get('decision_status', 'unknown')}")
                if decision.get("failure_class"):
                    print(f"Failure class: {decision['failure_class']}")
                if decision.get("operator_action"):
                    print(f"Operator action: {decision['operator_action']}")
                if decision.get("ambiguity_set"):
                    print("Ambiguity set:")
                    for candidate in decision["ambiguity_set"]:
                        print(
                            f"  - {candidate.get('name')} ({candidate.get('path')}) "
                            f"confidence={candidate.get('confidence', 0.0):.4f}"
                        )
                print("")
            if args.topic == "skills" and args.action == "goal" and result.data.get("goal_decision"):
                goal = result.data["goal_decision"]
                print(f"🎯 Goal decision: {goal.get('decision_status', 'unknown')}")
                if goal.get("failure_class"):
                    print(f"Failure class: {goal['failure_class']}")
                if goal.get("operator_action"):
                    print(f"Operator action: {goal['operator_action']}")
                prompts = goal.get("disambiguation_prompts") or []
                if prompts:
                    print("Disambiguation prompts:")
                    for prompt in prompts:
                        print(f"  - {prompt}")
                print("")
            error_message = error.message
            if args.topic == "skills" and args.action == "audit" and " First failures:" in error_message:
                error_message = error_message.split(" First failures:", 1)[0]
            print(f"❌ Error: {error_message}")

                # Add fix suggestion if available
            if error.fix_suggestion:
                print(f"\n💡 {error.fix_suggestion}")

                # Add examples based on the current context
            if args.topic == "skills":
                if args.action == "audit":
                    family_data = result.data.get("family_benchmarks")
                    if isinstance(family_data, dict) and int(family_data.get("exit_code", 0) or 0) != 0:
                        fail_lines = extract_family_fail_lines(str(family_data.get("stdout", "")))
                        if fail_lines:
                            print("\n🔎 Family benchmark failures (first 3):")
                            for fail in fail_lines[:3]:
                                print(f"   - {fail}")
                            remaining = len(fail_lines) - 3
                            if remaining > 0:
                                print(f"   ... and {remaining} more (use --json for full details)")
                        else:
                            for raw_line in str(family_data.get("stderr", "")).splitlines():
                                line = raw_line.strip()
                                if line:
                                    print("\n🔎 Family benchmark error:")
                                    print(f"   {line}")
                                    break
                    if "diagnostics" in result.data: print(result.data["diagnostics"]["stdout"])
                    if "security_gate" in result.data: print(result.data["security_gate"]["stdout"])
                    print("\n📚 Audit examples:")
                    print("   ask skills audit backend-platform/cli-spec --level compat")
                    print("   ask skills audit backend-platform/cli-spec --level strict")
                    print("   ask skills audit Plugins/skill-factory/skills/code_quality_review/skill-builder --level strict")
                elif args.action in ("install", "fold", "init"):
                    if "raw_output" in result.data: print(result.data["raw_output"])
                    if "raw_error" in result.data: print(result.data["raw_error"])
                    if args.action == "init":
                        print("\n📚 Init examples:")
                        print("   ask skills init my-skill --category frontend-ui --description 'Does X'")
                        print("   ask skills init security-guard --category security-ops --description 'Validates Y'")
                    elif args.action == "install":
                        print("\n📚 Install examples:")
                        print("   ask skills install https://github.com/user/repo --remediate")
            elif args.topic == "plugins" and args.action in ("init", "create", "install", "import", "harden", "sync-local-runtime"):
                if "raw_output" in result.data: print(result.data["raw_output"])
                if "raw_error" in result.data: print(result.data["raw_error"])
                # Display command_runs for harden_plugin() failures
                if "command_runs" in result.data:
                    print("\n🔧 Command execution details:")
                    for run in result.data["command_runs"]:
                        print(f"\n  Step: {run.get('step')}")
                        print(f"  Command: {run.get('command')}")
                        print(f"  Return code: {run.get('returncode')}")
                        if run.get('stdout'):
                            if getattr(args, 'verbose', False):
                                print(f"  Stdout:\n{repr(run.get('stdout'))}")
                            else:
                                print("  (Stdout elided. Use --verbose to view)")
                        if run.get('stderr'):
                            if getattr(args, 'verbose', False):
                                print(f"  Stderr:\n{repr(run.get('stderr'))}")
                            else:
                                print("  (Stderr elided. Use --verbose to view)")
                print("\n📚 Plugin examples:")
                print("   ask plugins init my-plugin --category third-party --with-marketplace")
                print("   ask plugins install https://github.com/<owner>/<repo> --path Plugins/<name>")
                print("   ask plugins harden Plugins/my-plugin")
                print("   ask plugins sync-local-runtime")
            elif args.topic == "evals":
                if "raw_output" in result.data: print(result.data["raw_output"])
                if "raw_error" in result.data: print(result.data["raw_error"])
                print("\n📚 Eval examples:")
                print("   ask evals run backend/cli-spec --mode smoke")
                print("   ask evals run backend/cli-spec --mode release")
            elif args.topic == "graph":
                print("\n📚 Graph examples:")
                print("   ask graph find security")
                print("   ask graph related skill-builder --depth 2")
                print("   ask graph chain skill-creator skill-installer")
                print("   ask graph info cli-spec")
            elif args.topic == "repo":
                if args.action == "validate":
                    print(result.data.get("raw_output", ""))
                if args.action == "check-stability" and "errors" in result.data:
                    for e in result.data["errors"]:
                        print(f"   ERROR: {e}")
                print("\n📚 Repo examples:")
                print("   ask repo status")
                print("   ask repo validate --ephemeral")
                print("   ask repo doctor-catalog --strict")
                print("   ask repo check-stability --changed-files backend/cli-spec/SKILL.md")
            elif args.topic == "mcp":
                print("\n📚 MCP examples:")
                print("   ask mcp sync")
                print("   ask mcp sync --dry-run")
            elif args.topic == "wiki":
                print("\n📚 Wiki examples:")
                print("   ask wiki lint")
                print("   ask wiki ingest 'Title' --summary 'Summary' --source '<source>'")
                print("   ask wiki add --interactive")
                print("   ask wiki query 'prompt injection'")
                print("   ask wiki add-asset ./tmp/screenshot.png --title 'UI reference' --summary 'Capture for reuse'")
                print("   ask wiki add-asset --interactive")

    # Semantic Exit Code
    if result.status == "success":
        sys.exit(0)
    else:
        error_code = result.errors[0].code if result.errors else "ERR_RUNTIME"
        sys.exit(ERROR_MAP.get(error_code, 1))

if __name__ == "__main__":
    main()
