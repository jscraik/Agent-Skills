#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
  link_target="$(readlink "${script_path}")"
  if [[ "${link_target}" == /* ]]; then
    script_path="${link_target}"
  else
    script_path="$(cd -- "$(dirname -- "${script_path}")" && pwd -P)/${link_target}"
  fi
done
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/../.." && pwd -P)"
plugin_root="${repo_root}/Plugins/cache/openai-curated/plugin-eval"

cli_path="$(find "${plugin_root}" -type f -path '*/scripts/plugin-eval.js' | sort | tail -n 1 || true)"
if [[ -z "${cli_path}" ]]; then
  echo "plugin-eval CLI not found under ${plugin_root}" >&2
  exit 1
fi

exec node "${cli_path}" "$@"
