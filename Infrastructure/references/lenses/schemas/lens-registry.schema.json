{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-lens-registry.v1",
  "title": "Skills SDK Lens Registry",
  "type": "object",
  "required": ["version", "catalog_id", "lenses"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "priority", "triggers"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "triggers": {
            "type": "object",
            "required": ["keywords", "task_intents", "file_signals"],
            "additionalProperties": false,
            "properties": {
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "task_intents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "file_signals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
