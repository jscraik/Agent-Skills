{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/agent-skills/schemas/skill-lens.v1.schema.json",
  "title": "Skill SDK Lens",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "version",
    "status",
    "triggers",
    "strengths",
    "priority"
  ],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "type": {"const": "expert_lens"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "stable", "deprecated"]},
    "triggers": {
      "type": "object",
      "required": ["keywords", "task_intents"],
      "properties": {
        "keywords": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "task_intents": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "file_signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "strengths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "avoid_when": {"type": "array"},
    "pairs_well_with": {"type": "array", "items": {"type": "string"}},
    "output_categories": {"type": "array", "items": {"type": "string"}},
    "priority": {"type": "integer", "minimum": 0}
  }
}
