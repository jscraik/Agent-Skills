[MASTER]
ignore=.git,.ruff_cache,.pytest_cache,Plugins/cache,.agents/plugins-runtime
init-hook='import sys; sys.path.insert(0, "Infrastructure/scripts/lifecycle-and-sync")'
jobs=1
persistent=no

[MESSAGES CONTROL]
disable=
    broad-exception-caught,
    duplicate-code,
    line-too-long,
    missing-class-docstring,
    missing-function-docstring,
    missing-module-docstring,
    protected-access,
    too-few-public-methods

# Infrastructure validators intentionally keep moderate branching/local limits:
# many scripts validate several file contracts in one command boundary.
[DESIGN]
max-args=8
max-attributes=12
max-branches=20
max-locals=24
max-returns=10
max-statements=80

[REPORTS]
output-format=text
reports=no
score=no

[TYPECHECK]
ignored-modules=yaml
