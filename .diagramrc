# Diagram CLI configuration
# See: https://github.com/jscraik/diagram-cli

# Patterns to exclude from analysis
exclude:
  - "**/node_modules/**"
  - "**/.git/**"
  - "**/dist/**"
  - "**/build/**"
  - "**/.next/**"
  - "**/coverage/**"
  - "**/*.test.ts"
  - "**/*.spec.ts"
  - "**/__tests__/**"

# Output defaults
output:
  format: mermaid
  directory: artifacts/diagrams

# Analysis options
analysis:
  maxDepth: 10
  groupBy: directory
