#!/usr/bin/env python3
"""Stable public wrapper for the repo-local Plugin Eval CLI."""

import os
import sys
from pathlib import Path


def main() -> None:
    repo_root = Path(__file__).resolve().parents[1]
    target = repo_root / "Infrastructure" / "bin" / "plugin-eval"
    os.execv(str(target), [str(target), *sys.argv[1:]])


if __name__ == "__main__":
    main()
