#!/usr/bin/env python3
"""Stable public wrapper for the canonical ask implementation."""

import os
import shutil
import sys
from pathlib import Path
from typing import Optional

def _uv_executable() -> Optional[str]:
    discovered = shutil.which("uv")
    if discovered:
        return discovered
    for candidate in ("/opt/homebrew/bin/uv", "/usr/local/bin/uv"):
        if _is_executable_file(candidate):
            return candidate
    return None


def _is_executable_file(candidate: str) -> bool:
    candidate_path = Path(candidate)
    return candidate_path.is_file() and os.access(candidate_path, os.X_OK)


def _exec_target(repo_root: Path, target: Path, args: list[str]) -> None:
    uv = _uv_executable()
    if uv is None:
        if sys.version_info < (3, 12):
            print(
                "error: ./bin/ask requires uv or Python 3.12+ for the documented fallback.",
                file=sys.stderr,
            )
            raise SystemExit(127)
        os.execv(sys.executable, [sys.executable, str(target), *args])
        return
    os.execv(
        uv,
        [
            uv,
            "run",
            "--frozen",
            "--project",
            str(repo_root / "Infrastructure"),
            "--python",
            "3.12",
            "python",
            str(target),
            *args,
        ],
    )


def main() -> None:
    repo_root = Path(__file__).resolve().parents[1]
    target = repo_root / "Infrastructure" / "bin" / "ask"
    _exec_target(repo_root, target, sys.argv[1:])


if __name__ == "__main__":
    main()
