#!/usr/bin/env python3
"""Stable public wrapper for the canonical ask implementation."""

import os
import shutil
import sys
from pathlib import Path
from typing import Optional

MIN_PYTHON = (3, 12)


def _uv_executable() -> Optional[str]:
    discovered = shutil.which("uv")
    if discovered:
        return discovered
    for candidate in ("/opt/homebrew/bin/uv", "/usr/local/bin/uv"):
        if Path(candidate).exists():
            return candidate
    return None


def _exec_target(repo_root: Path, target: Path, args: list[str]) -> None:
    if sys.version_info >= MIN_PYTHON:
        os.execv(sys.executable, [sys.executable, str(target), *args])
    uv = _uv_executable()
    if uv is None:
        print("error: ./bin/ask requires Python 3.12+ or uv on PATH to select the repo Python.", file=sys.stderr)
        raise SystemExit(127)
    os.execv(
        uv,
        [
            uv,
            "run",
            "--project",
            str(repo_root / "Infrastructure"),
            "--python",
            "3.12",
            "python",
            str(target),
            *args,
        ],
    )


def main() -> None:
    repo_root = Path(__file__).resolve().parents[1]
    target = repo_root / "Infrastructure" / "bin" / "ask"
    _exec_target(repo_root, target, sys.argv[1:])


if __name__ == "__main__":
    main()
