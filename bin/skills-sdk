#!/usr/bin/env python3
"""Stable public wrapper for the Skills SDK product facade."""

import os
import sys
from pathlib import Path


def main() -> None:
    repo_root = Path(__file__).resolve().parents[1]
    target = repo_root / "Infrastructure" / "bin" / "ask"
    os.execv(str(target), [str(target), "sdk", *sys.argv[1:]])


if __name__ == "__main__":
    main()
