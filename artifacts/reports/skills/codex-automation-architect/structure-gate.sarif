{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PI_TOOL_CHAIN",
              "name": "PI_TOOL_CHAIN",
              "shortDescription": {
                "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_SCOPE_BROAD",
              "name": "RESEARCH_SCOPE_BROAD",
              "shortDescription": {
                "text": "Skill/package scope may be too broad for a first pass. Add explicit guidance like 'start with 2-3 focused surfaces' or 'keep scope tight'."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PI_TOOL_CHAIN",
          "level": "warning",
          "message": {
            "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior. | SKILL.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utilities/codex-automation-architect/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/6"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utilities/codex-automation-architect/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utilities/codex-automation-architect/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_SCOPE_BROAD",
          "level": "warning",
          "message": {
            "text": "Skill/package scope may be too broad for a first pass. Add explicit guidance like 'start with 2-3 focused surfaces' or 'keep scope tight'. | surfaces=5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "utilities/codex-automation-architect/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
