{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PI_COMMANDS",
              "name": "PI_COMMANDS",
              "shortDescription": {
                "text": "[medium] Command-like instructions detected; ensure commands are gated and safe."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PI_COMMANDS",
          "level": "warning",
          "message": {
            "text": "[medium] Command-like instructions detected; ensure commands are gated and safe. | references/project-tailored-agents-baseline.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/docs/agents-md/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
