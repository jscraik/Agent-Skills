{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_UNTRUSTED_TO_COMMAND",
              "name": "SAFE_UNTRUSTED_TO_COMMAND",
              "shortDescription": {
                "text": "Untrusted input appears to flow into command execution without clear sanitization/argument-list hardening."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EXAMPLES_MISSING",
              "name": "SEC_EXAMPLES_MISSING",
              "shortDescription": {
                "text": "Missing recommended section: examples (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_UNTRUSTED_TO_COMMAND",
          "level": "warning",
          "message": {
            "text": "Untrusted input appears to flow into command execution without clear sanitization/argument-list hardening. | scripts/build_ownership_map.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_UNTRUSTED_TO_COMMAND",
          "level": "warning",
          "message": {
            "text": "Untrusted input appears to flow into command execution without clear sanitization/argument-list hardening. | scripts/community_maintainers.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_UNTRUSTED_TO_COMMAND",
          "level": "warning",
          "message": {
            "text": "Untrusted input appears to flow into command execution without clear sanitization/argument-list hardening. | scripts/run_ownership_map.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EXAMPLES_MISSING",
          "level": "warning",
          "message": {
            "text": "Missing recommended section: examples (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/security/security-ownership-map/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
