{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "OUT_SCHEMA_VERSION_MISSING",
              "name": "OUT_SCHEMA_VERSION_MISSING",
              "shortDescription": {
                "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_COMMANDS",
              "name": "PI_COMMANDS",
              "shortDescription": {
                "text": "[medium] Command-like instructions detected; ensure commands are gated and safe."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_OBFUSCATION",
              "name": "PI_OBFUSCATION",
              "shortDescription": {
                "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "PI_TOOL_CHAIN",
              "name": "PI_TOOL_CHAIN",
              "shortDescription": {
                "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "WF_FAIL_FAST_MISSING",
              "name": "WF_FAIL_FAST_MISSING",
              "shortDescription": {
                "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "OUT_SCHEMA_VERSION_MISSING",
          "level": "warning",
          "message": {
            "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_COMMANDS",
          "level": "warning",
          "message": {
            "text": "[medium] Command-like instructions detected; ensure commands are gated and safe. | README.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_COMMANDS",
          "level": "warning",
          "message": {
            "text": "[medium] Command-like instructions detected; ensure commands are gated and safe. | resources/stitch-api-reference.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_OBFUSCATION",
          "level": "warning",
          "message": {
            "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks. | README.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_OBFUSCATION",
          "level": "warning",
          "message": {
            "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks. | resources/architecture-checklist.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_OBFUSCATION",
          "level": "warning",
          "message": {
            "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks. | scripts/validate.js"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "PI_TOOL_CHAIN",
          "level": "warning",
          "message": {
            "text": "[high] High-risk control language detected; verify this does not instruct unsafe behavior. | README.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "WF_FAIL_FAST_MISSING",
          "level": "warning",
          "message": {
            "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/stitch-react-components/SKILL.md"
                }
              }
