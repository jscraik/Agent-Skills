{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "OUT_SCHEMA_VERSION_MISSING",
              "name": "OUT_SCHEMA_VERSION_MISSING",
              "shortDescription": {
                "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_ALLOWLIST",
              "name": "SAFE_NETWORK_ALLOWLIST",
              "shortDescription": {
                "text": "Network usage detected in scripts without an explicit domain/host allowlist policy in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_UNDECLARED",
              "name": "SAFE_NETWORK_UNDECLARED",
              "shortDescription": {
                "text": "Network usage detected in scripts but SKILL.md does not explicitly describe network requirements/constraints. Default to offline; gate behind --allow-network if needed."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_URL_ALLOWLIST",
              "name": "SAFE_NETWORK_URL_ALLOWLIST",
              "shortDescription": {
                "text": "Hard-coded URL(s) detected in scripts; document explicit allowed domains/hosts in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EXAMPLES_MISSING",
              "name": "SEC_EXAMPLES_MISSING",
              "shortDescription": {
                "text": "Missing recommended section: examples (add a ## heading)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "OUT_SCHEMA_VERSION_MISSING",
          "level": "warning",
          "message": {
            "text": "Schema-bound outputs detected; consider including `schema_version` in the output contract."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=1/3"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_NETWORK_ALLOWLIST",
          "level": "warning",
          "message": {
            "text": "Network usage detected in scripts without an explicit domain/host allowlist policy in SKILL.md. | scripts/download-stitch-asset.sh"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_NETWORK_UNDECLARED",
          "level": "warning",
          "message": {
            "text": "Network usage detected in scripts but SKILL.md does not explicitly describe network requirements/constraints. Default to offline; gate behind --allow-network if needed. | scripts/download-stitch-asset.sh"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_NETWORK_URL_ALLOWLIST",
          "level": "warning",
          "message": {
            "text": "Hard-coded URL(s) detected in scripts; document explicit allowed domains/hosts in SKILL.md. | scripts/download-stitch-asset.sh"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EXAMPLES_MISSING",
          "level": "warning",
          "message": {
            "text": "Missing recommended section: examples (add a ## heading)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/ui/stitch-remotion/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
