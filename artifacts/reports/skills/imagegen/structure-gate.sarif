{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "PI_OBFUSCATION",
              "name": "PI_OBFUSCATION",
              "shortDescription": {
                "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "REPO_ASSETS_UNREFERENCED",
              "name": "REPO_ASSETS_UNREFERENCED",
              "shortDescription": {
                "text": "assets/ exists but is not referenced in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "WF_FAIL_FAST_MISSING",
              "name": "WF_FAIL_FAST_MISSING",
              "shortDescription": {
                "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "PI_OBFUSCATION",
          "level": "warning",
          "message": {
            "text": "[high] Potential obfuscation / hidden-instruction language detected; verify it cannot bypass safety checks. | scripts/image_gen.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "REPO_ASSETS_UNREFERENCED",
          "level": "warning",
          "message": {
            "text": "assets/ exists but is not referenced in SKILL.md."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/5"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "WF_FAIL_FAST_MISSING",
          "level": "warning",
          "message": {
            "text": "Validation section should specify fail-fast behavior (stop at first failed gate)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/graphics/imagegen/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
