{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill_gate",
          "informationUri": "https://github.com/openai/skills",
          "rules": [
            {
              "id": "RESEARCH_EVALS_UNREALISTIC",
              "name": "RESEARCH_EVALS_UNREALISTIC",
              "shortDescription": {
                "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_EXAMPLES_SYNTHETIC",
              "name": "RESEARCH_EXAMPLES_SYNTHETIC",
              "shortDescription": {
                "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "RESEARCH_SCOPE_BROAD",
              "name": "RESEARCH_SCOPE_BROAD",
              "shortDescription": {
                "text": "Skill/package scope may be too broad for a first pass. Add explicit guidance like 'start with 2-3 focused surfaces' or 'keep scope tight'."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_ALLOWLIST",
              "name": "SAFE_NETWORK_ALLOWLIST",
              "shortDescription": {
                "text": "Network usage detected in scripts without an explicit domain/host allowlist policy in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SAFE_NETWORK_URL_ALLOWLIST",
              "name": "SAFE_NETWORK_URL_ALLOWLIST",
              "shortDescription": {
                "text": "Hard-coded URL(s) detected in scripts; document explicit allowed domains/hosts in SKILL.md."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "name": "SEC_EVALS_COMMAND_GUARD_MISSING",
              "shortDescription": {
                "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat)."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_NEGATIVE_MISSING",
              "name": "SEC_EVALS_NEGATIVE_MISSING",
              "shortDescription": {
                "text": "No negative/non-trigger security case detected in evals.yaml. Add `category: negative` or `should_trigger: false` coverage."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PI_CASE_MISSING",
              "name": "SEC_EVALS_PI_CASE_MISSING",
              "shortDescription": {
                "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            },
            {
              "id": "SEC_EVALS_PRESSURE_MISSING",
              "name": "SEC_EVALS_PRESSURE_MISSING",
              "shortDescription": {
                "text": "No pressure/adversarial case detected in evals.yaml. Add at least one `category: pressure` case."
              },
              "properties": {
                "defaultSeverity": "warn"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "RESEARCH_EVALS_UNREALISTIC",
          "level": "warning",
          "message": {
            "text": "Positive eval prompts look synthetic. Rewrite more prompts as realistic user utterances. | realistic=0/3"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_EXAMPLES_SYNTHETIC",
          "level": "warning",
          "message": {
            "text": "Examples look abstract or template-like. Prefer realistic user requests and concrete workflows. | ## Examples"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "RESEARCH_SCOPE_BROAD",
          "level": "warning",
          "message": {
            "text": "Skill/package scope may be too broad for a first pass. Add explicit guidance like 'start with 2-3 focused surfaces' or 'keep scope tight'. | surfaces=4"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_NETWORK_ALLOWLIST",
          "level": "warning",
          "message": {
            "text": "Network usage detected in scripts without an explicit domain/host allowlist policy in SKILL.md. | scripts/oak_api_fetch.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SAFE_NETWORK_URL_ALLOWLIST",
          "level": "warning",
          "message": {
            "text": "Hard-coded URL(s) detected in scripts; document explicit allowed domains/hosts in SKILL.md. | scripts/oak_api_fetch.py"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_COMMAND_GUARD_MISSING",
          "level": "warning",
          "message": {
            "text": "No deterministic risky-command guard detected. Add forbidden command checks (e.g., curl/wget/rm -rf/netcat). | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_NEGATIVE_MISSING",
          "level": "warning",
          "message": {
            "text": "No negative/non-trigger security case detected in evals.yaml. Add `category: negative` or `should_trigger: false` coverage. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PI_CASE_MISSING",
          "level": "warning",
          "message": {
            "text": "No prompt-injection/jailbreak-style prompt detected in evals.yaml. Add one adversarial PI prompt case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC_EVALS_PRESSURE_MISSING",
          "level": "warning",
          "message": {
            "text": "No pressure/adversarial case detected in evals.yaml. Add at least one `category: pressure` case. | references/evals.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "product/domain/oak-api/SKILL.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
