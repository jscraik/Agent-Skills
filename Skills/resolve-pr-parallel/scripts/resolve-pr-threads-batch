#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: resolve-pr-threads-batch THREAD_ID [THREAD_ID ...]" >&2
  echo "Example: resolve-pr-threads-batch PRRT_kwDOABC123 PRRT_kwDOABC456" >&2
  exit 1
fi

mutation='mutation ResolveReviewThreads {'
index=1

for thread_id in "$@"; do
  mutation+=$'\n'"  t${index}: resolveReviewThread(input: {threadId: \"${thread_id}\"}) { thread { id isResolved path line } }"
  index=$((index + 1))
done

mutation+=$'\n''}'

gh api graphql -f query="$mutation"
