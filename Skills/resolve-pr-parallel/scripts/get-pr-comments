#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: get-pr-comments PR_NUMBER [OWNER/REPO]" >&2
  echo "Example: get-pr-comments 123" >&2
  echo "Example: get-pr-comments 123 EveryInc/cora" >&2
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage
  exit 1
fi

pr_number="$1"
repo_slug="${2:-}"

if [[ -z "$repo_slug" ]]; then
  repo_slug="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
fi

if [[ -z "$repo_slug" || "$repo_slug" != */* ]]; then
  echo "Error: Could not detect repository. Pass OWNER/REPO as the second argument." >&2
  exit 1
fi

owner="${repo_slug%%/*}"
repo="${repo_slug#*/}"
cursor=""
threads='[]'

read -r -d '' query <<'GRAPHQL' || true
query FetchUnresolvedComments($owner: String!, $repo: String!, $pr: Int!, $cursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      title
      url
      reviewThreads(first: 100, after: $cursor) {
        pageInfo {
          hasNextPage
          endCursor
        }
        nodes {
          id
          isResolved
          isOutdated
          isCollapsed
          path
          line
          startLine
          diffSide
          comments(first: 100) {
            totalCount
            nodes {
              id
              author {
                login
              }
              body
              createdAt
              updatedAt
              url
              outdated
            }
          }
        }
      }
    }
  }
}
GRAPHQL

while :; do
  if [[ -n "$cursor" ]]; then
    response="$(
      gh api graphql \
        -f owner="$owner" \
        -f repo="$repo" \
        -F pr="$pr_number" \
        -f cursor="$cursor" \
        -f query="$query"
    )"
  else
    response="$(
      gh api graphql \
        -f owner="$owner" \
        -f repo="$repo" \
        -F pr="$pr_number" \
        -f query="$query"
    )"
  fi

  if jq -e '.data.repository.pullRequest == null' >/dev/null 2>&1 <<<"$response"; then
    echo "Error: Could not resolve pull request ${pr_number} in ${owner}/${repo}." >&2
    exit 1
  fi

  page_threads="$(
    jq '
      .data.repository.pullRequest.reviewThreads.nodes
      | map(
          select(.isResolved == false and .isOutdated == false)
          | {
              thread_id: .id,
              path: .path,
              line: .line,
              start_line: .startLine,
              diff_side: .diffSide,
              comment_count: .comments.totalCount,
              comments: [
                .comments.nodes[]
                | {
                    id: .id,
                    author: (.author.login // "unknown"),
                    body: .body,
                    created_at: .createdAt,
                    updated_at: .updatedAt,
                    url: .url,
                    outdated: .outdated
                  }
              ]
            }
        )
    ' <<<"$response"
  )"

  threads="$(jq -n --argjson existing "$threads" --argjson page "$page_threads" '$existing + $page')"

  has_next="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage' <<<"$response")"
  if [[ "$has_next" != "true" ]]; then
    break
  fi

  cursor="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor' <<<"$response")"
done

printf '%s\n' "$threads"
