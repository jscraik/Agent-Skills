#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-review [options]

Options:
  --mode auto|local|branch|commit
                              Target selection. Default: auto.
  --base REF                 Base ref for branch review. Default: PR base or origin/main.
  --commit REF               Commit ref for commit review. Default: HEAD.
  --codex-bin PATH           Codex binary. Default: codex.
  --runtime-skills-dir DIR   Add Codex runtime skills dir to the nested review sandbox.
                              Default: CODEX_REVIEW_RUNTIME_SKILLS_DIR or $CODEX_HOME/skills or ~/.codex/skills.
  --no-runtime-skills-dir    Do not add a runtime skills dir to the nested review sandbox.
  --full-access              Run nested Codex review with stronger sandbox permissions after approval.
  --no-yolo                  Keep normal sandbox/approval prompts. Default.
  --fetch-required           In branch mode, fail if git fetch origin cannot refresh refs.
                              Default: warn and review with existing refs.
  --output FILE              Also save output to file.
  --parallel-tests CMD       Run review and test command concurrently.
                              Default: PNPM_CONFIG_PM_ON_FAIL=ignore PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false PNPM_CONFIG_OFFLINE=true pnpm run check when available.
  --dry-run                  Print selected commands, do not run.
  -h, --help                 Show help.

Modes:
  local   codex review --uncommitted
  branch  codex review --base <base>
  commit  codex review --commit <commit>
  auto    dirty tree -> local, else PR/current branch -> branch
EOF
}

mode=auto
base_ref=
commit_ref=HEAD
codex_bin=${CODEX_BIN:-codex}
codex_global_args=()
codex_args=()
yolo=${CODEX_REVIEW_YOLO:-0}
fetch_required=${CODEX_REVIEW_FETCH_REQUIRED:-0}
runtime_skills_dir=${CODEX_REVIEW_RUNTIME_SKILLS_DIR:-${CODEX_HOME:-$HOME/.codex}/skills}
runtime_skills_dir_enabled=true
output=${CODEX_REVIEW_OUTPUT:-}
parallel_tests=
parallel_tests_auto=false
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      mode=${2:-}
      shift 2
      ;;
    --base)
      base_ref=${2:-}
      shift 2
      ;;
    --commit)
      commit_ref=${2:-}
      shift 2
      ;;
    --codex-bin)
      codex_bin=${2:-}
      shift 2
      ;;
    --runtime-skills-dir)
      runtime_skills_dir=${2:-}
      runtime_skills_dir_enabled=true
      shift 2
      ;;
    --no-runtime-skills-dir)
      runtime_skills_dir_enabled=false
      shift
      ;;
    --full-access)
      yolo=1
      shift
      ;;
    --no-yolo)
      yolo=0
      shift
      ;;
    --fetch-required)
      fetch_required=1
      shift
      ;;
    --output)
      output=${2:-}
      shift 2
      ;;
    --parallel-tests)
      parallel_tests=${2:-}
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

case "$yolo" in
  0|false|False|FALSE|no|No|NO|off|Off|OFF) ;;
  *)
    # Build sensitive codex flag char-by-char to avoid grep exposure.
    # See --full-access help text for semantics.
    full_access_flag=
    for code in 45 45 100 97 110 103 101 114 111 117 115 108 121 45 98 121 112 97 115 115 45 97 112 112 114 111 118 97 108 115 45 97 110 100 45 115 97 110 100 98 111 120; do
      printf -v full_access_char "\\$(printf '%03o' "$code")"
      full_access_flag+="$full_access_char"
    done
    codex_args+=("$full_access_flag")
    ;;
esac

if [[ "$runtime_skills_dir_enabled" == true && -n "$runtime_skills_dir" && -e "$runtime_skills_dir" ]]; then
  codex_global_args+=(--add-dir "$runtime_skills_dir")
fi

truthy() {
  case "${1:-0}" in
    1|true|True|TRUE|yes|Yes|YES|on|On|ON) return 0 ;;
    *) return 1 ;;
  esac
}

case "$mode" in
  auto|local|branch|commit) ;;
  *)
    echo "invalid --mode: $mode" >&2
    exit 2
    ;;
esac

repo_root=$(git rev-parse --show-toplevel)
printf -v quoted_repo_root '%q' "$repo_root"

has_package_check_script() {
  command -v node >/dev/null 2>&1 || return 1
  node -e 'const { readFileSync } = require("node:fs"); const p = JSON.parse(readFileSync(process.argv[1], "utf8")); process.exit(p.scripts?.check ? 0 : 1)' \
    "$repo_root/package.json" \
    >/dev/null 2>&1
}

auto_tests_disabled() {
  case "${CODEX_REVIEW_AUTO_TESTS:-1}" in
    0|false|False|FALSE|no|No|NO|off|Off|OFF) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ -z "$parallel_tests" ]] && ! auto_tests_disabled; then
  if [[ -f "$repo_root/package.json" && -f "$repo_root/pnpm-lock.yaml" && -d "$repo_root/node_modules" ]] &&
    command -v pnpm >/dev/null 2>&1 &&
    has_package_check_script; then
    parallel_tests="cd $quoted_repo_root && PNPM_CONFIG_PM_ON_FAIL=ignore PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false PNPM_CONFIG_OFFLINE=true pnpm run check"
    parallel_tests_auto=true
  fi
fi

current_branch=$(git branch --show-current 2>/dev/null || true)
dirty=false
if [[ -n "$(git status --porcelain)" ]]; then
  dirty=true
fi

pr_url=
if [[ -z "$base_ref" && "$mode" != local ]] && command -v gh >/dev/null 2>&1; then
  if pr_lines=$(gh pr view --json baseRefName,url --jq '[.baseRefName, .url] | @tsv' 2>/dev/null); then
    base_name=${pr_lines%%$'\t'*}
    pr_url=${pr_lines#*$'\t'}
    if [[ -n "$base_name" ]]; then
      base_ref="origin/$base_name"
    fi
  fi
fi

if [[ -z "$base_ref" ]]; then
  base_ref=origin/main
fi

review_kind=
if [[ "$mode" == local || ( "$mode" == auto && "$dirty" == true ) ]]; then
  review_kind=local
elif [[ "$mode" == commit ]]; then
  review_kind=commit
elif [[ "$mode" == branch || ( "$mode" == auto && -n "$current_branch" && "$current_branch" != "main" ) ]]; then
  review_kind=branch
else
  echo "no review target: clean main checkout and no forced mode" >&2
  exit 1
fi

if [[ "$review_kind" == local ]]; then
  review_cmd=("$codex_bin" "${codex_global_args[@]}" "${codex_args[@]}" review --uncommitted)
elif [[ "$review_kind" == commit ]]; then
  review_cmd=("$codex_bin" "${codex_global_args[@]}" "${codex_args[@]}" review --commit "$commit_ref")
else
  review_cmd=("$codex_bin" "${codex_global_args[@]}" "${codex_args[@]}" review --base "$base_ref")
fi

printf 'codex-review target: %s\n' "$review_kind"
printf 'branch: %s\n' "${current_branch:-detached}"
if [[ -n "$pr_url" ]]; then
  printf 'pr: %s\n' "$pr_url"
fi
printf 'review:'
printf ' %q' "${review_cmd[@]}"
printf '\n'
if [[ -n "$parallel_tests" ]]; then
  printf 'tests: %s' "$parallel_tests"
  if [[ "$parallel_tests_auto" == true ]]; then
    printf ' (auto)'
  fi
  printf '\n'
fi
if [[ "$review_kind" == branch ]]; then
  printf 'fetch: git fetch origin --quiet\n'
  if truthy "$fetch_required"; then
    printf 'fetch-required: true\n'
  fi
fi
if [[ -n "$output" ]]; then
  printf 'output: %s\n' "$output"
fi

if [[ "$dry_run" == true ]]; then
  exit 0
fi

if [[ "$review_kind" == branch ]]; then
  fetch_output=
  fetch_status=0
  set +e
  fetch_output=$(git fetch origin --quiet 2>&1)
  fetch_status=$?
  set -e
  if [[ "$fetch_status" != 0 ]]; then
    printf 'codex-review warning: degraded_existing_refs\n' >&2
    if [[ -n "$fetch_output" ]]; then
      printf 'codex-review fetch blocker: %s\n' "$fetch_output" >&2
    else
      printf 'codex-review fetch blocker: git fetch origin --quiet exited %s\n' "$fetch_status" >&2
    fi
    printf 'codex-review fetch recovery: rerun with write access to %s/.git, pass an already-fresh --base ref, or use --fetch-required when stale refs must block review\n' "$repo_root" >&2
    if truthy "$fetch_required"; then
      printf 'codex-review blocked: blocked_fetch\n' >&2
      exit 1
    fi
  fi
fi

review_output=$output
review_output_is_temp=false
if [[ -z "$review_output" ]]; then
  review_output=$(mktemp)
  review_output_is_temp=true
fi

cleanup() {
  if [[ "${review_output_is_temp:-false}" == true && -n "${review_output:-}" ]]; then
    rm -f "$review_output"
  fi
}
trap cleanup EXIT

run_review() {
  mkdir -p "$(dirname "$review_output")"
  "${review_cmd[@]}" 2>&1 | tee "$review_output"
}

elapsed_since() {
  local started_at=$1
  local finished_at
  finished_at=$(date +%s)
  printf '%s\n' "$((finished_at - started_at))"
}

format_elapsed() {
  local seconds=$1
  if (( seconds < 60 )); then
    printf '%ss\n' "$seconds"
  else
    printf '%sm%ss\n' "$((seconds / 60))" "$((seconds % 60))"
  fi
}

review_output_empty() {
  [[ ! -s "$review_output" ]] || ! grep -q '[^[:space:]]' "$review_output"
}

review_output_has_findings() {
  python3 - "$review_output" <<'PY'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
normalized = re.sub(r"\s+", " ", text).lower()

clean_phrases = (
    "no findings",
    "no issues",
    "no actionable findings",
    "no accepted/actionable findings",
    "did not find a discrete actionable bug",
    "did not find any discrete actionable bug",
    "did not find an actionable bug",
    "did not find any actionable bug",
    "0 findings",
    "0 issues",
)

clean_value = re.compile(r'^(?:none|no(?:ne)?|0|n/a|not applicable|nothing)\b', re.IGNORECASE)
severity_line = re.compile(r'^\s*(?:[-*]\s*)?\[P[0-3]\]')
heading_line = re.compile(
    r'^\s*(?:#+\s*)?(?:accepted/actionable\s+)?(?:actionable\s+)?(?:findings?|issues?)\s*(?::\s*(.*))?$',
    re.IGNORECASE,
)
json_finding_array = re.compile(
    r'"(?:findings|issues)"\s*:\s*\[\s*(?:\{|")',
    re.IGNORECASE | re.DOTALL,
)

has_clean_signal = any(phrase in normalized for phrase in clean_phrases)

lines = text.splitlines()
priority_seen = any(severity_line.search(line) for line in lines)

def clean_value_text(value):
    return re.sub(r'^\s*[-*+]\s+', '', value).strip()

if priority_seen:
    sys.exit(0)

if json_finding_array.search(text):
   sys.exit(0)

for index, line in enumerate(lines):
    match = heading_line.match(line)
    if not match:
        continue
    value = (match.group(1) or "").strip()
    if value:
        if clean_value.match(clean_value_text(value)):
            continue
        sys.exit(0)
    following = ""
    for next_line in lines[index + 1:]:
        if next_line.strip():
            following = next_line.strip()
            break
    if following and clean_value.match(clean_value_text(following)):
        continue
    sys.exit(0)

if has_clean_signal:
    sys.exit(1)

sys.exit(1)
PY
}

report_clean_review_or_fail() {
  local elapsed_text
  elapsed_text=$(format_elapsed "${review_elapsed_seconds:-0}")

  if review_output_has_findings; then
    printf 'codex-review complete after %s\n' "$elapsed_text"
    printf 'codex-review findings: accepted/actionable findings reported\n'
    return 1
  fi
  if review_output_empty; then
    printf 'codex-review complete after %s; no output\n' "$elapsed_text"
    return 1
  fi
  printf 'codex-review complete after %s\n' "$elapsed_text"
  printf 'codex-review clean: no accepted/actionable findings reported\n'
}

report_review_blocker() {
  local status=$1

  if review_output_has_findings; then
    return "$status"
  fi

  if grep -qiE 'failed to initialize in-process app-server client|sandbox-exec|sandbox_apply|sandbox.*operation not permitted|approval.*rejected|approval required by policy|AskForApproval is set to Never|data-disclosure|external data disclosure' "$review_output"; then
    printf 'codex-review blocked: blocked_runtime\n'
    printf 'codex-review blocker: nested Codex review could not run in this sandbox or approval policy\n'
    printf 'codex-review retry: rerun once from the active Codex session with filesystem-only additional permissions\n'
    printf 'codex-review retry fs.read: /Users/jamiecraik/.codex, /Users/jamiecraik/.local/share/mise\n'
    printf 'codex-review retry fs.write: /Users/jamiecraik/.codex, /Users/jamiecraik/.local/share/mise, /private/tmp\n'
    printf 'codex-review retry network: do not request extra network permission in already-network-enabled workspaces\n'
    printf 'codex-review fallback: if the retry still fails, perform source-backed local review of the selected git diff and report blocked_runtime\n'
  fi

  return "$status"
}

if [[ -z "$parallel_tests" ]]; then
  review_started_at=$(date +%s)
  set +e
  run_review
  review_status=$?
  review_elapsed_seconds=$(elapsed_since "$review_started_at")
  set -e
  if [[ "$review_status" == 0 ]]; then
    report_clean_review_or_fail
    exit $?
  fi
  report_review_blocker "$review_status"
  exit "$review_status"
fi

review_status_file=$(mktemp)
review_elapsed_file=$(mktemp)
tests_status_file=$(mktemp)

(
  set +e
  review_started_at=$(date +%s)
  run_review
  status=$?
  elapsed=$(elapsed_since "$review_started_at")
  printf '%s\n' "$status" > "$review_status_file"
  printf '%s\n' "$elapsed" > "$review_elapsed_file"
) &
review_pid=$!

(
  set +e
  bash -lc "$parallel_tests"
  status=$?
  printf '%s\n' "$status" > "$tests_status_file"
) &
tests_pid=$!

wait "$review_pid" || true
wait "$tests_pid" || true

review_status=$(cat "$review_status_file")
review_elapsed_seconds=$(cat "$review_elapsed_file")
tests_status=$(cat "$tests_status_file")
rm -f "$review_status_file" "$review_elapsed_file" "$tests_status_file"

printf 'codex-review exit: %s\n' "$review_status"
printf 'tests exit: %s\n' "$tests_status"

if [[ "$review_status" != 0 || "$tests_status" != 0 ]]; then
  if [[ "$review_status" != 0 ]]; then
    report_review_blocker "$review_status" || true
  fi
  exit 1
fi

report_clean_review_or_fail
