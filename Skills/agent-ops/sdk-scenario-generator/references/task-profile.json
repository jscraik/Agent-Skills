{
  "schema_version": "1.0",
  "task": "sdk_scenario_generation",
  "primary_inputs": [
    "SKILL.md",
    "references/contract.yaml",
    "references/evals.yaml",
    "references/evals/*.md",
    "KnowledgeOS extraction output",
    "Tessl scenario drafts",
    "prior Tessl run summaries"
  ],
  "primary_outputs": [
    "gold-standard scenario set",
    "scenario drift review",
    "anti-easy findings",
    "Tessl dry-run staging proof",
    "live readiness decision"
  ],
  "minimum_behavioral_scenarios": 20,
  "live_tessl_threshold": {
    "usage_score_min": 0.9,
    "usage_must_not_underperform_baseline": true,
    "workspace_run_limit": 300,
    "remediation_reserve_runs": 20,
    "run_limit_source": "operator_provided_limit"
  }
}
