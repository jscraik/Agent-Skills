#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: resolve-pr-thread THREAD_ID" >&2
  echo "Example: resolve-pr-thread PRRT_kwDOABC123" >&2
  exit 1
fi

thread_id="$1"

read -r -d '' query <<'GRAPHQL' || true
mutation ResolveReviewThread($threadId: ID!) {
  resolveReviewThread(input: {threadId: $threadId}) {
    thread {
      id
      isResolved
      path
      line
    }
  }
}
GRAPHQL

gh api graphql -f threadId="$thread_id" -f query="$query"
