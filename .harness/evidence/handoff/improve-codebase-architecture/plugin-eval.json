              "task_success_rate",
              "first_pass_success_rate",
              "retry_rate",
              "human_override_rate"
            ],
            "evidenceSources": [
              "Task run logs",
              "Structured user acceptance checklist",
              "Before/after comparison runs on the same prompts"
