      ],
      "status": "preserve_existing_plus_placeholder"
    },
    {
      "module": "receipts",
      "owns": [
        "SDK proof metadata contract",
        "Redaction boundary for command-backed evidence",
        "Baseline/post-change receipt comparison vocabulary"
      ],
      "collaborators": [
        "runtime",
        "risk",
        "evals",
        "install"
      ],
      "public_contract": [
        "Receipts include command, parsed result, blocker class, evidence ref, and redaction status.",
        "Receipts do not claim PR, CI, Linear, or merge readiness without fresh lane-specific proof."
