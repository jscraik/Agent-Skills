      ],
      "collaborators": [
        "manifest",
        "receipts",
        "sandbox",
        "install"
      ],
      "public_contract": [
        "Risk rows name sensor placement and probability/impact/detectability values.",
        "Unimplemented sensors use blocked or not_run status rather than pass."
