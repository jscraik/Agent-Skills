        "manifest",
        "packaging",
        "sandbox",
        "receipts",
        "risk"
      ],
      "public_contract": [
        "Install is lifecycle-gated and receipt-backed.",
        "Install placeholders never write global or project skills during JSC-391."
      ],
      "forbidden_ownership": [
        "Actual install writes",
        "Global skill mutation",
        "Registry or marketplace publication",
        "Runtime projection source edits"
