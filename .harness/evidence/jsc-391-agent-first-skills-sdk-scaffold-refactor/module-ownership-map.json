  "modules": [
    {
      "module": "manifest",
      "owns": [
        "Skill manifest/frontmatter field interpretation",
        "Agent Skills package shape metadata",
        "Manifest-declared project skill source classification"
      ],
      "collaborators": [
        "packaging",
        "install",
        "receipts"
      ],
      "public_contract": [
        "Manifest fields are parsed through ask.skills_sdk.contracts and ask.skills_sdk.package_contracts.",
        "Manifest validation reports structured blocker classes instead of prose-only failures."
      ],
      "forbidden_ownership": [
        "Runtime projection writes",
        "Install mutation",
        "Package archive verification internals",
        "User-facing CLI command ownership"
      ],
      "source_paths": [
        "Infrastructure/scripts/lib/ask/skills_sdk/contracts.py",
